<Window x:Class="Civilization3ConquestsTrainer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Civilization III: Conquests — Trainer" Height="780" Width="1180"
        Icon="Assets/app.ico"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- Several tooltips here carry real instructions — when to switch a toggle on, when to switch
             it off — rather than a one-line hint. A default WPF tooltip is a single unwrapped line that
             vanishes after five seconds, which makes that unreadable, so tooltips wrap at a sane width
             and stay up long enough to finish reading. ShowDuration is an attached property set on the
             owning control, not on the tooltip, hence the setters in the Button and CheckBox styles. -->
        <Style TargetType="ToolTip">
            <Setter Property="MaxWidth" Value="460"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="ToolTipService.ShowDuration" Value="60000"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="ToolTipService.ShowDuration" Value="60000"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="2,1"/>
        </Style>
        <Style x:Key="Toolbar" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="4,2"/>
            <Setter Property="Foreground" Value="#555"/>
        </Style>
        <Style x:Key="Head" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="4,10,4,3"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- process / attach / locate -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Toolbar}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Process:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox Width="240" VerticalAlignment="Center"
                          ItemsSource="{Binding Processes}" DisplayMemberPath="Display"
                          SelectedItem="{Binding SelectedProcess}"/>
                <Button Content="Refresh list" Command="{Binding RefreshProcessesCommand}"
                        ToolTip="Re-list running processes. This does not refresh game data — that happens automatically."/>
                <Button Content="Attach" Command="{Binding AttachCommand}"/>
                <Button Content="Detach" Command="{Binding DetachCommand}"/>
                <Separator Margin="6,0"/>
                <Button Content="Auto-locate (no scan)" FontWeight="Bold" Command="{Binding AutoLocateCommand}"
                        ToolTip="Runs the locator: adds the recovered offsets to the module base and proves the result against all 32 leader slots before trusting any of it. No value scanning at any point.&#10;&#10;YOU DO NOT NORMALLY NEED THIS BUTTON. Locating is part of attaching — it runs by itself the moment you click Attach, which is why the tabs are populated straight away.&#10;&#10;PRESS IT WHEN: you attached while the game was still at the main menu and have since started or loaded a game; or you have loaded a different game or save without detaching, so the civ you are playing, the map size or the ruleset has changed; or a locate failed and you want to try again."/>
                <Button Content="Re-scan now" Command="{Binding RescanCommand}"
                        ToolTip="Rebuild the city and unit lists immediately. Normally unnecessary: the trainer notices units and cities appearing and disappearing on its own."/>
                <CheckBox Content="My civ only" IsChecked="{Binding MineOnly}" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- session summary -->
        <Border DockPanel.Dock="Top" Padding="8,3" Background="#F4F4F4">
            <TextBlock Text="{Binding SessionSummary}" FontWeight="SemiBold"/>
        </Border>

        <!-- status -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Toolbar}">
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
        </Border>

        <TabControl Margin="6">

            <!-- ============ Players ============ -->
            <TabItem Header="Players">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource Toolbar}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Max treasury, research + city shields" FontWeight="Bold"
                                        Command="{Binding MaxAllCommand}"
                                        ToolTip="One click for three of the buttons to the right: sets the treasury to the amount shown, banks the research, and fills every city's shield store. Food is deliberately left out — a city with a full granary grows every turn, and growth outruns happiness until the city riots. Use Max food when you actually want it."/>
                                <Separator Margin="6,0"/>
                                <Button Content="Max treasury" Command="{Binding MaxTreasuryCommand}"/>
                                <TextBlock Text="to" VerticalAlignment="Center" Margin="2,0"/>
                                <!-- No StringFormat, for the same reason as the Treasury column below:
                                     Int64Converter parses without AllowThousands, so a grouped string
                                     would fail to convert back and the edit would be silently lost. -->
                                <TextBox Width="110" VerticalAlignment="Center"
                                         Text="{Binding MaxTreasuryAmount, UpdateSourceTrigger=LostFocus}"
                                         ToolTip="How much gold both treasury buttons write. Any amount Civ3 can hold; an out-of-range one is refused and the box reverts."/>
                                <Button Content="Finish research" Command="{Binding FinishResearchCommand}"
                                        ToolTip="Banks a million research points — far past any advance's cost. Civ3 checks this at a turn boundary, so the tech never arrives instantly, and it may still take a few turns: the game appears to enforce a floor on how few turns an advance can take, which banked points cannot buy past."/>
                                <Button Content="Max my cities' shields" Command="{Binding MaxCityShieldsCommand}"/>
                                <Button Content="Max my cities' food" Command="{Binding MaxCityFoodCommand}"
                                        ToolTip="Fills every city's granary. They will grow on their next turn — watch happiness, because a city that grows several sizes in a row can riot."/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Note}"
                                       Text="These apply to your civilization. Treasury is decoded from two fields — see References. Use the Freeze $ column to hold a treasury against the turn's income."/>
                        </StackPanel>
                    </Border>
                    <DataGrid ItemsSource="{Binding Players}" AutoGenerateColumns="False"
                              CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              BeginningEdit="Grid_BeginningEdit" CellEditEnding="Grid_CellEditEnding">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Civilization" Binding="{Binding RowLabel}" IsReadOnly="True" Width="190"/>
                            <!-- No StringFormat: DataGridTextColumn reuses the same binding for the edit
                                 TextBox, and Int64Converter parses without AllowThousands, so a grouped
                                 string would fail to convert back and the edit would be silently lost. -->
                            <DataGridTextColumn Header="Treasury" Width="110"
                                                Binding="{Binding Treasury, UpdateSourceTrigger=LostFocus}"/>
                            <DataGridTextColumn Header="Tax" Binding="{Binding TaxRate, UpdateSourceTrigger=LostFocus}" Width="46"/>
                            <DataGridTextColumn Header="Sci" Binding="{Binding ScienceRate, UpdateSourceTrigger=LostFocus}" Width="46"/>
                            <DataGridTextColumn Header="Lux" Binding="{Binding LuxuryRate, UpdateSourceTrigger=LostFocus}" Width="46"/>
                            <DataGridTextColumn Header="Era" Binding="{Binding Era, UpdateSourceTrigger=LostFocus}" Width="46"/>
                            <DataGridTextColumn Header="Bulbs" Binding="{Binding ResearchBulbs, UpdateSourceTrigger=LostFocus}" Width="70"/>
                            <DataGridTextColumn Header="Cult. lvl" Binding="{Binding CultureLevel}" IsReadOnly="True" Width="62"/>
                            <DataGridTextColumn Header="Culture" Binding="{Binding CultureTotal, UpdateSourceTrigger=LostFocus}" Width="80"/>
                            <DataGridTextColumn Header="Cities" Binding="{Binding CityCount}" IsReadOnly="True" Width="50"/>
                            <DataGridTextColumn Header="Units" Binding="{Binding UnitCount}" IsReadOnly="True" Width="50"/>
                            <DataGridCheckBoxColumn Header="Freeze $" Binding="{Binding FreezeTreasury}" Width="66"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ============ Cities ============ -->
            <TabItem Header="Cities">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource Toolbar}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Max shields (my cities)" Command="{Binding MaxCityShieldsCommand}"
                                        ToolTip="Fills every city's shield store, so each finishes whatever it is building on its next turn."/>
                                <Button Content="Max food (my cities)" Command="{Binding MaxCityFoodCommand}"
                                        ToolTip="Fills every city's granary. They will grow on their next turn — watch happiness, because a city that grows several sizes in a row can riot."/>
                                <Button Content="Max culture (my cities)" Command="{Binding MaxCityCultureCommand}"
                                        ToolTip="Raises every city's cultural level, which is what expands its borders. This is the per-city level, not accumulated culture — for a cultural victory edit the Culture column on the Players tab. The offset is inferred rather than confirmed, so check the effect in game."/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Note}"
                                       Text="Only the anchor-bracketed prefix of the city record is shown. Population, corruption, incomes and the build queue sit past where the layout stops being reliable — see docs/ReverseEngineering.md §4.4. Cultural level is inferred, not confirmed."/>
                        </StackPanel>
                    </Border>
                    <DataGrid ItemsSource="{Binding Cities}" AutoGenerateColumns="False"
                              CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              BeginningEdit="Grid_BeginningEdit" CellEditEnding="Grid_CellEditEnding">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Slot}" IsReadOnly="True" Width="40"/>
                            <DataGridTextColumn Header="Owner" Binding="{Binding Owner}" IsReadOnly="True" Width="180"/>
                            <DataGridTextColumn Header="Position" Binding="{Binding Position}" IsReadOnly="True" Width="80"/>
                            <DataGridTextColumn Header="Food" Binding="{Binding StoredFood, UpdateSourceTrigger=LostFocus}" Width="80"/>
                            <DataGridTextColumn Header="Shields" Binding="{Binding StoredProduction, UpdateSourceTrigger=LostFocus}" Width="80"/>
                            <DataGridTextColumn Header="Cult. level" Binding="{Binding CulturalLevel, UpdateSourceTrigger=LostFocus}" Width="80"/>
                            <DataGridCheckBoxColumn Header="Freeze" Binding="{Binding Freeze}" Width="60"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ============ Units ============ -->
            <TabItem Header="Units">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource Toolbar}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Full heal all" Command="{Binding HealAllUnitsCommand}"/>
                                <Button Content="Refresh all moves" Command="{Binding RefreshAllMovesCommand}"/>
                                <Button Content="Promote all to elite" Command="{Binding EliteAllUnitsCommand}"/>
                                <Button Content="Make great leader" Command="{Binding MakeGreatLeaderCommand}"
                                        ToolTip="Turns the unit SELECTED IN THE GRID into this ruleset's great-leader type — the trainer's supported way to get an army.&#10;&#10;WHY A LEADER RATHER THAN AN ARMY: an army in Civ3 is just a unit whose type carries the Army ability, so the Type column can make one in a single write — but it would be an empty shell, and filling it means imitating the game's own bookkeeping for what is inside an army. A leader hands that whole job back to the game.&#10;&#10;WHAT TO DO NEXT: select the unit in Civ3 and give it the Build Army order on the unit panel. The game consumes the leader and spawns a real army; move units onto its tile and use the game's own load order to fill it. Everything after the retype is the game's own code.&#10;&#10;WHAT TO EXPECT: the unit keeps its old picture on the map — Civ3 chooses a unit's artwork when the unit is created, not when it is drawn. Its abilities and orders change at once, which is what makes Build Army appear.&#10;&#10;IF THE BUTTON REFUSES: the ruleset's leader type has to name a unit type that really carries the Leader ability before the trainer will act on it, and a land leader will not be written over a ship unless you tick 'Any domain'."/>
                                <Button Content="Finish worker jobs (mine)" Command="{Binding FinishWorkerJobsCommand}"
                                        ToolTip="Banks enough worker-turns to finish the job every worker of yours is already doing. Your units only — the AI's workers are never touched.&#10;&#10;WHEN TO CLICK IT: after your workers are already building something. Idle workers are skipped, so give the order first. You need it once per job, because finishing a job wipes the banked work — or tick 'Keep worker jobs banked' and never click it again.&#10;&#10;WHAT TO EXPECT: on its own this lands at the START OF YOUR NEXT TURN, not immediately. Civ3 only checks whether a job is finished while a worker is actually putting a turn of work in, and that costs the worker its whole move — one check per turn. A job already due next turn therefore cannot get any shorter.&#10;&#10;TO COLLECT IT NOW: tick 'Hold my units' moves at 0', then press the worker's job key again. The returned movement buys a second check this turn."/>
                                <CheckBox Content="Hold my units' moves at 0" VerticalAlignment="Center" Margin="8,0,0,0"
                                          IsChecked="{Binding HoldMyUnitMoves}"
                                          ToolTip="Re-zeroes spent movement on every unit of yours twice a second, for as long as it is ticked — the standing version of 'Refresh all moves'. Your units can move, attack and work all turn without running out.&#10;&#10;TURN IT ON: at the start of any turn you want unlimited movement, and whenever you are doing terrain work.&#10;&#10;TURN IT OFF: whenever you want the game's normal movement limits back. There is no deadline and nothing to undo — it writes only to your own units, and unticking it simply stops.&#10;&#10;WHY WORKERS NEED IT: working spends a worker's entire move, and the 'is this job done?' check only runs while a worker is working. Giving the move back lets you re-issue the order in the same turn, which forces that check to run again — and that is what makes 'Finish worker jobs' complete on the spot instead of next turn."/>
                                <CheckBox Content="Unlimited attacks (mine)" VerticalAlignment="Center" Margin="8,0,0,0"
                                          IsChecked="{Binding UnlimitedAttacks}"
                                          ToolTip="Lets every unit of yours attack as many times in a turn as you can give it the order. Your units only — the AI still gets one attack each.&#10;&#10;WHY IT TAKES TWO WRITES: Civ3 puts two gates in front of a second attack. Attacking sets an 'already attacked this turn' flag, and the game refuses the next attack unless the unit's type has the Blitz ability. Attacking also spends every movement point the unit had, and movement is checked first. This toggle clears the flag AND re-zeroes spent movement, twice a second — which is the same pair of fields the game itself clears at the start of a unit's turn, in one four-instruction sequence.&#10;&#10;TURN IT ON: at the start of a turn you intend to fight. It includes the movement hold, so you do not need both boxes ticked.&#10;&#10;TURN IT OFF: whenever you want one attack per unit per turn back. Nothing to undo — the game would clear both fields itself on the unit's next turn.&#10;&#10;WHAT TO EXPECT: attack, let the unit be re-selected, attack again with the same unit — as often as you like. The attacker still takes damage and can still LOSE a fight; this hands back the right to attack, not the outcome. Tick the row's Heal box, or use Full heal all, if you want it to survive the ones it should not."/>
                                <CheckBox Content="Keep worker jobs banked" VerticalAlignment="Center" Margin="8,0,0,0"
                                          IsChecked="{Binding KeepWorkerJobsBanked}"
                                          ToolTip="Does what the 'Finish worker jobs' button does, automatically, twice a second — so you never have to click it again.&#10;&#10;WHY IT EXISTS: completing a job clears the worker's banked work (the game zeroes the progress and the job id on every unit standing there), so nothing carries into the next job. Without this, the button has to be clicked once for every single job.&#10;&#10;TURN IT ON: together with 'Hold my units' moves at 0', at the start of a turn where you plan to do terrain work.&#10;&#10;TURN IT OFF: when you want workers building at the normal rate again. Nothing to undo — it writes only to your own units.&#10;&#10;HOW TO USE: order the job, then order it again — it finishes at once. Move the worker on and repeat as often as you like in the same turn.&#10;&#10;It costs nothing while idle: a worker already topped up is skipped rather than rewritten."/>
                                <CheckBox Content="Any domain" VerticalAlignment="Center" Margin="8,0,0,0"
                                          IsChecked="{Binding AnyUnitClass}"
                                          ToolTip="Lets the Type column offer every unit type in the ruleset, instead of only the ones that share this unit's domain (land, sea or air).&#10;&#10;LEAVE IT OFF unless you have a reason. The game will hold whatever you write, so a Trireme rewritten as a Warrior is a land unit sitting in the ocean — a position Civ3 has no legal move out of.&#10;&#10;TURN IT ON: for a modded ruleset that classifies units in ways the epic game does not, or when you want a land leader written over something that is not a land unit and you know where it is standing.&#10;&#10;It is a toggle rather than a rule because the land/sea/air field is the one unit-type offset here that was not read out of the game's own code. If it ever fails its check at run time the trainer stops filtering by itself and offers every type regardless of this box."/>
                                <CheckBox Content="Instant worker jobs (all civs)" VerticalAlignment="Center" Margin="8,0,0,0"
                                          IsChecked="{Binding InstantWorkerJobs}"
                                          ToolTip="Rewrites every terrain job in the loaded ruleset to cost one worker-turn.&#10;&#10;THIS ONE IS NOT YOURS ALONE. The ruleset belongs to the game rather than to a player, so every civ's workers speed up — and the AI has far more workers than you do. Prefer 'Finish worker jobs' with the two toggles to its left: same result for you, none of it for the AI.&#10;&#10;TURN IT ON: at the start of your own turn.&#10;&#10;TURN IT OFF: before you end your turn. The game re-reads a job's cost every time a worker puts a turn of work in, and the AI's workers do that during the AI's turn — which runs after you end yours. Switching it off first therefore keeps the whole benefit away from them.&#10;&#10;SAFETY: the original costs are captured when you tick it and written back when you untick it, detach, or close the trainer, so nothing is left patched. Save your game with it OFF — Civ3 saves carry a rules section, and whether an edited cost rides along in it has not been checked."/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Note}"
                                       Text="Damage is hit points LOST and Moves is points SPENT — zero is a fresh, undamaged unit. Attacked is the game's own per-turn flag, and it is what stops a second attack; 'Unlimited attacks' clears it and hands the movement back, which is the same pair of fields the game clears at the start of every unit's turn. Job progress reads the other way: it counts UP toward the job's cost, and it pools across every worker on the tile, so finishing it on one worker of a stack finishes it for all of them. Banked work lands on a worker's next turn of work rather than at once, because that is the only moment Civ3 checks whether a job is done — hold the moves and re-issue the order to collect it now. Freeze heals a unit between battles; it cannot stop one from being killed, because Civ3 resolves a whole battle inside a single call. The Type column changes what a unit is — stats and orders follow at once, the picture on the map does not, because artwork is chosen when a unit is created. Armies go through 'Make great leader' and the game's own Build Army order. See References."/>
                        </StackPanel>
                    </Border>
                    <DataGrid ItemsSource="{Binding Units}" SelectedItem="{Binding SelectedUnit}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              BeginningEdit="Grid_BeginningEdit" CellEditEnding="Grid_CellEditEnding">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Slot}" IsReadOnly="True" Width="40"/>
                            <!-- A template column rather than a DataGridComboBoxColumn: the list of types
                                 a unit may become is per-row (it is filtered to that unit's own domain),
                                 and a DataGridComboBoxColumn shares one ItemsSource across the grid.

                                 UpdateSourceTrigger=PropertyChanged is load-bearing, not decoration. A
                                 DataGrid puts a BindingGroup on every row, bindings inside the row join
                                 it, and a joined binding holds its source update until the group commits
                                 — which for a control living in the CellTemplate never happens, because
                                 the cell is not in edit mode when the dropdown is used. Without this the
                                 ComboBox moves, SelectedValue updates, and the view-model never hears:
                                 picking a type silently does nothing. Confirmed against a live game. -->
                            <DataGridTemplateColumn Header="Type" Width="170">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding AvailableTypes}" DisplayMemberPath="Name"
                                                  SelectedValuePath="Id"
                                                  SelectedValue="{Binding TypeId, UpdateSourceTrigger=PropertyChanged}"
                                                  BorderThickness="0" Background="Transparent"
                                                  ToolTipService.ShowDuration="60000"
                                                  ToolTip="Changes what this unit IS. Civ3 looks up a unit's attack, defence, movement, hit points, abilities and available orders from this field every time it needs them, so the change takes effect immediately — a Warrior written to Modern Armor fights as Modern Armor.&#10;&#10;WHAT IT DOES NOT CHANGE: the picture on the map. A unit's artwork is loaded when the unit is created, from its type, era and civilization, so a retyped unit keeps the sprite it was born with.&#10;&#10;DAMAGE IS CLEARED as part of the change, because maximum hit points come from the type — a unit carrying damage that became a smaller type would otherwise be past dead.&#10;&#10;The list offers this unit's own domain (land, sea or air); tick 'Any domain' above to see all of them. For an army, use 'Make great leader' rather than picking the Army type here — that gets you an empty shell."/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Owner" Binding="{Binding Owner}" IsReadOnly="True" Width="180"/>
                            <DataGridTextColumn Header="Position" Binding="{Binding Position}" IsReadOnly="True" Width="80"/>
                            <DataGridTextColumn Header="Damage" Binding="{Binding Damage, UpdateSourceTrigger=LostFocus}" Width="70"/>
                            <DataGridTextColumn Header="Moves used" Binding="{Binding MovesUsed, UpdateSourceTrigger=LostFocus}" Width="86"/>
                            <!-- Read-only: this is the game's own "has attacked this turn" flag, shown so
                                 that "Unlimited attacks" can be seen working rather than believed. -->
                            <DataGridCheckBoxColumn Header="Attacked" Binding="{Binding HasAttacked, Mode=OneWay}"
                                                    IsReadOnly="True" Width="70"/>
                            <DataGridTextColumn Header="Veteran" Binding="{Binding Experience, UpdateSourceTrigger=LostFocus}" Width="66"/>
                            <DataGridTextColumn Header="Job" Binding="{Binding JobName}" IsReadOnly="True" Width="100"/>
                            <DataGridTextColumn Header="Job done" Binding="{Binding JobProgress, UpdateSourceTrigger=LostFocus}" Width="70"/>
                            <DataGridCheckBoxColumn Header="Heal" Binding="{Binding Freeze}" Width="60"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ============ Map ============ -->
            <TabItem Header="Map" DataContext="{Binding Map}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <TextBlock Text="World" Style="{StaticResource Head}"/>
                        <TextBlock Text="{Binding Summary}" Style="{StaticResource Note}"/>
                        <TextBlock Text="{Binding TilePointerNote}" Style="{StaticResource Note}" FontFamily="Consolas"/>

                        <TextBlock Text="Reveal the map" Style="{StaticResource Head}"/>
                        <TextBlock Style="{StaticResource Note}"
                                   Text="This sets your civilization's bit in each tile's visibility masks. The map header itself is confirmed — its width, height and seed were checked against conquests.ini — but the per-tile visibility offsets are INFERRED from the community struct header and have not been round-tripped through the game's own display. Every tile is checked for its own 'TILE' tag before anything is written, so a wrong pointer stops the sweep rather than spraying writes; even so, back up your save first."/>
                        <CheckBox Margin="4,6" IsChecked="{Binding ConfirmedRisk}"
                                  Content="I understand these offsets are unconfirmed and I have a backup save"/>
                        <Button Content="Reveal map" HorizontalAlignment="Left" Command="{Binding RevealMapCommand}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ Scanner ============ -->
            <TabItem Header="Scanner" DataContext="{Binding Scanner}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource Toolbar}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Type:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <ComboBox Width="80" VerticalAlignment="Center"
                                          ItemsSource="{Binding Widths}" SelectedItem="{Binding SelectedWidth}"/>
                                <TextBlock Text="Value:" VerticalAlignment="Center" Margin="8,0,4,0"/>
                                <TextBox Width="120" Text="{Binding ScanText, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Content="First scan" Command="{Binding FirstScanCommand}"/>
                                <Button Content="Exact" Command="{Binding NextScanCommand}" CommandParameter="Exact"/>
                                <Button Content="Increased" Command="{Binding NextScanCommand}" CommandParameter="Increased"/>
                                <Button Content="Decreased" Command="{Binding NextScanCommand}" CommandParameter="Decreased"/>
                                <Button Content="Changed" Command="{Binding NextScanCommand}" CommandParameter="Changed"/>
                                <Button Content="Unchanged" Command="{Binding NextScanCommand}" CommandParameter="Unchanged"/>
                                <Button Content="New scan" Command="{Binding NewScanCommand}"/>
                                <TextBlock Text="{Binding MatchCount}" VerticalAlignment="Center" Margin="10,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Guides:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <Button Content="Treasury" Command="{Binding TreasuryGuideCommand}"/>
                                <Button Content="City stores" Command="{Binding CityGuideCommand}"/>
                                <Button Content="Unit damage" Command="{Binding UnitGuideCommand}"/>
                                <Button Content="Turn" Command="{Binding TurnGuideCommand}"/>
                                <Button Content="Pin" Command="{Binding PinCommand}"/>
                                <Button Content="Unpin" Command="{Binding RemoveFrozenCommand}"/>
                                <Button Content="Freeze all" Command="{Binding FreezeAllCommand}"/>
                                <Button Content="Freeze none" Command="{Binding FreezeNoneCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border DockPanel.Dock="Bottom" Padding="6,3">
                        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="#444"/>
                    </Border>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <DataGrid Grid.Column="0" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Address" Binding="{Binding AddressHex}" Width="140"/>
                                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <DataGrid Grid.Column="1" ItemsSource="{Binding Frozen}" SelectedItem="{Binding SelectedFrozen}"
                                  AutoGenerateColumns="False" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Label" Binding="{Binding Label}" IsReadOnly="True" Width="130"/>
                                <DataGridTextColumn Header="Address" Binding="{Binding AddressHex}" IsReadOnly="True" Width="120"/>
                                <DataGridTextColumn Header="Live" Binding="{Binding Live}" IsReadOnly="True" Width="90"/>
                                <DataGridTextColumn Header="Target" Binding="{Binding Target, UpdateSourceTrigger=LostFocus}" Width="90"/>
                                <DataGridCheckBoxColumn Header="Freeze" Binding="{Binding Frozen}" Width="60"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- ============ References ============ -->
            <TabItem Header="References" DataContext="{Binding Reference}">
                <TabControl Margin="4">
                    <TabItem Header="How it works">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Notes}" Margin="10">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock Text="{Binding Topic}" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding Body}" TextWrapping="Wrap" Foreground="#444" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="The nine conquests">
                        <DataGrid ItemsSource="{Binding Conquests}" AutoGenerateColumns="False"
                                  CanUserAddRows="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Conquest" Binding="{Binding Name}" Width="150"/>
                                <DataGridTextColumn Header="Era" Binding="{Binding Era}" Width="110"/>
                                <DataGridTextColumn Header="Setting" Binding="{Binding Setting}" Width="300"/>
                                <DataGridTextColumn Header="Victory" Binding="{Binding Victory}" Width="250"/>
                                <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="Civilizations">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{Binding TablesNote}" Style="{StaticResource Note}"/>
                            <DataGrid ItemsSource="{Binding Races}" AutoGenerateColumns="False"
                                      CanUserAddRows="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="40"/>
                                    <DataGridTextColumn Header="Civilization" Binding="{Binding Country}" Width="160"/>
                                    <DataGridTextColumn Header="Leader" Binding="{Binding Leader}" Width="160"/>
                                    <DataGridTextColumn Header="Adjective" Binding="{Binding Adjective}" Width="150"/>
                                    <DataGridTextColumn Header="Aggression" Binding="{Binding Aggression}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="Units">
                        <DataGrid ItemsSource="{Binding UnitTypes}" AutoGenerateColumns="False"
                                  CanUserAddRows="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="40"/>
                                <DataGridTextColumn Header="Unit" Binding="{Binding Name}" Width="200"/>
                                <DataGridTextColumn Header="Attack" Binding="{Binding Attack}" Width="60"/>
                                <DataGridTextColumn Header="Defence" Binding="{Binding Defence}" Width="66"/>
                                <DataGridTextColumn Header="Moves" Binding="{Binding Movement}" Width="60"/>
                                <DataGridTextColumn Header="Domain" Binding="{Binding ClassName}" Width="70"/>
                                <DataGridTextColumn Header="Cost" Binding="{Binding Cost}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                </TabControl>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
