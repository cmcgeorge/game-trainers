<Window x:Class="BardsTaleTrilogyTrainer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BardsTaleTrilogyTrainer.Game"
        Title="The Bard's Tale Trilogy Trainer"
        Height="700" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#FF1E1E1E"
        FontFamily="Segoe UI" FontSize="13">
    <DockPanel>
        <!-- Status bar -->
        <Border DockPanel.Dock="Top" Background="#FF2D2D30" Padding="8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Attach" Command="{Binding AttachCommand}" Margin="0,0,4,0" Padding="12,2" Background="#FF007ACC" Foreground="White" BorderThickness="0"/>
                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="#FFCCCCCC" Margin="8,0" TextTrimming="CharacterEllipsis"/>
                <Button Grid.Column="2" Content="Locate" Command="{Binding LocateCommand}" Margin="4,0" Padding="12,2" Background="#FF2D2D30" Foreground="#FFCCCCCC" BorderBrush="#FF555555"/>
                <Button Grid.Column="3" Content="Detach" Command="{Binding DetachCommand}" Margin="4,0" Padding="12,2" Background="#FF2D2D30" Foreground="#FFCCCCCC" BorderBrush="#FF555555"/>
            </Grid>
        </Border>

        <!-- Party gold bar -->
        <Border DockPanel.Dock="Top" Background="#FF252526" Padding="8,4">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Party Gold:" VerticalAlignment="Center" Foreground="#FFCCCCCC" Margin="0,0,4,0"/>
                <TextBox Text="{Binding Gold}" Width="100" VerticalAlignment="Center" Background="#FF333337" Foreground="White" BorderBrush="#FF555555"/>
                <Button Content="Write Gold" Command="{Binding WriteGoldCommand}" Margin="8,0,0,0" Padding="8,2" Background="#FF007ACC" Foreground="White" BorderThickness="0"/>
            </StackPanel>
        </Border>

        <!-- Party-wide actions -->
        <Border DockPanel.Dock="Top" Background="#FF252526" Padding="8,4">
            <StackPanel Orientation="Horizontal">
                <Button Content="Learn All Spells (Party)" Command="{Binding LearnAllSpellsAllCommand}" Margin="0,0,8,0" Padding="8,2" Background="#FF3C3C3C" Foreground="#FFCCCCCC" BorderBrush="#FF555555"/>
                <Button Content="Set Infinite Items (Party)" Command="{Binding SetInfiniteItemsAllCommand}" Margin="0,0,8,0" Padding="8,2" Background="#FF3C3C3C" Foreground="#FFCCCCCC" BorderBrush="#FF555555"/>
                <Button Content="Garth's Shop: All Items" Command="{Binding SetGarthShopAllCommand}" Padding="8,2" Background="#FF3C3C3C" Foreground="#FFCCCCCC" BorderBrush="#FF555555"/>
            </StackPanel>
        </Border>

        <!-- Main content area -->
        <TabControl Background="#FF1E1E1E" Foreground="#FFCCCCCC" BorderBrush="#FF555555" Padding="4">

            <!-- Character Editor Tab -->
            <TabItem Header="Characters" Foreground="#FFCCCCCC">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Character list -->
                    <ListBox Grid.Column="0" ItemsSource="{Binding Characters}"
                             SelectedIndex="{Binding SelectedCharacterIndex}"
                             Background="#FF2D2D30" Foreground="White" BorderBrush="#FF555555">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Header}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Character editor -->
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="8,0,0,0">
                        <StackPanel DataContext="{Binding SelectedCharacter}">
                            <TextBlock Text="{Binding Header}" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,8"/>

                            <!-- Core stats -->
                            <GroupBox Header="Core Stats" Foreground="#FFCCCCCC" Margin="0,0,0,8" Padding="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Level:" Foreground="#FFCCCCCC" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Level}" Background="#FF333337" Foreground="White" BorderBrush="#FF555555"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="AC:" Foreground="#FFCCCCCC" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding ArmorClass}" Background="#FF333337" Foreground="White" BorderBrush="#FF555555"/>
                                    <TextBlock Grid.Row="0" Grid.Column="4" Text="XP:" Foreground="#FFCCCCCC" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    <TextBox Grid.Row="0" Grid.Column="5" Text="{Binding Experience}" Background="#FF333337" Foreground="White" BorderBrush="#FF555555"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="HP Cur:" Foreground="#FFCCCCCC" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding HpCur}" Background="#FF333337" Foreground="White" BorderBrush="#FF555555"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="HP Max:" Foreground="#FFCCCCCC" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding HpMax}" Background="#FF333337" Foreground="White" BorderBrush="#FF555555"/>
                                    <CheckBox Grid.Row="1" Grid.Column="4" Grid.ColumnSpan="2" Content="Freeze HP" IsChecked="{Binding FreezeHp}" Foreground="#FFCCCCCC" Margin="8,0,0,0" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="SP Cur:" Foreground="#FFCCCCCC" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SpCur}" Background="#FF333337" Foreground="White" BorderBrush="#FF555555"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="SP Max:" Foreground="#FFCCCCCC" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding SpMax}" Background="#FF333337" Foreground="White" BorderBrush="#FF555555"/>
                                    <CheckBox Grid.Row="2" Grid.Column="4" Grid.ColumnSpan="2" Content="Freeze SP" IsChecked="{Binding FreezeSp}" Foreground="#FFCCCCCC" Margin="8,0,0,0" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Race:" Foreground="#FFCCCCCC" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Row="3" Grid.Column="1" SelectedIndex="{Binding Race}" Background="#FF333337" Foreground="White" BorderBrush="#FF555555">
                                        <ComboBoxItem Content="Human"/>
                                        <ComboBoxItem Content="Elf"/>
                                        <ComboBoxItem Content="Dwarf"/>
                                        <ComboBoxItem Content="Hobbit"/>
                                        <ComboBoxItem Content="Half-Elf"/>
                                        <ComboBoxItem Content="Half-Orc"/>
                                        <ComboBoxItem Content="Gnome"/>
                                    </ComboBox>
                                    <TextBlock Grid.Row="3" Grid.Column="2" Text="Class:" Foreground="#FFCCCCCC" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    <ComboBox Grid.Row="3" Grid.Column="3" SelectedIndex="{Binding Class}" Background="#FF333337" Foreground="White" BorderBrush="#FF555555">
                                        <ComboBoxItem Content="Warrior"/>
                                        <ComboBoxItem Content="Paladin"/>
                                        <ComboBoxItem Content="Rogue"/>
                                        <ComboBoxItem Content="Bard"/>
                                        <ComboBoxItem Content="Hunter"/>
                                        <ComboBoxItem Content="Monk"/>
                                        <ComboBoxItem Content="Conjurer"/>
                                        <ComboBoxItem Content="Magician"/>
                                        <ComboBoxItem Content="Sorcerer"/>
                                        <ComboBoxItem Content="Wizard"/>
                                    </ComboBox>
                                </Grid>
                            </GroupBox>

                            <!-- Attributes -->
                            <GroupBox Header="Attributes" Foreground="#FFCCCCCC" Margin="0,0,0,8" Padding="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Str:" Foreground="#FFCCCCCC" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding StrCur}" Background="#FF333337" Foreground="White" BorderBrush="#FF555555"/>
                                    <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding StrMax}" Background="#FF333337" Foreground="White" BorderBrush="#FF555555"/>
                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="IQ:" Foreground="#FFCCCCCC" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    <TextBox Grid.Row="0" Grid.Column="4" Text="{Binding IqCur}" Background="#FF333337" Foreground="White" BorderBrush="#FF555555"/>
                                    <TextBox Grid.Row="0" Grid.Column="5" Text="{Binding IqMax}" Background="#FF333337" Foreground="White" BorderBrush="#FF555555"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Dx:" Foreground="#FFCCCCCC" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DxCur}" Background="#FF333337" Foreground="White" BorderBrush="#FF555555"/>
                                    <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding DxMax}" Background="#FF333337" Foreground="White" BorderBrush="#FF555555"/>
                                    <TextBlock Grid.Row="1" Grid.Column="3" Text="Cn:" Foreground="#FFCCCCCC" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding CnCur}" Background="#FF333337" Foreground="White" BorderBrush="#FF555555"/>
                                    <TextBox Grid.Row="1" Grid.Column="5" Text="{Binding CnMax}" Background="#FF333337" Foreground="White" BorderBrush="#FF555555"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Lk:" Foreground="#FFCCCCCC" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding LkCur}" Background="#FF333337" Foreground="White" BorderBrush="#FF555555"/>
                                    <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding LkMax}" Background="#FF333337" Foreground="White" BorderBrush="#FF555555"/>

                                    <TextBlock Grid.Row="2" Grid.Column="3" Text="(Cur/Max)" Foreground="#FF888888" FontSize="10" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </Grid>
                            </GroupBox>

                            <!-- Spell levels -->
                            <GroupBox Header="Spell Class Levels" Foreground="#FFCCCCCC" Margin="0,0,0,8" Padding="8">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Conjurer:" Foreground="#FFCCCCCC" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Text="{Binding ConjurerLevel}" Background="#FF333337" Foreground="White" BorderBrush="#FF555555"/>
                                        <TextBlock Grid.Column="2" Text="Magician:" Foreground="#FFCCCCCC" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        <TextBox Grid.Column="3" Text="{Binding MagicianLevel}" Background="#FF333337" Foreground="White" BorderBrush="#FF555555"/>
                                    </Grid>
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Sorcerer:" Foreground="#FFCCCCCC" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Text="{Binding SorcererLevel}" Background="#FF333337" Foreground="White" BorderBrush="#FF555555"/>
                                        <TextBlock Grid.Column="2" Text="Wizard:" Foreground="#FFCCCCCC" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        <TextBox Grid.Column="3" Text="{Binding WizardLevel}" Background="#FF333337" Foreground="White" BorderBrush="#FF555555"/>
                                    </Grid>
                                </StackPanel>
                            </GroupBox>

                            <!-- Actions -->
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="Write All" Click="WriteAll_Click" Padding="12,4" Background="#FF007ACC" Foreground="White" BorderThickness="0" Margin="0,0,8,0"/>
                                <Button Content="Learn All Spells" Click="LearnAllSpells_Click" Padding="12,4" Background="#FF3C3C3C" Foreground="#FFCCCCCC" BorderBrush="#FF555555" Margin="0,0,8,0"/>
                                <Button Content="Set Infinite Items" Click="SetInfiniteItems_Click" Padding="12,4" Background="#FF3C3C3C" Foreground="#FFCCCCCC" BorderBrush="#FF555555" Margin="0,0,8,0"/>
                                <Button Content="Full Heal" Click="FullHeal_Click" Padding="12,4" Background="#FF3C3C3C" Foreground="#FFCCCCCC" BorderBrush="#FF555555" Margin="0,0,8,0"/>
                                <Button Content="Max Attributes" Click="MaxAttributes_Click" Padding="12,4" Background="#FF3C3C3C" Foreground="#FFCCCCCC" BorderBrush="#FF555555"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- Spells Tab -->
            <TabItem Header="Spells" Foreground="#FFCCCCCC">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="Spell Code:" Foreground="#FFCCCCCC" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox Text="{Binding SpellCode}" Width="80" Background="#FF333337" Foreground="White" BorderBrush="#FF555555"/>
                        <Button Content="Assign to Selected Character" Command="{Binding AssignSpellCommand}" Margin="8,0,0,0" Padding="12,2" Background="#FF007ACC" Foreground="White" BorderThickness="0"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Special Spells (Any Magic User):" Foreground="#FF4EC9B0" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBlock Text="ZZGO — Dream Spell (BT2)" Foreground="#FFCCCCCC" Margin="8,0,0,2"/>
                            <TextBlock Text="NUKE — Gotterdammerung (BT3)" Foreground="#FFCCCCCC" Margin="8,0,0,2"/>
                            <TextBlock Text="GILL — Gilles Gills (BT3)" Foreground="#FFCCCCCC" Margin="8,0,0,2"/>
                            <TextBlock Text="DIVA — Divine Intervention (BT2)" Foreground="#FFCCCCCC" Margin="8,0,0,8"/>

                            <TextBlock Text="Conjurer Spells (Levels 1–7):" Foreground="#FF4EC9B0" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBlock Text="L1: MAFL ARFI SOSH TRZP" Foreground="#FFCCCCCC" Margin="8,0,0,2"/>
                            <TextBlock Text="L2: FRFO MACO BASK WOHL" Foreground="#FFCCCCCC" Margin="8,0,0,2"/>
                            <TextBlock Text="L3: MAST LERE LEVI WAST" Foreground="#FFCCCCCC" Margin="8,0,0,2"/>
                            <TextBlock Text="L4: INWO FLRE POST" Foreground="#FFCCCCCC" Margin="8,0,0,2"/>
                            <TextBlock Text="L5: GRRE WROV SHSP" Foreground="#FFCCCCCC" Margin="8,0,0,2"/>
                            <TextBlock Text="L6: INOG MALE" Foreground="#FFCCCCCC" Margin="8,0,0,2"/>
                            <TextBlock Text="L7: FLAN APAR" Foreground="#FFCCCCCC" Margin="8,0,0,8"/>

                            <TextBlock Text="Magician Spells (Levels 1–7):" Foreground="#FF4EC9B0" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBlock Text="L1: MIJA PHBL LOTR HYIM" Foreground="#FFCCCCCC" Margin="8,0,0,2"/>
                            <TextBlock Text="L2: DISB TADU MIFI FEAR" Foreground="#FFCCCCCC" Margin="8,0,0,2"/>
                            <TextBlock Text="L3: WIWO VANI SESI CURS" Foreground="#FFCCCCCC" Margin="8,0,0,2"/>
                            <TextBlock Text="L4: CAEY WIWA INVI" Foreground="#FFCCCCCC" Margin="8,0,0,2"/>
                            <TextBlock Text="L5: WIOG DIIL MIBL" Foreground="#FFCCCCCC" Margin="8,0,0,2"/>
                            <TextBlock Text="L6: WIDR MIWP" Foreground="#FFCCCCCC" Margin="8,0,0,2"/>
                            <TextBlock Text="L7: WIGI SOSI" Foreground="#FFCCCCCC" Margin="8,0,0,8"/>

                            <TextBlock Text="Sorcerer Spells (Levels 1–7):" Foreground="#FF4EC9B0" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBlock Text="L1: VOPL AIAR STLI SCSI" Foreground="#FFCCCCCC" Margin="8,0,0,2"/>
                            <TextBlock Text="L2: HOWA WIST MAGA AREN" Foreground="#FFCCCCCC" Margin="8,0,0,2"/>
                            <TextBlock Text="L3: MYSH OGST MIMI STFL" Foreground="#FFCCCCCC" Margin="8,0,0,2"/>
                            <TextBlock Text="L4: SPTO DRBR STSI" Foreground="#FFCCCCCC" Margin="8,0,0,2"/>
                            <TextBlock Text="L5: ANMA ANSW STTO" Foreground="#FFCCCCCC" Margin="8,0,0,2"/>
                            <TextBlock Text="L6: PHDO YMCA" Foreground="#FFCCCCCC" Margin="8,0,0,2"/>
                            <TextBlock Text="L7: REST DEST" Foreground="#FFCCCCCC" Margin="8,0,0,8"/>

                            <TextBlock Text="Wizard Spells (Levels 1–7):" Foreground="#FF4EC9B0" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBlock Text="L1: SUDE REDE" Foreground="#FFCCCCCC" Margin="8,0,0,2"/>
                            <TextBlock Text="L2: LESU DEBA" Foreground="#FFCCCCCC" Margin="8,0,0,2"/>
                            <TextBlock Text="L3: SUPH DISP" Foreground="#FFCCCCCC" Margin="8,0,0,2"/>
                            <TextBlock Text="L4: PRSU ANDE" Foreground="#FFCCCCCC" Margin="8,0,0,2"/>
                            <TextBlock Text="L5: SPBI DMST" Foreground="#FFCCCCCC" Margin="8,0,0,2"/>
                            <TextBlock Text="L6: SPSP BEDE" Foreground="#FFCCCCCC" Margin="8,0,0,2"/>
                            <TextBlock Text="L7: GRSU" Foreground="#FFCCCCCC" Margin="8,0,0,8"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- References Tab -->
            <TabItem Header="References" Foreground="#FFCCCCCC">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8">
                    <StackPanel>
                        <TextBlock Text="Items (1–127)" Foreground="#FF4EC9B0" FontWeight="Bold" FontSize="14" Margin="0,0,0,4"/>
                        <ItemsControl ItemsSource="{x:Static local:ItemBook.Choices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Foreground="#FFCCCCCC" Margin="8,0,0,2">
                                        <Run Text="{Binding Display}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
