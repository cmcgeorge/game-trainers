<Window x:Class="BardsTaleTrilogyTrainer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BardsTaleTrilogyTrainer.Game"
        Title="The Bard's Tale Trilogy Trainer"
        Height="820" Width="1180"
        WindowStartupLocation="CenterScreen"
        Background="#FF1E1E1E"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Background" Value="#FF333337"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF555555"/>
            <Setter Property="Margin" Value="0,1,4,1"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFCCCCCC"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>
        <Style x:Key="Chip" TargetType="Button">
            <Setter Property="Background" Value="#FF3C3C3C"/>
            <Setter Property="Foreground" Value="#FFCCCCCC"/>
            <Setter Property="BorderBrush" Value="#FF555555"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="Primary" TargetType="Button">
            <Setter Property="Background" Value="#FF007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,3"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF888888"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Status bar -->
        <Border DockPanel.Dock="Top" Background="#FF2D2D30" Padding="8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Attach" Command="{Binding AttachCommand}" Style="{StaticResource Primary}"/>
                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" VerticalAlignment="Center"
                           Foreground="#FFCCCCCC" Margin="8,0" TextTrimming="CharacterEllipsis"/>
                <Button Grid.Column="2" Content="Locate" Command="{Binding LocateCommand}" Style="{StaticResource Chip}"/>
                <Button Grid.Column="3" Content="Detach" Command="{Binding DetachCommand}" Style="{StaticResource Chip}"/>
            </Grid>
        </Border>

        <!-- Where the party is standing -->
        <Border DockPanel.Dock="Top" Background="#FF202B33" Padding="8,4">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="📍" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Text="{Binding Maps.LocationText}" Foreground="#FF9CDCFE" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Border>

        <!-- Party bar -->
        <Border DockPanel.Dock="Top" Background="#FF252526" Padding="8,4">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Party gold:" Style="{StaticResource Label}"/>
                <TextBox Text="{Binding Gold}" Width="120" VerticalAlignment="Center" Style="{StaticResource Field}"/>
                <Button Content="Write gold" Command="{Binding WriteGoldCommand}" Style="{StaticResource Primary}" Margin="4,0,16,0"/>
                <Button Content="Learn all spells (party)" Command="{Binding LearnAllSpellsAllCommand}" Style="{StaticResource Chip}"/>
                <Button Content="Infinite item charges (party)" Command="{Binding SetInfiniteItemsAllCommand}" Style="{StaticResource Chip}"/>
            </StackPanel>
        </Border>

        <!-- Main content area -->
        <TabControl Background="#FF1E1E1E" Foreground="#FFCCCCCC" BorderBrush="#FF555555" Padding="4">

            <!-- ============================= Maps ============================= -->
            <TabItem Header="Maps" Foreground="#FFCCCCCC">
                <Grid Margin="8" DataContext="{Binding Maps}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Map picker -->
                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" Text="Every area of the trilogy" Foreground="White"
                                   FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding ArchiveStatus}" Style="{StaticResource Note}"
                                   Margin="0,6,0,0"/>
                        <ListBox ItemsSource="{Binding Maps}" SelectedItem="{Binding SelectedMap}"
                                 Background="#FF2D2D30" Foreground="White" BorderBrush="#FF555555"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" Foreground="#FF4EC9B0" FontWeight="Bold"
                                                       Margin="0,6,0,2"/>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,1">
                                        <TextBlock Text="{Binding Display}"/>
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Note}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <!-- Map view and teleport controls -->
                    <DockPanel Grid.Column="1" Margin="8,0,0,0">
                        <!-- Teleport controls -->
                        <Border DockPanel.Dock="Top" Background="#FF252526" Padding="8,6" Margin="0,0,0,6">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="X:" Style="{StaticResource Label}"/>
                                    <TextBox Text="{Binding TargetX}" Width="46" Style="{StaticResource Field}"/>
                                    <TextBlock Text="Z:" Style="{StaticResource Label}"/>
                                    <TextBox Text="{Binding TargetZ}" Width="46" Style="{StaticResource Field}"/>
                                    <TextBlock Text="Facing:" Style="{StaticResource Label}" Margin="8,0,4,0"/>
                                    <ComboBox ItemsSource="{Binding FacingChoices}" SelectedItem="{Binding TargetFacing}"
                                              Width="80" Background="#FF333337" Foreground="White" BorderBrush="#FF555555"/>
                                    <TextBlock Text="Style:" Style="{StaticResource Label}" Margin="8,0,4,0"/>
                                    <ComboBox ItemsSource="{Binding TeleportStyles}" SelectedItem="{Binding TeleportStyle}"
                                              Width="110" Background="#FF333337" Foreground="White" BorderBrush="#FF555555"
                                              Margin="0,0,8,0"/>
                                    <Button Content="Teleport" Command="{Binding TeleportCommand}" Style="{StaticResource Primary}"/>
                                    <Button Content="Entry point" Command="{Binding GoToEntryCommand}" Style="{StaticResource Chip}"/>
                                    <Button Content="Show party" Command="{Binding GoToPartyCommand}" Style="{StaticResource Chip}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <CheckBox Content="Teleport on click" IsChecked="{Binding TeleportOnClick}"
                                              Foreground="#FFCCCCCC" Margin="0,0,12,0"/>
                                    <CheckBox Content="Follow the party" IsChecked="{Binding FollowParty}"
                                              Foreground="#FFCCCCCC" Margin="0,0,12,0"/>
                                    <CheckBox Content="Record in journal" IsChecked="{Binding JournalTeleport}"
                                              Foreground="#FFCCCCCC"/>
                                </StackPanel>
                                <TextBlock Text="{Binding HintText}" Style="{StaticResource Note}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- BT2 dream-spell destinations -->
                        <Expander DockPanel.Dock="Bottom" Header="ZZGO dream-spell destinations (BT2)"
                                  Foreground="#FFCCCCCC" Margin="0,6,0,0">
                            <ItemsControl ItemsSource="{Binding DreamTargets}" Margin="0,4,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Name}"
                                                Command="{Binding DataContext.TeleportToDreamTargetCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource Chip}" Margin="0,0,6,6"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>

                        <!-- The map itself -->
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                      Background="#FF14151A" BorderBrush="#FF555555" BorderThickness="1">
                            <Grid HorizontalAlignment="Left" VerticalAlignment="Top">
                                <Image x:Name="MapImage" Source="{Binding SelectedMap.Image}" Stretch="None"
                                       MouseLeftButtonUp="MapImage_MouseLeftButtonUp"
                                       HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                <Canvas IsHitTestVisible="False">
                                    <Ellipse Canvas.Left="{Binding MarkerLeft}" Canvas.Top="{Binding MarkerTop}"
                                             Width="{Binding MarkerSize}" Height="{Binding MarkerSize}"
                                             Stroke="#FFFFD24A" StrokeThickness="2.5" Fill="#66FFD24A">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding MarkerVisible}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                </Canvas>
                            </Grid>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- ========================== Characters ========================== -->
            <TabItem Header="Characters" Foreground="#FFCCCCCC">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ListBox Grid.Column="0" ItemsSource="{Binding Characters}"
                             SelectedIndex="{Binding SelectedCharacterIndex}"
                             Background="#FF2D2D30" Foreground="White" BorderBrush="#FF555555">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Header}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="8,0,0,0">
                        <StackPanel DataContext="{Binding SelectedCharacter}">
                            <TextBlock Text="{Binding Header}" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,8"/>

                            <GroupBox Header="Core" Foreground="#FFCCCCCC" Margin="0,0,0,8" Padding="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Level:" Style="{StaticResource Label}"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Level}" Style="{StaticResource Field}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="XP:" Style="{StaticResource Label}"/>
                                    <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding Experience}" Style="{StaticResource Field}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="4" Text="Gold carried:" Style="{StaticResource Label}"/>
                                    <TextBox Grid.Row="0" Grid.Column="5" Text="{Binding Gold}" Style="{StaticResource Field}"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="HP:" Style="{StaticResource Label}"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding HpCur}" Style="{StaticResource Field}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="HP max:" Style="{StaticResource Label}"/>
                                    <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding HpMax}" Style="{StaticResource Field}"/>
                                    <CheckBox Grid.Row="1" Grid.Column="4" Grid.ColumnSpan="2" Content="Freeze HP"
                                              IsChecked="{Binding FreezeHp}" Foreground="#FFCCCCCC" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="SP:" Style="{StaticResource Label}"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SpCur}" Style="{StaticResource Field}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="SP max:" Style="{StaticResource Label}"/>
                                    <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding SpMax}" Style="{StaticResource Field}"/>
                                    <CheckBox Grid.Row="2" Grid.Column="4" Grid.ColumnSpan="2" Content="Freeze SP"
                                              IsChecked="{Binding FreezeSp}" Foreground="#FFCCCCCC" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Race:" Style="{StaticResource Label}"/>
                                    <ComboBox Grid.Row="3" Grid.Column="1" SelectedIndex="{Binding Race}"
                                              Background="#FF333337" Foreground="White" BorderBrush="#FF555555">
                                        <ComboBoxItem Content="Human"/>
                                        <ComboBoxItem Content="Elf"/>
                                        <ComboBoxItem Content="Dwarf"/>
                                        <ComboBoxItem Content="Hobbit"/>
                                        <ComboBoxItem Content="Half-Elf"/>
                                        <ComboBoxItem Content="Half-Orc"/>
                                        <ComboBoxItem Content="Gnome"/>
                                    </ComboBox>
                                    <TextBlock Grid.Row="3" Grid.Column="2" Text="Class:" Style="{StaticResource Label}"/>
                                    <ComboBox Grid.Row="3" Grid.Column="3"
                                              ItemsSource="{Binding ClassChoices}" DisplayMemberPath="Name"
                                              SelectedValuePath="Id" SelectedValue="{Binding Class}"
                                              Background="#FF333337" Foreground="White" BorderBrush="#FF555555"/>
                                    <TextBlock Grid.Row="3" Grid.Column="4" Text="Condition:" Style="{StaticResource Label}"/>
                                    <ComboBox Grid.Row="3" Grid.Column="5" SelectedIndex="{Binding Condition}"
                                              Background="#FF333337" Foreground="White" BorderBrush="#FF555555">
                                        <ComboBoxItem Content="Okay"/>
                                        <ComboBoxItem Content="Poisoned"/>
                                        <ComboBoxItem Content="Old"/>
                                        <ComboBoxItem Content="Dead"/>
                                        <ComboBoxItem Content="Stoned"/>
                                        <ComboBoxItem Content="Paralyzed"/>
                                        <ComboBoxItem Content="Possessed"/>
                                        <ComboBoxItem Content="Insane"/>
                                        <ComboBoxItem Content="Drained"/>
                                    </ComboBox>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="Attributes" Foreground="#FFCCCCCC" Margin="0,0,0,8" Padding="8">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="St:" Style="{StaticResource Label}"/>
                                        <TextBox Text="{Binding Strength}" Width="52" Style="{StaticResource Field}"/>
                                        <TextBlock Text="IQ:" Style="{StaticResource Label}"/>
                                        <TextBox Text="{Binding Intelligence}" Width="52" Style="{StaticResource Field}"/>
                                        <TextBlock Text="Dx:" Style="{StaticResource Label}"/>
                                        <TextBox Text="{Binding Dexterity}" Width="52" Style="{StaticResource Field}"/>
                                        <TextBlock Text="Cn:" Style="{StaticResource Label}"/>
                                        <TextBox Text="{Binding Constitution}" Width="52" Style="{StaticResource Field}"/>
                                        <TextBlock Text="Lk:" Style="{StaticResource Label}"/>
                                        <TextBox Text="{Binding Luck}" Width="52" Style="{StaticResource Field}"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Note}" Margin="0,4,0,0"
                                               Text="The remaster keeps one value per attribute — there is no separate maximum, and armour class is computed from equipment rather than stored."/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Spell levels" Foreground="#FFCCCCCC" Margin="0,0,0,8" Padding="8">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding SpellLevels}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,14,4">
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Label}" Width="94"/>
                                                    <TextBox Text="{Binding Level}" Width="40" Style="{StaticResource Field}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Style="{StaticResource Note}"
                                               Text="Held in m_spellLevel, an int[16] indexed by class id — so each school's level is edited on its own. 0–7; a level grants every spell of that school up to it."/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Class" Foreground="#FFCCCCCC" Margin="0,0,0,8" Padding="8">
                                <StackPanel>
                                    <TextBlock Text="{Binding ClassSummary}" Foreground="#FF999999" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Change to:" Style="{StaticResource Label}"/>
                                        <ComboBox ItemsSource="{Binding ClassChoices}" DisplayMemberPath="Display"
                                                  SelectedValuePath="Id" SelectedValue="{Binding TargetClass}"
                                                  Width="180" Background="#FF333337" Foreground="White" BorderBrush="#FF555555"
                                                  Margin="0,0,8,0"/>
                                        <Button Content="Change class" Click="ChangeClass_Click" Style="{StaticResource Primary}"/>
                                        <CheckBox Content="Ignore requirements" IsChecked="{Binding IgnoreClassRequirements}"
                                                  Foreground="#FFCCCCCC" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding ClassChangeStatus}" Foreground="#FF4EC9B0" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Class scores" Foreground="#FFCCCCCC" Margin="0,0,0,8" Padding="8">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Critical hit:" Style="{StaticResource Label}"/>
                                        <TextBox Text="{Binding CriticalHit}" Width="52" Style="{StaticResource Field}"/>
                                        <TextBlock Text="Disarm:" Style="{StaticResource Label}"/>
                                        <TextBox Text="{Binding DisarmTrapBonus}" Width="52" Style="{StaticResource Field}"/>
                                        <TextBlock Text="Hide:" Style="{StaticResource Label}"/>
                                        <TextBox Text="{Binding HideInShadowsBonus}" Width="52" Style="{StaticResource Field}"/>
                                        <TextBlock Text="Identify:" Style="{StaticResource Label}"/>
                                        <TextBox Text="{Binding IdentifyBonus}" Width="52" Style="{StaticResource Field}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="Attacks:" Style="{StaticResource Label}"/>
                                        <TextBox Text="{Binding Attacks}" Width="52" Style="{StaticResource Field}"/>
                                        <TextBlock Text="Tunes left:" Style="{StaticResource Label}"/>
                                        <TextBox Text="{Binding SongsRemaining}" Width="52" Style="{StaticResource Field}"/>
                                        <TextBlock Text="Songs known:" Style="{StaticResource Label}"/>
                                        <TextBox Text="{Binding SongsKnown}" Width="52" Style="{StaticResource Field}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button Content="Write scores" Click="WriteClassScores_Click" Style="{StaticResource Primary}"/>
                                        <Button Content="Max class scores" Click="MaxClassScores_Click" Style="{StaticResource Chip}"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Note}" Margin="0,4,0,0"
                                               Text="Real fields on the character. Critical hit, disarm, hide and identify are what the game rolls against, 0–255 where 255 is a certainty — the remaster then subtracts a per-map penalty, so even 255 misses deep in a dungeon. Attacks per round and songs known are counts, so Max class scores leaves them alone and only refills tunes to the character&apos;s level."/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Class abilities" Foreground="#FFCCCCCC" Margin="0,0,0,8" Padding="8">
                                <ItemsControl ItemsSource="{Binding ClassAbilities}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,6">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" Foreground="#FFCCCCCC" FontWeight="Bold" Width="250"/>
                                                    <TextBlock Text="{Binding Value}" Foreground="#FF4EC9B0"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Note}" Margin="0,1,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </GroupBox>

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="Write all" Click="WriteAll_Click" Style="{StaticResource Primary}"/>
                                <Button Content="Learn all spells" Click="LearnAllSpells_Click" Style="{StaticResource Chip}"/>
                                <Button Content="Infinite item charges" Click="SetInfiniteItems_Click" Style="{StaticResource Chip}"/>
                                <Button Content="Full heal" Click="FullHeal_Click" Style="{StaticResource Chip}"/>
                                <Button Content="Max attributes" Click="MaxAttributes_Click" Style="{StaticResource Chip}"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ============================ Spells ============================ -->
            <TabItem Header="Spells" Foreground="#FFCCCCCC">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Spell code:" Style="{StaticResource Label}"/>
                        <TextBox Text="{Binding SpellCode}" Width="90" Style="{StaticResource Field}"/>
                        <Button Content="Grant to selected character" Command="{Binding AssignSpellCommand}"
                                Style="{StaticResource Primary}" Margin="8,0,0,0"/>
                        <Button Content="Grant ZZGO, NUKE, GILL and DIVA" Command="{Binding GrantSpecialSpellsCommand}"
                                Style="{StaticResource Chip}" Margin="8,0,0,0"/>
                        <Button Content="…to whole party" Command="{Binding GrantSpecialSpellsAllCommand}"
                                Style="{StaticResource Chip}" Margin="4,0,0,0"/>
                    </StackPanel>

                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Note}" Margin="0,0,0,4"
                               Text="A spell with a school level is granted by raising that school. A spell without one — ZZGO, NUKE and the quest spells — is written straight into the character's learnt-spell list, which is the only place the game keeps it."/>

                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <CheckBox Content="Let the game allocate when a learnt-spell list is full"
                                  IsChecked="{Binding AllowGameAllocation}" Foreground="#FFCCCCCC"/>
                        <TextBlock Text="{Binding RuntimeStatus}" Style="{StaticResource Note}" Margin="18,2,0,0"/>
                    </StackPanel>

                    <!-- Spells that no school level can grant -->
                    <GroupBox DockPanel.Dock="Top" Header="Granted outright" Foreground="#FFCCCCCC"
                              Margin="0,0,0,8" Padding="8">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding SpecialSpellRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="210"/>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="Grant" Style="{StaticResource Chip}"
                                                    Command="{Binding DataContext.GrantSpellCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Label}" Foreground="#FFCCCCCC"
                                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding CostText}" Foreground="#FF888888"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Note}" Foreground="#FF888888"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </GroupBox>

                    <!-- What the selected character has been granted -->
                    <GroupBox DockPanel.Dock="Top" Header="Selected character's learnt-spell list"
                              Foreground="#FFCCCCCC" Margin="0,0,0,8" Padding="8"
                              DataContext="{Binding SelectedCharacter}">
                        <StackPanel>
                            <TextBlock Text="{Binding LearntSpellsSummary}" Style="{StaticResource Note}"/>
                            <ItemsControl ItemsSource="{Binding LearntSpells}" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                            <Button Content="Remove" Style="{StaticResource Chip}"
                                                    Command="{Binding DataContext.RevokeSpellCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                            <TextBlock Text="{Binding Display}" Foreground="#FFCCCCCC"
                                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </GroupBox>

                    <TextBlock DockPanel.Dock="Top" Text="{Binding SpellTableStatus}"
                               Style="{StaticResource Note}" Margin="0,0,0,4"/>

                    <DataGrid ItemsSource="{Binding SpellTable}" AutoGenerateColumns="False"
                              IsReadOnly="True" Background="#FF1E1E1E" Foreground="#FFCCCCCC"
                              RowBackground="#FF252526" AlternatingRowBackground="#FF2D2D30"
                              GridLinesVisibility="None" BorderBrush="#FF555555" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="70"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="220"/>
                            <DataGridTextColumn Header="Known from" Binding="{Binding Source}" Width="190"/>
                            <DataGridTextColumn Header="SP" Binding="{Binding Cost}" Width="50"/>
                            <DataGridTextColumn Header="Games" Binding="{Binding Games}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ========================== References ========================== -->
            <TabItem Header="Items" Foreground="#FFCCCCCC">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8">
                    <StackPanel>
                        <TextBlock Text="Items (1–127)" Foreground="#FF4EC9B0" FontWeight="Bold" FontSize="14" Margin="0,0,0,4"/>
                        <ItemsControl ItemsSource="{x:Static local:ItemBook.Choices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Foreground="#FFCCCCCC" Margin="8,0,0,2">
                                        <Run Text="{Binding Display}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
