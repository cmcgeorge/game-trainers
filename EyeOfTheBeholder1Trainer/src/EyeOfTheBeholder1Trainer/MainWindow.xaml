<Window x:Class="EyeOfTheBeholder1Trainer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Eye of the Beholder Trainer" Height="720" Width="960"
        WindowStartupLocation="CenterScreen" WindowState="Maximized">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="2,1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="8,3"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Padding" Value="2,1"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4,0,4,0"/>
            <Setter Property="MinWidth" Value="60"/>
        </Style>
        <Style x:Key="RefHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="2,6,2,2"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Background="#EEE" Padding="6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Process:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox Width="280" ItemsSource="{Binding Processes}" DisplayMemberPath="Display"
                          SelectedItem="{Binding SelectedProcess}"/>
                <Button Content="Refresh" Command="{Binding RefreshProcessesCommand}"/>
                <Button Content="Attach" Command="{Binding AttachCommand}"/>
                <Button Content="Detach" Command="{Binding DetachCommand}"/>
                <Button Content="Re-scan" Command="{Binding ScanCommand}"/>
            </StackPanel>
        </Border>

        <!-- Party-wide actions -->
        <Border DockPanel.Dock="Top" Background="#F6F6F6" Padding="6">
            <StackPanel Orientation="Horizontal">
                <CheckBox Content="Freeze HP" IsChecked="{Binding FreezeHp}" VerticalAlignment="Center" Margin="4,0"
                          ToolTip="Keeps each character at max HP."/>
                <CheckBox Content="Freeze Food" IsChecked="{Binding FreezeFood}" VerticalAlignment="Center" Margin="4,0"
                          ToolTip="Keeps food at 100%."/>
                <Separator Style="{x:Null}" Width="12"/>
                <Button Content="Heal Party" Command="{Binding HealPartyCommand}"/>
                <Button Content="Max Attributes" Command="{Binding MaxPartyCommand}"/>
                <Button Content="Max HP" Command="{Binding MaxHpPartyCommand}"/>
                <Button Content="Max Everything" Command="{Binding MaxEverythingPartyCommand}"/>
            </StackPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="#EEE" Padding="6">
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
        </Border>

        <!-- Tabs -->
        <TabControl Margin="6">
            <!-- ======================= PARTY ======================= -->
            <TabItem Header="Party">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <GroupBox Grid.Column="0" Header="Party">
                        <ListBox ItemsSource="{Binding Party}" SelectedItem="{Binding SelectedCharacter}"
                                 DisplayMemberPath="ListLabel"/>
                    </GroupBox>

                    <GroupBox Grid.Column="1" Header="Character" Margin="6,0,0,0"
                              DataContext="{Binding SelectedCharacter}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="6">
                                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14" Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding Summary}" Foreground="#555" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                <!-- Quick actions -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Content="Full Heal" Click="FullHeal_Click"/>
                                    <Button Content="Max Attributes" Click="MaxAttributes_Click"/>
                                    <Button Content="Max HP" Click="MaxHp_Click"/>
                                    <Button Content="Max Everything" Click="MaxEverything_Click"/>
                                </StackPanel>

                                <!-- Name -->
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="140"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Name" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>

                                <!-- Attributes -->
                                <TextBlock Text="Attributes" FontWeight="Bold" Margin="0,8,0,2"/>
                                <ItemsControl ItemsSource="{Binding Attributes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40"/>
                                                    <ColumnDefinition Width="60"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Exceptional Strength -->
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Exc STR (mod)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Grid.Column="1" Text="{Binding StrExcModified, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Column="2" Text="Exc STR (base)" Style="{StaticResource FieldLabel}" Margin="8,0,4,0"/>
                                    <TextBox Grid.Column="3" Text="{Binding StrExcBase, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>

                                <!-- Vitals -->
                                <TextBlock Text="Vitals" FontWeight="Bold" Margin="0,8,0,2"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="HP Cur" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Grid.Column="1" Text="{Binding HpCurrent, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Column="2" Text="HP Max" Style="{StaticResource FieldLabel}" Margin="8,0,4,0"/>
                                    <TextBox Grid.Column="3" Text="{Binding HpMax, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="AC" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Grid.Column="1" Text="{Binding ArmorClass, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Column="2" Text="Food %" Style="{StaticResource FieldLabel}" Margin="8,0,4,0"/>
                                    <TextBox Grid.Column="3" Text="{Binding Food, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>

                                <!-- Identity -->
                                <TextBlock Text="Identity" FontWeight="Bold" Margin="0,8,0,2"/>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Race" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding RaceOptions}"
                                              SelectedIndex="{Binding RaceIndex}"/>
                                </Grid>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Class" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding ClassOptions}"
                                              SelectedIndex="{Binding ClassIndex}"/>
                                </Grid>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Alignment" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding AlignmentOptions}"
                                              SelectedIndex="{Binding AlignmentIndex}"/>
                                </Grid>

                                <!-- Levels / XP -->
                                <TextBlock Text="Levels &amp; Experience" FontWeight="Bold" Margin="0,8,0,2"/>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Lvl 1" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Grid.Column="1" Text="{Binding Level1, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Column="2" Text="XP 1" Style="{StaticResource FieldLabel}" Margin="8,0,4,0"/>
                                    <TextBox Grid.Column="3" Text="{Binding Xp1, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Lvl 2" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Grid.Column="1" Text="{Binding Level2, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Column="2" Text="XP 2" Style="{StaticResource FieldLabel}" Margin="8,0,4,0"/>
                                    <TextBox Grid.Column="3" Text="{Binding Xp2, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Lvl 3" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Grid.Column="1" Text="{Binding Level3, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Column="2" Text="XP 3" Style="{StaticResource FieldLabel}" Margin="8,0,4,0"/>
                                    <TextBox Grid.Column="3" Text="{Binding Xp3, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>

                                <!-- Per-character freeze -->
                                <TextBlock Text="Freezes" FontWeight="Bold" Margin="0,8,0,2"/>
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox Content="Freeze HP" IsChecked="{Binding FreezeHp}" Margin="4,0"
                                              ToolTip="Re-pins HP to max each poll tick."/>
                                    <CheckBox Content="Freeze Food" IsChecked="{Binding FreezeFood}" Margin="4,0"
                                              ToolTip="Re-pins food to 100% each poll tick."/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- ======================= SAVE EDITOR ======================= -->
            <TabItem Header="Save Editor">
                <DockPanel Margin="6">
                    <Border DockPanel.Dock="Top" Background="#F6F6F6" Padding="6">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Load EOBDATA.SAV" Command="{Binding SaveEditor.LoadCommand}"/>
                            <Button Content="Save" Command="{Binding SaveEditor.SaveCommand}"/>
                            <Button Content="Save As…" Command="{Binding SaveEditor.SaveAsCommand}"/>
                            <Separator Style="{x:Null}" Width="12"/>
                            <Button Content="Heal All" Command="{Binding SaveEditor.HealAllCommand}"/>
                            <Button Content="Max Attributes" Command="{Binding SaveEditor.MaxAttributesCommand}"/>
                            <Button Content="Max HP" Command="{Binding SaveEditor.MaxHpCommand}"/>
                            <Button Content="Max Everything" Command="{Binding SaveEditor.MaxEverythingCommand}"/>
                        </StackPanel>
                    </Border>
                    <Border DockPanel.Dock="Bottom" Background="#EEE" Padding="6">
                        <TextBlock Text="{Binding SaveEditor.Status}" TextWrapping="Wrap"/>
                    </Border>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <GroupBox Grid.Column="0" Header="Characters">
                            <ListBox ItemsSource="{Binding SaveEditor.Characters}"
                                     SelectedItem="{Binding SaveEditor.SelectedCharacter}"
                                     DisplayMemberPath="ListLabel"/>
                        </GroupBox>
                        <GroupBox Grid.Column="1" Header="Character" Margin="6,0,0,0"
                                  DataContext="{Binding SaveEditor.SelectedCharacter}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="6">
                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14" Margin="0,0,0,2"/>
                                    <TextBlock Text="{Binding Summary}" Foreground="#555" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Button Content="Full Heal" Click="FullHeal_Click"/>
                                        <Button Content="Max Attributes" Click="MaxAttributes_Click"/>
                                        <Button Content="Max HP" Click="MaxHp_Click"/>
                                        <Button Content="Max Everything" Click="MaxEverything_Click"/>
                                    </StackPanel>

                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="140"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Name" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Grid>

                                    <TextBlock Text="Attributes" FontWeight="Bold" Margin="0,8,0,2"/>
                                    <ItemsControl ItemsSource="{Binding Attributes}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="40"/>
                                                        <ColumnDefinition Width="60"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center"/>
                                                    <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Exc STR (m)" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Grid.Column="1" Text="{Binding StrExcModified, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Grid.Column="2" Text="Exc STR (b)" Style="{StaticResource FieldLabel}" Margin="8,0,4,0"/>
                                        <TextBox Grid.Column="3" Text="{Binding StrExcBase, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="HP Cur" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Grid.Column="1" Text="{Binding HpCurrent, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Grid.Column="2" Text="HP Max" Style="{StaticResource FieldLabel}" Margin="8,0,4,0"/>
                                        <TextBox Grid.Column="3" Text="{Binding HpMax, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="AC" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Grid.Column="1" Text="{Binding ArmorClass, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Grid.Column="2" Text="Food %" Style="{StaticResource FieldLabel}" Margin="8,0,4,0"/>
                                        <TextBox Grid.Column="3" Text="{Binding Food, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Grid>

                                    <TextBlock Text="Identity" FontWeight="Bold" Margin="0,8,0,2"/>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Race" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding RaceOptions}"
                                                  SelectedIndex="{Binding RaceIndex}"/>
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Class" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding ClassOptions}"
                                                  SelectedIndex="{Binding ClassIndex}"/>
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Alignment" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding AlignmentOptions}"
                                                  SelectedIndex="{Binding AlignmentIndex}"/>
                                    </Grid>

                                    <TextBlock Text="Levels &amp; XP" FontWeight="Bold" Margin="0,8,0,2"/>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Lvl 1" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Grid.Column="1" Text="{Binding Level1, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Grid.Column="2" Text="XP 1" Style="{StaticResource FieldLabel}" Margin="8,0,4,0"/>
                                        <TextBox Grid.Column="3" Text="{Binding Xp1, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Lvl 2" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Grid.Column="1" Text="{Binding Level2, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Grid.Column="2" Text="XP 2" Style="{StaticResource FieldLabel}" Margin="8,0,4,0"/>
                                        <TextBox Grid.Column="3" Text="{Binding Xp2, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Lvl 3" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Grid.Column="1" Text="{Binding Level3, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Grid.Column="2" Text="XP 3" Style="{StaticResource FieldLabel}" Margin="8,0,4,0"/>
                                        <TextBox Grid.Column="3" Text="{Binding Xp3, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </GroupBox>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- ======================= REFERENCE ======================= -->
            <TabItem Header="Reference">
                <TabControl Margin="6">
                    <TabItem Header="Spells">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Eye of the Beholder Spells" Style="{StaticResource RefHeader}"/>
                            <DataGrid ItemsSource="{Binding Reference.Spells}" AutoGenerateColumns="False"
                                      IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180"/>
                                    <DataGridTextColumn Header="School" Binding="{Binding School}" Width="70"/>
                                    <DataGridTextColumn Header="Lvl" Binding="{Binding Level}" Width="40"/>
                                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="Classes">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Character Classes" Style="{StaticResource RefHeader}"/>
                            <ListBox ItemsSource="{Binding Reference.Classes}"/>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="Races">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Races" Style="{StaticResource RefHeader}"/>
                            <ListBox ItemsSource="{Binding Reference.Races}"/>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="Alignments">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Alignments" Style="{StaticResource RefHeader}"/>
                            <ListBox ItemsSource="{Binding Reference.Alignments}"/>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </TabItem>

            <TabItem Header="Maps" DataContext="{Binding Maps}">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <DockPanel Grid.Column="0" Margin="0,0,6,0">
                        <TextBlock DockPanel.Dock="Top" Text="Dungeon Levels" Style="{StaticResource RefHeader}"/>
                        <ListBox ItemsSource="{Binding Levels}" SelectedItem="{Binding Selected}" DisplayMemberPath="Name"/>
                    </DockPanel>
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedDescription}" Style="{StaticResource RefHeader}" TextWrapping="Wrap"/>
                            <TextBlock Text="Reference maps only; live position tracking and teleport are not available." TextWrapping="Wrap" Foreground="#555" Margin="2,0,2,6"/>
                            <Image Source="{Binding SelectedImage}" Stretch="None" Margin="0,4,0,12" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            <TextBlock Text="Points of Interest" Style="{StaticResource RefHeader}"/>
                            <ListView ItemsSource="{Binding Pois}" Margin="0,0,0,8">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Pos" Width="65" DisplayMemberBinding="{Binding Position}"/>
                                        <GridViewColumn Header="Name" Width="150" DisplayMemberBinding="{Binding Name}"/>
                                        <GridViewColumn Header="Description" Width="400" DisplayMemberBinding="{Binding Description}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="Cluebook" DataContext="{Binding Cluebook}">
                <StackPanel Margin="12">
                    <TextBlock Text="Eye of the Beholder Cluebook" Style="{StaticResource RefHeader}" FontSize="16"/>
                    <TextBlock Text="Generate a self-contained HTML strategy guide with all twelve dungeon maps, spell references, character options, a walkthrough, and strategy notes." TextWrapping="Wrap" Margin="0,0,0,12" MaxWidth="650" Foreground="#555"/>
                    <TextBlock Text="Include" Style="{StaticResource RefHeader}"/>
                    <WrapPanel Margin="8,0,0,8">
                        <CheckBox Content="Dungeon maps" IsChecked="{Binding IncludeMaps}" Margin="8,4"/>
                        <CheckBox Content="Spells" IsChecked="{Binding IncludeSpells}" Margin="8,4"/>
                        <CheckBox Content="Races &amp; classes" IsChecked="{Binding IncludeClasses}" Margin="8,4"/>
                        <CheckBox Content="Walkthrough" IsChecked="{Binding IncludeWalkthrough}" Margin="8,4"/>
                        <CheckBox Content="Strategy notes" IsChecked="{Binding IncludeStrategy}" Margin="8,4"/>
                    </WrapPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,8">
                        <Button Content="Save cluebook" Command="{Binding SaveCommand}"/>
                        <Button Content="Open in browser" Command="{Binding OpenCommand}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Status}" Foreground="#555" TextWrapping="Wrap"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
