<Window x:Class="DarkDesigns1Trainer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DarkDesigns1Trainer"
        Title="Dark Designs I Trainer" Height="720" Width="960"
        Icon="Assets/app.ico"
        WindowStartupLocation="CenterScreen" WindowState="Maximized">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:MapScaleConverter x:Key="MapScale"/>
        <local:WallBrushConverter x:Key="WallBrush"/>
        <local:SquareBrushConverter x:Key="SquareBrush"/>
        <local:VisitedBrushConverter x:Key="VisitedBrush"/>
        <local:FacingAngleConverter x:Key="FacingAngle"/>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="2,1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="8,3"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Padding" Value="2,1"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4,0,4,0"/>
            <Setter Property="MinWidth" Value="60"/>
        </Style>
        <Style x:Key="RefHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="2,6,2,2"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Background="#EEE" Padding="6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Process:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox Width="280" ItemsSource="{Binding Processes}" DisplayMemberPath="Display"
                          SelectedItem="{Binding SelectedProcess}"/>
                <Button Content="Refresh" Command="{Binding RefreshProcessesCommand}"/>
                <Button Content="Attach" Command="{Binding AttachCommand}"/>
                <Button Content="Detach" Command="{Binding DetachCommand}"/>
                <Button Content="Re-scan" Command="{Binding ScanCommand}"/>
            </StackPanel>
        </Border>

        <!-- Party-wide actions -->
        <Border DockPanel.Dock="Top" Background="#F6F6F6" Padding="6">
            <StackPanel Orientation="Horizontal">
                <CheckBox Content="Freeze Body" IsChecked="{Binding FreezeBody}" VerticalAlignment="Center" Margin="4,0"/>
                <CheckBox Content="Freeze Magic" IsChecked="{Binding FreezeMagic}" VerticalAlignment="Center" Margin="4,0"/>
                <CheckBox Content="Freeze Status" IsChecked="{Binding FreezeStatus}" VerticalAlignment="Center" Margin="4,0"
                          ToolTip="Keeps the whole party at status Fine — no KO, stun, stone, or death."/>
                <Separator Style="{x:Null}" Width="12"/>
                <Button Content="Heal Party" Command="{Binding HealPartyCommand}"/>
                <Button Content="Max Attributes" Command="{Binding MaxPartyCommand}"/>
                <Button Content="Max Money" Command="{Binding MaxMoneyPartyCommand}"/>
                <Button Content="Max Everything" Command="{Binding MaxEverythingPartyCommand}"/>
                <Separator Style="{x:Null}" Width="12"/>
                <CheckBox Content="Items never break" IsChecked="{Binding ItemsNeverBreak}" VerticalAlignment="Center" Margin="4,0"
                          ToolTip="Dark Designs has no charges — it destroys a used item unless a random roll goes its way. This pins that roll so potions, wands, scrolls and keys survive every use. Patches the game's item table, so it applies to everyone and is undone when you detach."/>
                <CheckBox Content="Magic weapons always trigger" IsChecked="{Binding WeaponsAlwaysTrigger}" VerticalAlignment="Center" Margin="4,0"
                          ToolTip="The same roll decides whether a magic weapon's special effect fires on a hit. This pins it so it always does."/>
                <CheckBox Content="Keep on detach" IsChecked="{Binding KeepPatchesOnDetach}" VerticalAlignment="Center" Margin="4,0"
                          ToolTip="By default the two item patches above are undone when you detach, so the game is never left altered with nothing attached to undo it. Tick this to leave them in place instead — they then last until the game exits. Re-attach and untick a toggle to restore the original values."/>
            </StackPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="#EEE" Padding="6">
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
        </Border>

        <!-- Tabs -->
        <TabControl Margin="6">
            <!-- ======================= PARTY (LIVE) ======================= -->
            <TabItem Header="Party">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <GroupBox Grid.Column="0" Header="Characters">
                        <ListBox ItemsSource="{Binding Party}" SelectedItem="{Binding SelectedCharacter}"
                                 DisplayMemberPath="ListLabel"/>
                    </GroupBox>

                    <GroupBox Grid.Column="1" Header="Character" Margin="6,0,0,0"
                              DataContext="{Binding SelectedCharacter}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="6">
                                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14" Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding Summary}" Foreground="#555" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" Style="{StaticResource FieldLabel}"/>
                                    <TextBox   Grid.Row="0" Grid.Column="1" Text="{Binding Name}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Class" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox  Grid.Row="0" Grid.Column="3" Margin="2"
                                               ItemsSource="{Binding ClassOptions}"
                                               SelectedIndex="{Binding ClassIndex}"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Level" Style="{StaticResource FieldLabel}"/>
                                    <TextBox   Grid.Row="1" Grid.Column="1" Text="{Binding Level}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Experience" Style="{StaticResource FieldLabel}"/>
                                    <TextBox   Grid.Row="1" Grid.Column="3" Text="{Binding Experience}"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Gold" Style="{StaticResource FieldLabel}"/>
                                    <TextBox   Grid.Row="2" Grid.Column="1" Text="{Binding Gold}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Status" Style="{StaticResource FieldLabel}"/>
                                    <TextBox   Grid.Row="2" Grid.Column="3" Text="{Binding Status}"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Slot" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Slot}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="3" Grid.Column="2" Text="XP to next" Style="{StaticResource FieldLabel}"/>
                                    <TextBox   Grid.Row="3" Grid.Column="3" Text="{Binding NextLevel}"/>
                                </Grid>

                                <GroupBox Header="Vitals" Margin="0,8,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="90"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Body" Style="{StaticResource FieldLabel}"/>
                                        <TextBox   Grid.Row="0" Grid.Column="1" Text="{Binding BodyCurrent}"/>
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="/ Max" Style="{StaticResource FieldLabel}"/>
                                        <TextBox   Grid.Row="0" Grid.Column="3" Text="{Binding BodyMax}"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Magic" Style="{StaticResource FieldLabel}"/>
                                        <TextBox   Grid.Row="1" Grid.Column="1" Text="{Binding MagicCurrent}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="/ Max" Style="{StaticResource FieldLabel}"/>
                                        <TextBox   Grid.Row="1" Grid.Column="3" Text="{Binding MagicMax}"/>
                                    </Grid>
                                </GroupBox>

                                <GroupBox Header="Attributes" Margin="0,8,0,0">
                                    <ItemsControl ItemsSource="{Binding Attributes}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="4">
                                                    <TextBlock Text="{Binding Name}" Width="40" VerticalAlignment="Center"/>
                                                    <TextBox Width="60" Text="{Binding Value}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </GroupBox>

                                <GroupBox Header="Readied equipment" Margin="0,8,0,0">
                                    <ItemsControl ItemsSource="{Binding Equipment}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="90"/>
                                                        <ColumnDefinition Width="180"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center"/>
                                                    <ComboBox Grid.Column="1" Margin="2"
                                                              ItemsSource="{Binding Options}"
                                                              SelectedItem="{Binding Selected}"
                                                              DisplayMemberPath="Name"/>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Detail}" Foreground="#666"/>
                                                        <TextBlock Text="  ⚠ the game would reject this here" Foreground="#B00">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsLegal}" Value="False">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </GroupBox>

                                <GroupBox Header="Carried pack (item screen keys A–J)" Margin="0,8,0,0">
                                    <StackPanel>
                                        <ItemsControl ItemsSource="{Binding Inventory}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="90"/>
                                                            <ColumnDefinition Width="180"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center"/>
                                                        <ComboBox Grid.Column="1" Margin="2"
                                                                  ItemsSource="{Binding Options}"
                                                                  SelectedItem="{Binding Selected}"
                                                                  DisplayMemberPath="Name"/>
                                                        <Button Grid.Column="2" Content="Duplicate" Margin="2,2,8,2"
                                                                Padding="6,1" Command="{Binding DuplicateCommand}"
                                                                ToolTip="Copy this item into the first free pack slot"/>
                                                        <TextBlock Grid.Column="3" Text="{Binding Detail}"
                                                                   Foreground="#666" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding SyncNote}" Foreground="#555"
                                                   TextWrapping="Wrap" Margin="4,6,4,0"/>
                                        <TextBlock Foreground="#555" TextWrapping="Wrap" Margin="4,4,4,0"
                                                   Text="Buying is not simulated — a new item just appears in the slot. Ready it in the game ((I)tems → (R)eady) before it counts in combat."/>
                                    </StackPanel>
                                </GroupBox>

                                <WrapPanel Margin="0,8,0,0">
                                    <Button Content="Full Heal" Click="FullHeal_Click"/>
                                    <Button Content="Max Attributes" Click="MaxAttributes_Click"/>
                                    <Button Content="Max Money" Click="MaxMoney_Click"/>
                                    <Button Content="Max Everything" Click="MaxEverything_Click"/>
                                    <Button Content="Empty Pack" Click="ClearPack_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- ======================= CREATE (auto re-roll on the town (C)reate screen) ======================= -->
            <TabItem Header="🎲 Create" DataContext="{Binding Roller}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                    <StackPanel Margin="6" MaxWidth="660" HorizontalAlignment="Left">
                        <TextBlock Text="Roll a character" Style="{StaticResource RefHeader}"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,8"
                                   Text="Automates the town (C)reate screen's re-roll: it taps R for you and reads each fresh roll straight from the game's memory, stopping when the five values can be arranged to meet your minimums. The rolled stats aren't a character yet, so the trainer has to find them first — type the five numbers showing on the create screen, click Lock onto roll, then set a target and Roll. Attach to the game and open the create screen first."/>

                        <!-- 1 · capture the on-screen roll to locate it in memory -->
                        <GroupBox Header="1 · Capture the current roll" Margin="0,4,0,0">
                            <StackPanel Margin="4">
                                <TextBlock TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,6"
                                           Text="Enter the five rolled numbers from the create screen. Order doesn't matter — the trainer matches the set. 'Live' fills in once locked, and updates on every roll."/>
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Value" Foreground="#777"/>
                                    <TextBlock Grid.Column="1" Text="On screen" Foreground="#777"/>
                                    <TextBlock Grid.Column="2" Text="Live" Foreground="#777"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Slots}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center"
                                                           ToolTip="{Binding Description}"/>
                                                <TextBox Grid.Column="1" Width="60" HorizontalAlignment="Left"
                                                         Text="{Binding CapturedText, UpdateSourceTrigger=LostFocus}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding LiveText}" VerticalAlignment="Center"
                                                           FontFamily="Consolas" Foreground="#1565C0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border BorderBrush="#DDD" BorderThickness="0,1,0,0" Margin="0,2"/>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Total" FontWeight="SemiBold" VerticalAlignment="Center"
                                               ToolTip="Sum of the five rolled values. A fair roll averages 70."/>
                                    <TextBlock Grid.Column="1" Text="{Binding CapturedTotalText}" VerticalAlignment="Center" Foreground="#555"/>
                                    <TextBlock Grid.Column="2" Text="{Binding LiveTotalText}" VerticalAlignment="Center"
                                               FontFamily="Consolas" FontWeight="SemiBold" Foreground="#1565C0"/>
                                </Grid>

                                <WrapPanel Margin="0,8,0,0">
                                    <Button Content="🎯 Lock onto roll" Command="{Binding LockCommand}"/>
                                    <Button Content="↻ Read current roll" Command="{Binding ReadOnceCommand}"/>
                                    <Button Content="✕ Reset lock" Command="{Binding ResetLockCommand}"/>
                                </WrapPanel>
                                <TextBlock Text="{Binding LockInfo}" Foreground="#555" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- 2 · target -->
                        <GroupBox Header="2 · Set your target" Margin="0,8,0,0">
                            <StackPanel Margin="4">
                                <TextBlock TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,6"
                                           Text="Set a minimum for each attribute you care about, and leave the rest blank. Because you arrange the five values yourself, the roller stops as soon as SOME arrangement meets every minimum — the 'Arranged' column then shows which value to put where. The game never rolls below 10 or above 18."/>
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Attribute" Foreground="#777"/>
                                    <TextBlock Grid.Column="1" Text="Minimum (≥)" Foreground="#777"/>
                                    <TextBlock Grid.Column="2" Text="Arranged" Foreground="#777"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Targets}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center"
                                                           ToolTip="{Binding Description}"/>
                                                <TextBox Grid.Column="1" Width="60" HorizontalAlignment="Left"
                                                         Text="{Binding MinimumText, UpdateSourceTrigger=PropertyChanged}"
                                                         IsEnabled="{Binding DataContext.CanEditTargets, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding AssignedText}" VerticalAlignment="Center"
                                                           FontFamily="Consolas" Foreground="#1565C0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border BorderBrush="#DDD" BorderThickness="0,1,0,0" Margin="0,2"/>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Total" FontWeight="SemiBold" VerticalAlignment="Center"
                                               ToolTip="Minimum for the sum of the five rolled values. The possible range is 50–90 and a fair roll averages 70."/>
                                    <TextBox Grid.Column="1" Width="60" HorizontalAlignment="Left"
                                             Text="{Binding TotalMinimumText, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding CanEditTargets}"/>
                                </Grid>
                                <Button Content="🗑 Clear all targets" Command="{Binding ClearMinimumsCommand}"
                                        HorizontalAlignment="Left" Margin="0,6,0,0"
                                        ToolTip="Reset every minimum back to blank (no requirement)."/>
                                <TextBlock Text="{Binding CriteriaText}" Foreground="#1565C0" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <TextBlock Text="{Binding OddsText}" Foreground="#555" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- 3 · roll -->
                        <GroupBox Header="3 · Roll" Margin="0,8,0,0">
                            <StackPanel Margin="4">
                                <WrapPanel>
                                    <Button Content="🎲 Roll until target met" Command="{Binding StartCommand}"/>
                                    <Button Content="⏹ Stop" Command="{Binding StopCommand}"/>
                                </WrapPanel>
                                <TextBlock Text="{Binding AttemptsText}" Foreground="#555" Margin="0,6,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="Best so far: " Foreground="#555"/>
                                    <TextBlock Text="{Binding BestText}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding ArrangementText}" TextWrapping="Wrap" Foreground="#2E7D32" Margin="0,6,0,0"/>
                                <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" Foreground="#1565C0" Margin="0,6,0,0"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- 4 · write the roll outright -->
                        <GroupBox Header="4 · Or just set the roll" Margin="0,8,0,0">
                            <StackPanel Margin="4">
                                <TextBlock TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,6"
                                           Text="Writes the five values straight into the game instead of waiting for the dice. The create screen won't repaint the row of numbers it already drew, but these ARE the values it hands out as you arrange the character. Enter five numbers, or one number to use for all five; each is clamped to 3–18, the game's attribute range — wider than the 10–18 its dice actually roll, which is rather the point. (Max Attributes on the Party tab goes further once the character exists.)"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox Width="160" Text="{Binding SetValuesText, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalAlignment="Center"/>
                                    <Button Content="✍ Write these values" Command="{Binding SetRollCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <!-- 5 · statistics -->
                        <GroupBox Header="5 · Statistics" Margin="0,8,0,0">
                            <StackPanel Margin="4">
                                <TextBlock TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,4"
                                           Text="Tallies every fresh roll read this session. The five values are interchangeable, so they're grouped by rank rather than by position — this is what tells you whether a minimum is realistic."/>
                                <TextBlock Text="{Binding SamplesText}" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Rank" Foreground="#777"/>
                                    <TextBlock Grid.Column="1" Text="Average (min–max)" Foreground="#777"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Ranks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding AvgText}" VerticalAlignment="Center"
                                                           FontFamily="Consolas" Foreground="#1565C0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border BorderBrush="#DDD" BorderThickness="0,1,0,0" Margin="0,2"/>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Total" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding TotalAvgText}" VerticalAlignment="Center"
                                               FontFamily="Consolas" FontWeight="SemiBold" Foreground="#1565C0"/>
                                </Grid>
                                <Button Content="🗑 Clear statistics" Command="{Binding ClearStatsCommand}"
                                        HorizontalAlignment="Left" Margin="0,6,0,0"/>
                            </StackPanel>
                        </GroupBox>

                        <Expander Header="Advanced timing" Margin="0,8,0,0" Foreground="#555">
                            <WrapPanel Margin="0,6,0,0">
                                <StackPanel Margin="0,0,16,6">
                                    <Label Content="Max rolls"/>
                                    <TextBox Width="90" Text="{Binding MaxAttempts, UpdateSourceTrigger=LostFocus}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,16,6">
                                    <Label Content="Settle after R (ms)"/>
                                    <TextBox Width="90" Text="{Binding SettleDelayMs, UpdateSourceTrigger=LostFocus}"
                                             ToolTip="Pause after each re-roll so the game updates memory before the trainer reads it. Raise this if rolls read stale."/>
                                </StackPanel>
                                <StackPanel Margin="0,0,16,6">
                                    <Label Content="Focus pause (ms)"/>
                                    <TextBox Width="90" Text="{Binding FocusDelayMs, UpdateSourceTrigger=LostFocus}"/>
                                </StackPanel>
                            </WrapPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ======================= SAVE EDITOR ======================= -->
            <TabItem Header="Save Editor">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Content="Open DDCHARS.DAT…" Command="{Binding LoadSaveCommand}"/>
                        <Button Content="Save" Command="{Binding SaveSaveCommand}"/>
                        <Button Content="Max All &amp; Save" Command="{Binding SaveMaxAllCommand}"/>
                        <TextBlock Text="{Binding SaveFilePath}" VerticalAlignment="Center" Margin="8,0" Foreground="#555"/>
                    </StackPanel>

                    <GroupBox Grid.Row="1" Header="Saved party position" Margin="0,0,0,6"
                              Visibility="{Binding HasSaveFile, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="4">
                            <TextBlock TextWrapping="Wrap" Foreground="#555"
                                       Text="The save header carries where the party was standing. Unlike the live teleport on the Maps tab, the level is safe to change here: the game loads whichever level's map the header names when it reads this file back, so the two can never disagree. Level 0 means the party is in town. Edit with the game closed — Dark Designs rewrites this file from memory on (Q)uit and save."/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="Level" Style="{StaticResource FieldLabel}"/>
                                <TextBox Width="50" Text="{Binding SaveLevel}"/>
                                <TextBlock Text="X" Style="{StaticResource FieldLabel}" MinWidth="0"/>
                                <TextBox Width="50" Text="{Binding SaveX}"/>
                                <TextBlock Text="Y" Style="{StaticResource FieldLabel}" MinWidth="0"/>
                                <TextBox Width="50" Text="{Binding SaveY}"/>
                                <TextBlock Text="Facing" Style="{StaticResource FieldLabel}" MinWidth="0"/>
                                <TextBox Width="50" Text="{Binding SaveFacing}"/>
                                <TextBlock Text="{Binding SavePositionText}" Style="{StaticResource FieldLabel}"
                                           MinWidth="0" Foreground="#555"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Grid.Row="2" Header="Characters in DDCHARS.DAT">
                        <Grid Margin="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <ListBox Grid.Column="0"
                                     ItemsSource="{Binding SaveCharacters}"
                                     SelectedItem="{Binding SelectedSaveCharacter}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <GroupBox Grid.Column="1" Header="Edit Character" Margin="6,0,0,0"
                                      DataContext="{Binding SelectedSaveCharacter}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="6">
                                        <TextBlock Text="{Binding}" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="120"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition/>
                                                <RowDefinition/>
                                                <RowDefinition/>
                                                <RowDefinition/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" Style="{StaticResource FieldLabel}"/>
                                            <TextBox   Grid.Row="0" Grid.Column="1" Text="{Binding Name}" LostFocus="SaveField_LostFocus"/>
                                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Class" Style="{StaticResource FieldLabel}"/>
                                            <TextBox   Grid.Row="0" Grid.Column="3" Text="{Binding Class}" LostFocus="SaveField_LostFocus"/>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Level" Style="{StaticResource FieldLabel}"/>
                                            <TextBox   Grid.Row="1" Grid.Column="1" Text="{Binding Level}" LostFocus="SaveField_LostFocus"/>
                                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Experience" Style="{StaticResource FieldLabel}"/>
                                            <TextBox   Grid.Row="1" Grid.Column="3" Text="{Binding Experience}" LostFocus="SaveField_LostFocus"/>

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Gold" Style="{StaticResource FieldLabel}"/>
                                            <TextBox   Grid.Row="2" Grid.Column="1" Text="{Binding Gold}" LostFocus="SaveField_LostFocus"/>
                                            <TextBlock Grid.Row="2" Grid.Column="2" Text="Status" Style="{StaticResource FieldLabel}"/>
                                            <TextBox   Grid.Row="2" Grid.Column="3" Text="{Binding Status}" LostFocus="SaveField_LostFocus"/>

                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Body Cur" Style="{StaticResource FieldLabel}"/>
                                            <TextBox   Grid.Row="3" Grid.Column="1" Text="{Binding BodyCurrent}" LostFocus="SaveField_LostFocus"/>
                                            <TextBlock Grid.Row="3" Grid.Column="2" Text="Body Max" Style="{StaticResource FieldLabel}"/>
                                            <TextBox   Grid.Row="3" Grid.Column="3" Text="{Binding BodyMax}" LostFocus="SaveField_LostFocus"/>
                                        </Grid>

                                        <GroupBox Header="Attributes" Margin="0,8,0,0">
                                            <WrapPanel>
                                                <StackPanel Orientation="Horizontal" Margin="4">
                                                    <TextBlock Text="STR" Width="40" VerticalAlignment="Center"/>
                                                    <TextBox Width="60" Text="{Binding Strength}" LostFocus="SaveField_LostFocus"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="4">
                                                    <TextBlock Text="DEX" Width="40" VerticalAlignment="Center"/>
                                                    <TextBox Width="60" Text="{Binding Dexterity}" LostFocus="SaveField_LostFocus"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="4">
                                                    <TextBlock Text="CON" Width="40" VerticalAlignment="Center"/>
                                                    <TextBox Width="60" Text="{Binding Constitution}" LostFocus="SaveField_LostFocus"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="4">
                                                    <TextBlock Text="INT" Width="40" VerticalAlignment="Center"/>
                                                    <TextBox Width="60" Text="{Binding Intelligence}" LostFocus="SaveField_LostFocus"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="4">
                                                    <TextBlock Text="PIE" Width="40" VerticalAlignment="Center"/>
                                                    <TextBox Width="60" Text="{Binding Piety}" LostFocus="SaveField_LostFocus"/>
                                                </StackPanel>
                                            </WrapPanel>
                                        </GroupBox>

                                        <GroupBox Header="Readied equipment" Margin="0,8,0,0">
                                            <ItemsControl ItemsSource="{Binding DataContext.SaveEquipment, RelativeSource={RelativeSource AncestorType=Window}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="90"/>
                                                                <ColumnDefinition Width="180"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center"/>
                                                            <ComboBox Grid.Column="1" Margin="2"
                                                                      ItemsSource="{Binding Options}"
                                                                      SelectedItem="{Binding Selected}"
                                                                      DisplayMemberPath="Name"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding Detail}"
                                                                       Foreground="#666" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </GroupBox>

                                        <GroupBox Header="Carried pack (item screen keys A–J)" Margin="0,8,0,0">
                                            <ItemsControl ItemsSource="{Binding DataContext.SaveInventory, RelativeSource={RelativeSource AncestorType=Window}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="90"/>
                                                                <ColumnDefinition Width="180"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center"/>
                                                            <ComboBox Grid.Column="1" Margin="2"
                                                                      ItemsSource="{Binding Options}"
                                                                      SelectedItem="{Binding Selected}"
                                                                      DisplayMemberPath="Name"/>
                                                            <!-- No Click handler: SaveField_LostFocus rebuilds SaveInventory,
                                                                 which would tear this button out of the tree before WPF got
                                                                 round to running its Command. SavePack.TryAddItem already
                                                                 marks the file modified and refreshes the slots. -->
                                                            <Button Grid.Column="2" Content="Duplicate" Margin="2,2,8,2"
                                                                    Padding="6,1" Command="{Binding DuplicateCommand}"
                                                                    ToolTip="Copy this item into the first free pack slot"/>
                                                            <TextBlock Grid.Column="3" Text="{Binding Detail}"
                                                                       Foreground="#666" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </GroupBox>

                                        <TextBlock Margin="0,8,0,0" Foreground="#555" TextWrapping="Wrap"
                                                   Text="Changes are saved when you click Save. A .bak backup is taken before the first write. Edit the save with the game closed — Dark Designs rewrites DDCHARS.DAT from memory when you (Q)uit and save."/>
                                    </StackPanel>
                                </ScrollViewer>
                            </GroupBox>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- ======================= REFERENCES ======================= -->
            <TabItem Header="References">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <GroupBox Grid.Column="0" Header="Spells">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="4">
                            <StackPanel>
                                <TextBlock Text="Wizard Spells" Style="{StaticResource RefHeader}"/>
                                <ItemsControl ItemsSource="{Binding Reference.WizardSpells}"/>
                                <TextBlock Text="Priest Spells" Style="{StaticResource RefHeader}"/>
                                <ItemsControl ItemsSource="{Binding Reference.PriestSpells}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </GroupBox>

                    <GroupBox Grid.Column="1" Header="Items" Margin="6,0,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="4">
                            <ItemsControl ItemsSource="{Binding Reference.Items}" FontFamily="Consolas"/>
                        </ScrollViewer>
                    </GroupBox>

                    <GroupBox Grid.Column="2" Header="Monsters" Margin="6,0,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="4">
                            <ItemsControl ItemsSource="{Binding Reference.Monsters}" FontFamily="Consolas"/>
                        </ScrollViewer>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- ======================= MAPS ======================= -->
            <TabItem Header="🗺 Maps">
                <Grid Margin="6" DataContext="{Binding Maps}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Level picker + the level's own room list -->
                    <GroupBox Grid.Column="0" Header="Places on this level">
                        <DockPanel>
                            <ComboBox DockPanel.Dock="Top" Margin="2"
                                      ItemsSource="{Binding Levels}" SelectedItem="{Binding SelectedLevel}"
                                      DisplayMemberPath="Header"/>
                            <TextBlock DockPanel.Dock="Top" Margin="4,2" Foreground="#666" TextWrapping="Wrap"
                                       Text="Room names and descriptions come out of the level's own map file, so they are the game's words, not a walkthrough's. Click one to aim the teleport at it."/>
                            <ListBox ItemsSource="{Binding Rooms}" SelectedItem="{Binding SelectedRoom}"
                                     HorizontalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Coord}" Width="62" Foreground="#777"/>
                                                <TextBlock Text="{Binding Header}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                                       Foreground="#666" Margin="62,0,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </GroupBox>

                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="6,0,0,0">
                        <StackPanel>
                            <GroupBox Header="Where the party is">
                                <StackPanel Margin="4">
                                    <TextBlock TextWrapping="Wrap" Foreground="#555"
                                               Text="The party's level, square and facing are four values in the game's data segment, and the level it is walking around is a 12,648-byte buffer a little further on. Attach and scan on the Party tab first, then click Locate: the roster the scan found pins both, and the map bytes behind them are checked before anything is believed. Nothing works until the party is inside Grelminar's castle — in town there is no level loaded to recognise."/>
                                    <WrapPanel Margin="0,6,0,0">
                                        <Button Content="Locate the party" Command="{Binding LocateCommand}"/>
                                        <TextBlock Text="{Binding LocateState}" Foreground="#777"
                                                   VerticalAlignment="Center" Margin="8,0,0,0" TextWrapping="Wrap"/>
                                    </WrapPanel>
                                    <TextBlock Text="{Binding PositionText}" FontWeight="Bold" FontSize="13" Margin="2,6,0,0"/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Map" Margin="0,8,0,0">
                                <StackPanel Margin="4">
                                    <TextBlock TextWrapping="Wrap" Foreground="#555"
                                               Text="X runs east across the level and Y runs south down it, matching the game — the castle entrance is (16, 31) on the Ground Level, at the bottom. Grey edges are walls (an undiscovered secret door draws as one, exactly as the game shows it); amber edges are doors, locked or not. Green squares are stairs up, blue stairs down, amber chests, purple the two fixed items, red the ledges you fall off. A green tint marks squares the party has already mapped. Click any square to aim the teleport at it."/>
                                    <WrapPanel Margin="0,6,0,0">
                                        <Button Content="Load game folder…" Command="{Binding LoadFolderCommand}"
                                                ToolTip="Point at the folder holding DDMAP1.DAT … DDMAP5.DAT to browse every level, not just the one the party is on."/>
                                        <Button Content="Reveal whole level" Command="{Binding RevealCommand}"
                                                ToolTip="Marks every square on the current level as mapped, which is what the game's own automap draws from. The game keeps it and writes it into that level's DDMAP file when it next saves — the same thing walking everywhere would do."/>
                                        <TextBlock Text="{Binding FolderStatus}" Foreground="#777"
                                                   VerticalAlignment="Center" Margin="8,0,0,0" TextWrapping="Wrap"/>
                                    </WrapPanel>
                                    <TextBlock Text="{Binding MapSource}" Foreground="#777" Margin="2,6,0,0" TextWrapping="Wrap"/>

                                    <!-- 32 squares at 18px plus the border: sized so a whole level
                                         fits without scrolling, and scrolls anyway on a short window. -->
                                    <ScrollViewer MaxHeight="580" Margin="0,6,0,0"
                                                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                        <!-- The border wraps the grid rather than being sized with it, so
                                             the 32 cells get their full 576px and Map_Click's coordinates,
                                             taken relative to the Grid, line up with what is drawn. -->
                                        <Border BorderBrush="#CCC" BorderThickness="1" Background="#FBFBF5"
                                                HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <Grid MouseLeftButtonDown="Map_Click" Background="Transparent"
                                                  ClipToBounds="True"
                                                  Width="{Binding GridSize, Converter={StaticResource MapScale}}"
                                                  Height="{Binding GridSize, Converter={StaticResource MapScale}}">
                                                <Rectangle>
                                                    <Rectangle.Fill>
                                                        <DrawingBrush TileMode="Tile" Viewport="0,0,18,18" ViewportUnits="Absolute">
                                                            <DrawingBrush.Drawing>
                                                                <GeometryDrawing Geometry="M0,0 L18,0 18,18 0,18 Z">
                                                                    <GeometryDrawing.Pen>
                                                                        <Pen Brush="#E8E8DC" Thickness="1"/>
                                                                    </GeometryDrawing.Pen>
                                                                </GeometryDrawing>
                                                            </DrawingBrush.Drawing>
                                                        </DrawingBrush>
                                                    </Rectangle.Fill>
                                                </Rectangle>

                                                <ItemsControl ItemsSource="{Binding Squares}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <Canvas/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemContainerStyle>
                                                        <Style TargetType="ContentPresenter">
                                                            <Setter Property="Canvas.Left" Value="{Binding X, Converter={StaticResource MapScale}}"/>
                                                            <Setter Property="Canvas.Top" Value="{Binding Y, Converter={StaticResource MapScale}}"/>
                                                        </Style>
                                                    </ItemsControl.ItemContainerStyle>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Width="18" Height="18" Background="Transparent">
                                                                <Grid.ToolTip>
                                                                    <StackPanel MaxWidth="280">
                                                                        <TextBlock FontWeight="Bold">
                                                                            <Run Text="{Binding Coord, Mode=OneWay}"/>
                                                                            <Run Text="  "/>
                                                                            <Run Text="{Binding RoomName, Mode=OneWay}"/>
                                                                        </TextBlock>
                                                                    </StackPanel>
                                                                </Grid.ToolTip>
                                                                <Rectangle Fill="{Binding Visited, Converter={StaticResource VisitedBrush}}"/>
                                                                <Rectangle Margin="3" Fill="{Binding Kind, Converter={StaticResource SquareBrush}}"/>
                                                                <Rectangle Width="2" HorizontalAlignment="Left"
                                                                           Fill="{Binding West, Converter={StaticResource WallBrush}}"/>
                                                                <Rectangle Width="2" HorizontalAlignment="Right"
                                                                           Fill="{Binding East, Converter={StaticResource WallBrush}}"/>
                                                                <Rectangle Height="2" VerticalAlignment="Top"
                                                                           Fill="{Binding North, Converter={StaticResource WallBrush}}"/>
                                                                <Rectangle Height="2" VerticalAlignment="Bottom"
                                                                           Fill="{Binding South, Converter={StaticResource WallBrush}}"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <!-- Teleport target -->
                                                <Canvas>
                                                    <Border Width="18" Height="18" BorderBrush="#2E86DE" BorderThickness="2"
                                                            Canvas.Left="{Binding TargetX, Converter={StaticResource MapScale}}"
                                                            Canvas.Top="{Binding TargetY, Converter={StaticResource MapScale}}"/>
                                                </Canvas>

                                                <!-- Live party marker, pointing the way it faces -->
                                                <Canvas>
                                                    <Grid Width="18" Height="18" ToolTip="The party's live position"
                                                          Visibility="{Binding ShowLiveMarker, Converter={StaticResource BoolToVis}}"
                                                          Canvas.Left="{Binding LiveX, Converter={StaticResource MapScale}}"
                                                          Canvas.Top="{Binding LiveY, Converter={StaticResource MapScale}}">
                                                        <Path Fill="#27AE60" Stroke="White" StrokeThickness="1"
                                                              Data="M9,2 L15,15 L9,12 L3,15 Z"
                                                              RenderTransformOrigin="0.5,0.5">
                                                            <Path.RenderTransform>
                                                                <RotateTransform Angle="{Binding Position.Facing, Converter={StaticResource FacingAngle}}"/>
                                                            </Path.RenderTransform>
                                                        </Path>
                                                    </Grid>
                                                </Canvas>
                                            </Grid>
                                        </Border>
                                    </ScrollViewer>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Teleport" Margin="0,8,0,0">
                                <StackPanel Margin="4">
                                    <TextBlock TextWrapping="Wrap" Foreground="#555"
                                               Text="Click a square or a place on the left, then Teleport. This only moves the party around the level it is already on: the game loads a level's map when you take its stairs, so moving the level number alone would leave you walking a different map than the one on screen. To change level, teleport onto a stairway and take a step — or edit the saved position in DDCHARS.DAT on the Save Editor tab, where the level is safe to change because the game loads the matching map when it reads the file back. Do it while exploring, not mid-fight."/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="Target X" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Width="60" Text="{Binding TargetX}"/>
                                        <TextBlock Text="Y" Style="{StaticResource FieldLabel}" MinWidth="0"/>
                                        <TextBox Width="60" Text="{Binding TargetY}"/>
                                        <TextBlock Text="Facing" Style="{StaticResource FieldLabel}" MinWidth="0"/>
                                        <ComboBox Width="90" Margin="2" ItemsSource="{Binding Facings}"
                                                  SelectedIndex="{Binding TargetFacing}"/>
                                        <Button Content="Teleport" Command="{Binding TeleportCommand}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding TargetDescription}" Foreground="#555" Margin="4,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
