<Window x:Class="TheQuestTrainer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TheQuestTrainer.ViewModels"
        Title="The Quest — Trainer"
        Height="820" Width="1120" MinHeight="600" MinWidth="880"
        Background="{StaticResource Parchment}"
        FontFamily="Segoe UI" FontSize="12">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <DockPanel Margin="10">

        <!-- attach bar -->
        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Rule}" BorderThickness="0,0,0,1" Padding="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Process" Margin="0,0,8,0" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding Processes}" SelectedItem="{Binding SelectedProcess}"
                          DisplayMemberPath="Display" Margin="0,0,8,0" MinWidth="260" />
                <Button Grid.Column="2" Content="Refresh" Command="{Binding RefreshProcessesCommand}" />
                <Button Grid.Column="3" Content="Attach" Command="{Binding AttachCommand}" />
                <Button Grid.Column="4" Content="Detach" Command="{Binding DetachCommand}" />
                <CheckBox Grid.Column="5" Content="Read-only" IsChecked="{Binding IsReadOnly}"
                          VerticalAlignment="Center" Margin="8,0,0,0"
                          ToolTip="Safety catch. When ticked, every write is refused and all freezes are released." />
            </Grid>
        </Border>

        <!-- status bar -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Rule}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
            <StackPanel>
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Style="{StaticResource Caption}" Text="Record " />
                    <TextBlock Style="{StaticResource Caption}" Text="{Binding RecordAddress}" />
                    <TextBlock Style="{StaticResource Caption}" Text="   " />
                    <TextBlock Style="{StaticResource Caption}" Text="{Binding BuildNote}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <TabControl Margin="0,8,0,8" Background="Transparent" BorderBrush="{StaticResource Rule}">

            <!-- ======================= Character ======================= -->
            <TabItem Header="Character">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                    <StackPanel>

                        <GroupBox Header="Who">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition /><RowDefinition /><RowDefinition />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" Margin="0,2,12,2" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CharacterName}" FontWeight="SemiBold" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Race" Margin="0,2,12,2" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RaceName}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Portrait" Margin="0,2,12,2" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PortraitId}" Style="{StaticResource Caption}" />
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Vitals">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Health" />
                                    <TextBox   Grid.Row="0" Grid.Column="1" Margin="0,2"
                                               IsEnabled="{Binding CanEdit}"
                                               Text="{Binding Health, UpdateSourceTrigger=LostFocus, Mode=TwoWay}" />
                                    <CheckBox  Grid.Row="0" Grid.Column="2" Content="Freeze" Margin="8,0,0,0"
                                               VerticalAlignment="Center" IsChecked="{Binding FreezeHealth}" />
                                    <TextBlock Grid.Row="0" Grid.Column="3" Style="{StaticResource Caption}" Margin="12,0,0,0"
                                               Text="The maximum is derived from Endurance and level and is not stored; the game will show, say, 500/72 quite happily." />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Mana" />
                                    <TextBox   Grid.Row="1" Grid.Column="1" Margin="0,2"
                                               IsEnabled="{Binding CanEdit}"
                                               Text="{Binding Mana, UpdateSourceTrigger=LostFocus, Mode=TwoWay}" />
                                    <CheckBox  Grid.Row="1" Grid.Column="2" Content="Freeze" Margin="8,0,0,0"
                                               VerticalAlignment="Center" IsChecked="{Binding FreezeMana}" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Gold" />
                                    <TextBox   Grid.Row="2" Grid.Column="1" Margin="0,2"
                                               IsEnabled="{Binding CanEdit}"
                                               Text="{Binding Gold, UpdateSourceTrigger=LostFocus, Mode=TwoWay}" />
                                    <CheckBox  Grid.Row="2" Grid.Column="2" Content="Freeze" Margin="8,0,0,0"
                                               VerticalAlignment="Center" IsChecked="{Binding FreezeGold}" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Crime" />
                                    <TextBox   Grid.Row="3" Grid.Column="1" Margin="0,2"
                                               IsEnabled="{Binding CanEdit}"
                                               Text="{Binding Crime, UpdateSourceTrigger=LostFocus, Mode=TwoWay}" />
                                    <CheckBox  Grid.Row="3" Grid.Column="2" Content="Freeze" Margin="8,0,0,0"
                                               VerticalAlignment="Center" IsChecked="{Binding FreezeCrime}" />
                                    <StackPanel Grid.Row="3" Grid.Column="3" Orientation="Horizontal" Margin="12,0,0,0">
                                        <Button Content="Clear crime" Command="{Binding ClearCrimeCommand}" />
                                        <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center"
                                                   Text="Outstanding bounty. Zero it and the guards have nothing to collect." />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Conditions">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition /><RowDefinition />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Adverse" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                                           Text="{Binding ConditionSummary}" FontWeight="SemiBold" TextWrapping="Wrap" />

                                <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                            Orientation="Horizontal" Margin="0,6,0,0">
                                    <Button Content="Cure" Command="{Binding CureConditionsCommand}" MinWidth="80"
                                            ToolTip="Removes poison, disease, curse and paralysis — exactly what the game's own cures remove, and nothing else." />
                                    <CheckBox Content="Keep clear" Margin="8,0,0,0" VerticalAlignment="Center"
                                              IsChecked="{Binding FreezeConditions}"
                                              ToolTip="Re-runs the cure four times a second." />
                                    <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0"
                                               MaxWidth="560" TextWrapping="Wrap"
                                               Text="Poison, disease, curse and paralysis are the four the game names. Keep clear is a cure on repeat rather than an immunity: the game still inflicts a condition and the trainer takes it away on the next tick, so a poison costs its first turn of health. An effect from a worn item or from your race is not an affliction and is left alone." />
                                </StackPanel>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Progress">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Level" />
                                <TextBox   Grid.Row="0" Grid.Column="1" Margin="0,2"
                                           IsEnabled="{Binding CanEdit}"
                                           Text="{Binding Level, UpdateSourceTrigger=LostFocus, Mode=TwoWay}" />
                                <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0">
                                    <Button Content="Level up" Command="{Binding LevelUpCommand}" />
                                    <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center"
                                               Text="Setting the level also raises experience to match and rewrites the cached next-level threshold." />
                                </StackPanel>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Experience" />
                                <TextBox   Grid.Row="1" Grid.Column="1" Margin="0,2"
                                           IsEnabled="{Binding CanEdit}"
                                           Text="{Binding Experience, UpdateSourceTrigger=LostFocus, Mode=TwoWay}" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Caption}" Margin="12,0,0,0"
                                           Text="Experience alone does not level you up — the game applies levels when it next awards experience. Use Level for that." />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Next level at" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ExperienceForNextLevel, StringFormat={}{0:N0}}" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Attribute points" />
                                <TextBox   Grid.Row="3" Grid.Column="1" Margin="0,2"
                                           IsEnabled="{Binding CanEdit}"
                                           Text="{Binding AttributePoints, UpdateSourceTrigger=LostFocus, Mode=TwoWay}" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Skill points" />
                                <TextBox   Grid.Row="4" Grid.Column="1" Margin="0,2"
                                           IsEnabled="{Binding CanEdit}"
                                           Text="{Binding SkillPoints, UpdateSourceTrigger=LostFocus, Mode=TwoWay}" />
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Standing">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Fame" />
                                <TextBox   Grid.Column="1" Margin="0,2"
                                           IsEnabled="{Binding CanEdit}"
                                           Text="{Binding Fame, UpdateSourceTrigger=LostFocus, Mode=TwoWay}" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0">
                                    <TextBlock Text="{Binding FameBand}" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="8,0,0,0"
                                               Text="-100 Demonic … 0 Neutral … +100 Saint." />
                                </StackPanel>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Attributes">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding Attributes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Label}" />
                                                <TextBox   Grid.Column="1"
                                                           IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           Text="{Binding Value, UpdateSourceTrigger=LostFocus, Mode=TwoWay}" />
                                                <TextBlock Grid.Column="2" Margin="12,0,0,0"
                                                           Style="{StaticResource Caption}" Text="{Binding Description}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                                           Text="These are base values. What the game's status screen shows is this plus racial and item modifiers — a Derth reads five lower in Strength, Dexterity and Endurance and ten higher in Intelligence." />
                            </StackPanel>
                        </GroupBox>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ======================= Skills ======================= -->
            <TabItem Header="Skills">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Max skills" Command="{Binding MaxSkillsCommand}" MinWidth="100" />
                        <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" MaxWidth="700"
                                   Text="Raises every skill to the game's own ceiling — twice the base value of its governing attribute — and never lowers one that is already higher. The two race-locked schools are left alone." />
                    </StackPanel>

                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Caption}" Margin="0,8,0,0"
                               Text="Base values. The skills screen adds racial and equipment bonuses on top, so a Derth's Attack Magic reads ten higher there than here. 'Started' is the value the character was created with; the game keeps it and the trainer never writes it." />

                    <DataGrid ItemsSource="{Binding Skills}" AutoGenerateColumns="False" CanUserAddRows="False"
                              CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              Background="{StaticResource PanelFill}" RowBackground="{StaticResource PanelFill}"
                              AlternatingRowBackground="{StaticResource Parchment}"
                              IsEnabled="{Binding CanEdit}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Skill" Binding="{Binding Label}" IsReadOnly="True" Width="150" />
                            <DataGridTextColumn Header="Base" Binding="{Binding Value, UpdateSourceTrigger=LostFocus}" Width="70" />
                            <DataGridTextColumn Header="Started" Binding="{Binding Starting}" IsReadOnly="True" Width="70" />
                            <DataGridTextColumn Header="Governed by" Binding="{Binding GoverningAttributeName}" IsReadOnly="True" Width="110" />
                            <DataGridTextColumn Header="Cap" Binding="{Binding Note}" IsReadOnly="True" Width="90" />
                            <DataGridTextColumn Header="Effect" Binding="{Binding Description}" IsReadOnly="True" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ======================= Inventory ======================= -->
            <TabItem Header="Inventory">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Restore all" Command="{Binding RestoreAllItemsCommand}" MinWidth="100"
                                ToolTip="Repairs every worn item, recharges every wand and refills every quiver." />
                        <Button Content="Restore" Command="{Binding RestoreItemCommand}" MinWidth="80" Margin="6,0,0,0"
                                ToolTip="Does the same to the selected item only." />
                        <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" MaxWidth="640" Margin="8,0,0,0"
                                   Text="An item's name, weight and damage all belong to its shared type; the only thing the trainer writes on an item itself is the one word holding its condition, its wand charges or its ammunition count." />
                    </StackPanel>

                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Caption}" Margin="0,8,0,0"
                               Text="The trainer shows what is equipped but does not move it — the equipment slots hold raw pointers and the game rebuilds what it draws from them, so equipping is left to the game's own inventory screen. Replacing works on an item you are not wearing." />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="360" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="320" />
                        </Grid.ColumnDefinitions>

                        <DockPanel Grid.Column="0">
                            <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Caption}" Margin="0,6,0,0"
                                       Text="{Binding InventoryNote}" />
                            <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single"
                                      Background="{StaticResource PanelFill}" RowBackground="{StaticResource PanelFill}"
                                      AlternatingRowBackground="{StaticResource Parchment}"
                                      IsEnabled="{Binding IsAttached}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Item" Binding="{Binding Name}" IsReadOnly="True" Width="170" />
                                    <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" IsReadOnly="True" Width="150" />
                                    <DataGridTextColumn Header="Wgt" Binding="{Binding Weight}" IsReadOnly="True" Width="50" />
                                    <DataGridTextColumn Header="Dmg" Binding="{Binding Damage}" IsReadOnly="True" Width="60" />
                                    <DataGridTextColumn Header="Value" Width="70"
                                                        Binding="{Binding Meter, UpdateSourceTrigger=LostFocus}" />
                                    <DataGridTextColumn Header="Condition / charges" Binding="{Binding MeterLabel}" IsReadOnly="True" Width="*" />
                                    <DataGridTextColumn Header="Worn" Binding="{Binding EquippedLabel}" IsReadOnly="True" Width="70" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>

                        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" />

                        <GroupBox Grid.Column="2" Header="Replace with">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,6"
                                           Text="Points the selected item at another of the game's item types. The trainer cannot add an item — that would mean allocating in the game's heap — so this turns something you already carry into something else, in mint condition." />
                                <TextBox DockPanel.Dock="Top" Text="{Binding CatalogFilter, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,0,6" ToolTip="Filters by name or by the game's internal id." />
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                                    <Button Content="Replace" Command="{Binding ReplaceItemCommand}" MinWidth="90" />
                                    <Button Content="Rescan" Command="{Binding ScanCatalogCommand}" MinWidth="70" Margin="6,0,0,0"
                                            ToolTip="Sweeps the game's heap for item types again. Worth doing after the game loads an area it had not visited." />
                                </StackPanel>
                                <ListBox ItemsSource="{Binding CatalogView}" SelectedItem="{Binding SelectedCatalogEntry}"
                                         DisplayMemberPath="PickerLabel" Background="{StaticResource PanelFill}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         VirtualizingPanel.IsVirtualizing="True" />
                            </DockPanel>
                        </GroupBox>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- ======================= Map ======================= -->
            <TabItem Header="Map">
                <DockPanel Margin="8" DataContext="{Binding Map}">

                    <!-- where you are, and where Teleport would put you -->
                    <GroupBox DockPanel.Dock="Top" Header="Where you are">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="Auto" MinWidth="220" />
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="Auto" MinWidth="150" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition /><RowDefinition /><RowDefinition />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="World" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding WorldName}" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Facing" />
                                <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding HeadingLabel}" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Map" />
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock Text="{Binding MapName}" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="8,0,0,0" Text="{Binding MapId}" />
                                </StackPanel>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="Cell" />
                                <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding CellLabel}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Tile" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TileLabel}" />
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="World tile" />
                                <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding GlobalLabel}" />
                            </Grid>

                            <TextBlock Grid.Column="1" Style="{StaticResource Caption}" Margin="16,0,8,0"
                                       VerticalAlignment="Top" Text="{Binding MapNote}" />

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                <TextBlock Text="X" Margin="0,0,4,0" />
                                <TextBox Width="52" MinWidth="52"
                                         IsEnabled="{Binding CanTeleport}"
                                         Text="{Binding TargetX, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                                <TextBlock Text="Y" Margin="8,0,4,0" />
                                <TextBox Width="52" MinWidth="52" Margin="0,0,6,0"
                                         IsEnabled="{Binding CanTeleport}"
                                         Text="{Binding TargetY, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                                <Button Content="Teleport" Command="{Binding TeleportCommand}" MinWidth="84"
                                        ToolTip="Moves you to that tile of the map you are on. The camera and the automap follow at once — there is no step to take afterwards." />
                                <Button Content="Here" Command="{Binding HereCommand}" MinWidth="52"
                                        ToolTip="Puts the target back on the tile you are standing on." />
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Caption}" Margin="0,8,0,0"
                               Text="Teleport moves you within the map you are on and nowhere else. Outdoors the engine keeps this map and its eight neighbours in one grid, so a coordinate past the edge would drop you on a real tile of the next map while the game went on believing you had not left this one — the automap, the world position and everything loaded around you would all be wrong. Walk across the boundary instead. The world map picture is read from your own copy of the game; the trainer ships none of it." />

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" MinHeight="200" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="170" MinHeight="110" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="260" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="320" MinWidth="260" />
                        </Grid.ColumnDefinitions>

                        <!-- the world, as the game draws it -->
                        <GroupBox Grid.Row="0" Grid.Column="0" Header="This world">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                                    <Button DockPanel.Dock="Right" Content="Rescan" MinWidth="70" Margin="6,0,0,0"
                                            Command="{Binding DataContext.ScanMapsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            ToolTip="Re-reads the world's map list and its map picture. Worth doing after walking into an expansion's world." />
                                    <TextBlock Style="{StaticResource Caption}" Text="{Binding PictureNote}" />
                                </DockPanel>
                                <Border BorderBrush="{StaticResource Rule}" BorderThickness="1"
                                        Visibility="{Binding HasPicture, Converter={StaticResource BoolToVisible}}">
                                    <Viewbox Stretch="Uniform" StretchDirection="Both">
                                        <Grid Width="{Binding PictureWidth}" Height="{Binding PictureHeight}">
                                            <Image Source="{Binding PictureSource}" Stretch="Fill"
                                                   RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                            <Canvas>
                                                <Rectangle Canvas.Left="{Binding SelectedBoxX}" Canvas.Top="{Binding SelectedBoxY}"
                                                           Width="{Binding CellBoxSize}" Height="{Binding CellBoxSize}"
                                                           Stroke="#FFEFD27A" StrokeThickness="2"
                                                           Visibility="{Binding SelectedOnPicture, Converter={StaticResource BoolToVisible}}" />
                                                <Rectangle Canvas.Left="{Binding HereBoxX}" Canvas.Top="{Binding HereBoxY}"
                                                           Width="{Binding CellBoxSize}" Height="{Binding CellBoxSize}"
                                                           Stroke="#FF7A2E1E" StrokeThickness="2"
                                                           Visibility="{Binding PlayerOnPicture, Converter={StaticResource BoolToVisible}}" />
                                                <Ellipse Canvas.Left="{Binding PlayerPixelX}" Canvas.Top="{Binding PlayerPixelY}"
                                                         Width="{Binding MarkerSize}" Height="{Binding MarkerSize}"
                                                         Fill="#FFE23B2E" Stroke="White" StrokeThickness="1"
                                                         Visibility="{Binding PlayerOnPicture, Converter={StaticResource BoolToVisible}}" />
                                            </Canvas>
                                        </Grid>
                                    </Viewbox>
                                </Border>
                            </DockPanel>
                        </GroupBox>

                        <GridSplitter Grid.Row="0" Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" />

                        <!-- the map you are on, tile by tile -->
                        <GroupBox Grid.Row="0" Grid.Column="2" Header="This map">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Caption}" Margin="0,6,0,0" MaxWidth="300"
                                               Text="Click a square to aim the teleport at it. Red is you; the outlined square is the target. Outdoor squares are tinted from the world map picture." />
                                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                                        <ItemsControl ItemsSource="{Binding Tiles}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="{Binding DataContext.TileColumns, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                 Rows="{Binding DataContext.TileRows, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Width="13" Height="13" Padding="0" Margin="0" MinWidth="0"
                                                            Background="{Binding Fill}" ToolTip="{Binding Label}"
                                                            Command="{Binding DataContext.SelectTileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Grid>
                                                                    <Rectangle Fill="{TemplateBinding Background}" />
                                                                    <Rectangle Stroke="#40000000" StrokeThickness="0.4" />
                                                                    <Rectangle x:Name="Target" Stroke="#FF1B3A6B" StrokeThickness="2" Visibility="Collapsed" />
                                                                    <Ellipse x:Name="Player" Margin="2" Fill="#FFE23B2E" Visibility="Collapsed" />
                                                                </Grid>
                                                                <ControlTemplate.Triggers>
                                                                    <DataTrigger Binding="{Binding IsTarget}" Value="True">
                                                                        <Setter TargetName="Target" Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsPlayer}" Value="True">
                                                                        <Setter TargetName="Player" Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Viewbox>
                                </DockPanel>
                        </GroupBox>

                        <GridSplitter Grid.Row="1" Grid.ColumnSpan="3" Height="6" HorizontalAlignment="Stretch"
                                      VerticalAlignment="Center" Background="Transparent" />

                        <!-- every map the world holds -->
                        <GroupBox Grid.Row="2" Grid.ColumnSpan="3" Header="Every map in this world" Margin="0">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" Margin="8,0,0,0"
                                               Text="{Binding AtlasNote}" />
                                    <TextBox Text="{Binding AtlasFilter, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Filters by name or by the game's internal id." />
                                </DockPanel>
                                <DataGrid ItemsSource="{Binding AtlasView}" SelectedItem="{Binding SelectedMap}"
                                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single"
                                          Background="{StaticResource PanelFill}" RowBackground="{StaticResource PanelFill}"
                                          AlternatingRowBackground="{StaticResource Parchment}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Map" Binding="{Binding Name}" Width="260" />
                                        <DataGridTextColumn Header="Cell" Binding="{Binding CellLabel}" Width="70" />
                                        <DataGridTextColumn Header="Size" Binding="{Binding SizeLabel}" Width="70" />
                                        <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="150" />
                                        <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </GroupBox>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- ======================= Reference ======================= -->
            <!-- ======================= Cluebook ======================= -->
            <TabItem Header="Cluebook">
                <DockPanel Margin="8" DataContext="{Binding Book}" IsEnabled="{Binding IsIdle}">

                    <GroupBox DockPanel.Dock="Top" Header="Where the game is installed">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Game folder" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Grid.Column="1" Text="{Binding GameFolder, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalAlignment="Center"
                                         ToolTip="The folder holding TheQuest.exe, data.pak and expansions\. Filled in from the game when you attach." />
                                <Button Grid.Column="2" Content="Browse…" Click="BrowseGameFolder" Margin="8,0,0,0" />
                                <Button Grid.Column="3" Content="Find adventures" Command="{Binding FindCommand}" Margin="4,0,0,0" />
                            </Grid>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Text="The base game and every downloadable adventure ship one world each, inside their own .pak. Nothing here touches the running game: the cluebook is read from the files on disk, so it works whether or not the trainer is attached." />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox DockPanel.Dock="Bottom" Header="Write">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Write to" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Grid.Column="1" Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalAlignment="Center" />
                                <Button Grid.Column="2" Content="Browse…" Click="BrowseOutputFolder" Margin="8,0,0,0" />
                                <Button Grid.Column="3" Content="Write cluebooks" Command="{Binding WriteCommand}" Margin="4,0,0,0" />
                                <Button Grid.Column="4" Content="Open folder" Command="{Binding OpenOutputCommand}" Margin="4,0,0,0" />
                            </Grid>

                            <WrapPanel Margin="0,8,0,0">
                                <CheckBox Content="Conversations" IsChecked="{Binding IncludeConversations}" Margin="0,0,16,0"
                                          ToolTip="Every topic each person will discuss, and every reply. This is most of the document." />
                                <CheckBox Content="Item catalogue" IsChecked="{Binding IncludeItems}" Margin="0,0,16,0"
                                          ToolTip="Every item type with its value, weight, damage, armour and condition." />
                                <CheckBox Content="Bestiary and rules" IsChecked="{Binding IncludeReference}" Margin="0,0,16,0"
                                          ToolTip="Spells, monsters, kinds of person, races, skills and attributes." />
                                <CheckBox Content="Empty maps" IsChecked="{Binding IncludeEmptyMaps}"
                                          ToolTip="Give a chapter even to maps with nothing placed on them. Mostly open sea." />
                            </WrapPanel>

                            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </GroupBox>

                    <DataGrid ItemsSource="{Binding Adventures}" AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" Margin="0,8,0,8"
                              Background="{StaticResource PanelFill}" RowBackground="{StaticResource PanelFill}"
                              AlternatingRowBackground="{StaticResource Parchment}">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Write" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="50" />
                            <DataGridTextColumn Header="Adventure" Binding="{Binding Display}" Width="260" IsReadOnly="True" />
                            <DataGridTextColumn Header="Pak" Binding="{Binding Pak}" Width="120" IsReadOnly="True" />
                            <DataGridTextColumn Header="What it holds" Binding="{Binding Detail}" Width="*" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>

                </DockPanel>
            </TabItem>

            <TabItem Header="Reference">
                <DataGrid ItemsSource="{Binding Reference}" AutoGenerateColumns="False" CanUserAddRows="False"
                          IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          Background="{StaticResource PanelFill}" RowBackground="{StaticResource PanelFill}"
                          AlternatingRowBackground="{StaticResource Parchment}" Margin="8">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180" />
                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="160" />
                        <DataGridTextColumn Header="Notes" Binding="{Binding Detail}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
