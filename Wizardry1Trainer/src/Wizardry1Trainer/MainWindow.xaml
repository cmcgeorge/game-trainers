<Window x:Class="Wizardry1Trainer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Wizardry1Trainer.ViewModels"
        Title="Wizardry 1 Trainer" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
        </Style>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <Style x:Key="StatBox" TargetType="TextBox">
            <Setter Property="Width" Value="80"/>
            <Setter Property="Margin" Value="4,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Margin" Value="4,2"/>
            <Setter Property="Padding" Value="8,3"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Process / attach bar -->
        <Border Grid.Row="0" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Process:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding Processes}" DisplayMemberPath="Display"
                          SelectedItem="{Binding SelectedProcess}" Margin="0,0,8,0"/>
                <Button Grid.Column="2" Content="Refresh" Command="{Binding RefreshProcessesCommand}"
                        Style="{StaticResource ActionButton}"/>
                <Button Grid.Column="3" Content="Attach" Command="{Binding AttachCommand}"
                        Style="{StaticResource ActionButton}"/>
                <Button Grid.Column="4" Content="Detach" Command="{Binding DetachCommand}"
                        Style="{StaticResource ActionButton}"/>
            </Grid>
        </Border>

        <!-- Main content -->
        <TabControl Grid.Row="1" Padding="4">
            <!-- Party tab -->
            <TabItem Header="Party">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Party list -->
                    <DockPanel Grid.Column="0" Margin="4">
                        <TextBlock DockPanel.Dock="Top" Text="Party Members" Style="{StaticResource SectionHeader}"/>
                        <Button DockPanel.Dock="Top" Content="Re-scan" Command="{Binding ScanCommand}"
                                Style="{StaticResource ActionButton}" Margin="0,4"/>
                        <ListBox ItemsSource="{Binding Party}" SelectedItem="{Binding SelectedCharacter}"
                                 DisplayMemberPath="ListLabel"/>
                    </DockPanel>

                    <!-- Character editor -->
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="4">
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedCharacter}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <TextBlock Text="{Binding SelectedCharacter.Title}" Style="{StaticResource SectionHeader}"/>
                            <TextBlock Text="{Binding SelectedCharacter.Summary}" Margin="0,0,0,8" Opacity="0.7"/>

                            <!-- Quick actions -->
                            <WrapPanel Margin="0,4,0,8">
                                <Button Content="Full Heal" Click="FullHeal_Click" Style="{StaticResource ActionButton}"/>
                                <Button Content="Max Attributes" Click="MaxAttributes_Click" Style="{StaticResource ActionButton}"/>
                                <Button Content="Max HP" Click="MaxHp_Click" Style="{StaticResource ActionButton}"/>
                                <Button Content="Learn All Spells" Click="LearnSpells_Click" Style="{StaticResource ActionButton}"/>
                                <Button Content="Max Gold" Click="MaxGold_Click" Style="{StaticResource ActionButton}"/>
                                <Button Content="Max XP" Click="MaxExperience_Click" Style="{StaticResource ActionButton}"/>
                                <Button Content="Max Everything" Click="MaxEverything_Click" Style="{StaticResource ActionButton}"/>
                            </WrapPanel>

                            <!-- Identity -->
                            <TextBlock Text="Identity" Style="{StaticResource SectionHeader}"/>
                            <Grid Margin="8,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" Style="{StaticResource StatLabel}"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SelectedCharacter.Name, UpdateSourceTrigger=PropertyChanged}" Margin="4,2"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Race:" Style="{StaticResource StatLabel}"/>
                                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding SelectedCharacter.RaceOptions}"
                                          SelectedIndex="{Binding SelectedCharacter.RaceIndex}" Margin="4,2"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Class:" Style="{StaticResource StatLabel}"/>
                                <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding SelectedCharacter.ClassOptions}"
                                          SelectedIndex="{Binding SelectedCharacter.ClassIndex}" Margin="4,2"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Align:" Style="{StaticResource StatLabel}"/>
                                <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding SelectedCharacter.AlignmentOptions}"
                                          SelectedIndex="{Binding SelectedCharacter.AlignmentIndex}" Margin="4,2"/>
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Status:" Style="{StaticResource StatLabel}"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedCharacter.StatusName}" Style="{StaticResource StatLabel}"/>
                            </Grid>

                            <!-- Attributes -->
                            <TextBlock Text="Attributes" Style="{StaticResource SectionHeader}"/>
                            <ItemsControl ItemsSource="{Binding SelectedCharacter.Attributes}" Margin="8,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                            <TextBlock Text="{Binding Name}" Width="50" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StatBox}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <!-- Vitals / Progression -->
                            <TextBlock Text="Vitals &amp; Progression" Style="{StaticResource SectionHeader}"/>
                            <Grid Margin="8,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="HP Cur:" Style="{StaticResource StatLabel}"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SelectedCharacter.HpCurrent, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StatBox}"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="HP Max:" Style="{StaticResource StatLabel}"/>
                                <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding SelectedCharacter.HpMax, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StatBox}"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Level:" Style="{StaticResource StatLabel}"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedCharacter.Level, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StatBox}"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="AC:" Style="{StaticResource StatLabel}"/>
                                <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding SelectedCharacter.ArmorClass, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StatBox}"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Gold:" Style="{StaticResource StatLabel}"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SelectedCharacter.Gold, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}" Style="{StaticResource StatBox}" Width="120"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="XP:" Style="{StaticResource StatLabel}"/>
                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding SelectedCharacter.Experience, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}" Style="{StaticResource StatBox}" Width="120"/>
                            </Grid>

                            <!-- Freeze toggles -->
                            <TextBlock Text="Freezes" Style="{StaticResource SectionHeader}"/>
                            <WrapPanel Margin="8,0">
                                <CheckBox Content="Freeze HP" IsChecked="{Binding SelectedCharacter.FreezeHp}" Margin="8,4"/>
                                <CheckBox Content="Freeze Status (No Death)" IsChecked="{Binding SelectedCharacter.FreezeStatus}" Margin="8,4"/>
                            </WrapPanel>

                            <!-- Party-wide freeze toggles -->
                            <TextBlock Text="Party-wide Freezes" Style="{StaticResource SectionHeader}"/>
                            <WrapPanel Margin="8,0">
                                <CheckBox Content="Freeze HP (all)" IsChecked="{Binding FreezeHp}" Margin="8,4"/>
                                <CheckBox Content="Freeze Status (all)" IsChecked="{Binding FreezeStatus}" Margin="8,4"/>
                            </WrapPanel>

                            <!-- Party-wide actions -->
                            <TextBlock Text="Party Actions" Style="{StaticResource SectionHeader}"/>
                            <WrapPanel Margin="8,0">
                                <Button Content="Heal Party" Command="{Binding HealPartyCommand}" Style="{StaticResource ActionButton}"/>
                                <Button Content="Max Attributes (all)" Command="{Binding MaxPartyCommand}" Style="{StaticResource ActionButton}"/>
                                <Button Content="Max Gold (all)" Command="{Binding MaxMoneyPartyCommand}" Style="{StaticResource ActionButton}"/>
                                <Button Content="Learn Spells (all)" Command="{Binding LearnSpellsPartyCommand}" Style="{StaticResource ActionButton}"/>
                                <Button Content="Max Everything (all)" Command="{Binding MaxEverythingPartyCommand}" Style="{StaticResource ActionButton}"/>
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- References tab -->
            <TabItem Header="References">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Spell Book" Style="{StaticResource SectionHeader}" Margin="8,4"/>
                    <ListView Grid.Row="1" ItemsSource="{Binding Reference.Spells}" Margin="8,0">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="#" Width="30" DisplayMemberBinding="{Binding Index}"/>
                                <GridViewColumn Header="Name" Width="100" DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="School" Width="60" DisplayMemberBinding="{Binding School}"/>
                                <GridViewColumn Header="Lvl" Width="30" DisplayMemberBinding="{Binding Level}"/>
                                <GridViewColumn Header="Effect" Width="500" DisplayMemberBinding="{Binding Effect}"/>
                            </GridView>
                        </ListView.View>
                        <ListView.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14"
                                                   Foreground="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListView.GroupStyle>
                    </ListView>
                </Grid>
            </TabItem>

            <!-- Maps tab -->
            <TabItem Header="🗺 Maps" DataContext="{Binding Maps}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Level picker -->
                    <DockPanel Grid.Column="0" Margin="4">
                        <TextBlock DockPanel.Dock="Top" Text="Dungeon Levels" Style="{StaticResource SectionHeader}"/>
                        <ListBox ItemsSource="{Binding Levels}" SelectedItem="{Binding Selected}"
                                 DisplayMemberPath="Name"/>
                    </DockPanel>

                    <!-- Map display + POIs -->
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="4">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedDescription}" Style="{StaticResource SectionHeader}"
                                       TextWrapping="Wrap"/>
                            <Image Source="{Binding SelectedImage}" Stretch="None" Margin="0,4,0,12"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            <TextBlock Text="Points of Interest" Style="{StaticResource SectionHeader}"/>
                            <ListView ItemsSource="{Binding Pois}" Margin="0,0,0,8">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Pos" Width="60"
                                                        DisplayMemberBinding="{Binding Position}"/>
                                        <GridViewColumn Header="Name" Width="120" DisplayMemberBinding="{Binding Name}"/>
                                        <GridViewColumn Header="Description" Width="400" DisplayMemberBinding="{Binding Description}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- Cluebook tab -->
            <TabItem Header="&#x1F4D4; Cluebook" DataContext="{Binding Cluebook}">
                <StackPanel Margin="12">
                    <TextBlock Text="Wizardry 1 Cluebook" Style="{StaticResource SectionHeader}" FontSize="16"/>
                    <TextBlock Text="Generate a self-contained HTML strategy guide with all ten dungeon maps, every spell, races, classes, a walkthrough, and strategy notes."
                               TextWrapping="Wrap" Margin="0,0,0,12" MaxWidth="600" Opacity="0.8"/>

                    <TextBlock Text="Include" Style="{StaticResource SectionHeader}"/>
                    <WrapPanel Margin="8,0,0,8">
                        <CheckBox Content="Dungeon maps" IsChecked="{Binding IncludeMaps}" Margin="8,4"/>
                        <CheckBox Content="Spells" IsChecked="{Binding IncludeSpells}" Margin="8,4"/>
                        <CheckBox Content="Races &amp; classes" IsChecked="{Binding IncludeClasses}" Margin="8,4"/>
                        <CheckBox Content="Walkthrough" IsChecked="{Binding IncludeWalkthrough}" Margin="8,4"/>
                        <CheckBox Content="Strategy notes" IsChecked="{Binding IncludeStrategy}" Margin="8,4"/>
                    </WrapPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,8">
                        <Button Content="Save cluebook" Command="{Binding SaveCommand}" Style="{StaticResource ActionButton}"/>
                        <Button Content="Open in browser" Command="{Binding OpenCommand}" Style="{StaticResource ActionButton}"/>
                    </StackPanel>

                    <TextBlock Text="{Binding Status}" Opacity="0.7" TextWrapping="Wrap"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" Padding="8,4">
            <TextBlock Text="{Binding Status}"/>
        </Border>
    </Grid>
</Window>
