<Window x:Class="AmberstarTrainer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AmberstarTrainer"
        Title="Amberstar Trainer" Height="720" Width="960"
        WindowStartupLocation="CenterScreen" WindowState="Maximized">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="2,1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="8,3"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Padding" Value="2,1"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4,0,4,0"/>
            <Setter Property="MinWidth" Value="70"/>
        </Style>
        <Style x:Key="RefHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="2,6,2,2"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Background="#EEE" Padding="6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Process:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox Width="280" ItemsSource="{Binding Processes}" DisplayMemberPath="Display"
                          SelectedItem="{Binding SelectedProcess}"/>
                <Button Content="Refresh" Command="{Binding RefreshProcessesCommand}"/>
                <Button Content="Attach" Command="{Binding AttachCommand}"/>
                <Button Content="Detach" Command="{Binding DetachCommand}"/>
                <Button Content="Re-scan" Command="{Binding ScanCommand}"/>
            </StackPanel>
        </Border>

        <!-- Party-wide actions -->
        <Border DockPanel.Dock="Top" Background="#F6F6F6" Padding="6">
            <StackPanel Orientation="Horizontal">
                <CheckBox Content="Freeze HP" IsChecked="{Binding FreezeHp}" VerticalAlignment="Center" Margin="4,0"/>
                <CheckBox Content="Freeze SP" IsChecked="{Binding FreezeSp}" VerticalAlignment="Center" Margin="4,0"/>
                <CheckBox Content="Freeze Status" IsChecked="{Binding FreezeStatus}" VerticalAlignment="Center" Margin="4,0"
                          ToolTip="Keeps the whole party free of physical and mental ailments."/>
                <Separator Style="{x:Null}" Width="12"/>
                <Button Content="Heal Party" Command="{Binding HealPartyCommand}"/>
                <Button Content="Max Attributes" Command="{Binding MaxPartyCommand}"/>
                <Button Content="Learn Spells" Command="{Binding LearnSpellsPartyCommand}"/>
                <Button Content="Max Money" Command="{Binding MaxMoneyPartyCommand}"/>
                <Button Content="Max Everything" Command="{Binding MaxEverythingPartyCommand}"/>
            </StackPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="#EEE" Padding="6">
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
        </Border>

        <!-- Tabs -->
        <TabControl Margin="6">
            <!-- ======================= PARTY ======================= -->
            <TabItem Header="Party">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <GroupBox Grid.Column="0" Header="Party">
                        <ListBox ItemsSource="{Binding Party}" SelectedItem="{Binding SelectedCharacter}"
                                 DisplayMemberPath="ListLabel"/>
                    </GroupBox>

                    <GroupBox Grid.Column="1" Header="Character" Margin="6,0,0,0"
                              DataContext="{Binding SelectedCharacter}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="6">
                                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14" Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding Summary}" Foreground="#555" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                <!-- Identity -->
                                <GroupBox Header="Identity">
                                    <Grid Margin="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="120"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" Style="{StaticResource FieldLabel}"/>
                                        <TextBox   Grid.Row="0" Grid.Column="1" Text="{Binding Name}"/>
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Gender" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox  Grid.Row="0" Grid.Column="3" Margin="2" SelectedIndex="{Binding GenderIndex}">
                                            <ComboBoxItem Content="Male"/>
                                            <ComboBoxItem Content="Female"/>
                                        </ComboBox>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Race" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox  Grid.Row="1" Grid.Column="1" Margin="2" ItemsSource="{Binding RaceOptions}" SelectedIndex="{Binding RaceIndex}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Class" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox  Grid.Row="1" Grid.Column="3" Margin="2" ItemsSource="{Binding ClassOptions}" SelectedIndex="{Binding ClassIndex}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Level" Style="{StaticResource FieldLabel}"/>
                                        <TextBox   Grid.Row="2" Grid.Column="1" Text="{Binding Level}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Experience" Style="{StaticResource FieldLabel}"/>
                                        <TextBox   Grid.Row="2" Grid.Column="3" Text="{Binding Experience}"/>
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Gold" Style="{StaticResource FieldLabel}"/>
                                        <TextBox   Grid.Row="3" Grid.Column="1" Text="{Binding Gold}"/>
                                        <TextBlock Grid.Row="3" Grid.Column="2" Text="Food" Style="{StaticResource FieldLabel}"/>
                                        <TextBox   Grid.Row="3" Grid.Column="3" Text="{Binding Food}"/>
                                    </Grid>
                                </GroupBox>

                                <!-- Vitals -->
                                <GroupBox Header="Vitals" Margin="0,8,0,0">
                                    <Grid Margin="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="90"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="HP" Style="{StaticResource FieldLabel}"/>
                                        <TextBox   Grid.Row="0" Grid.Column="1" Text="{Binding HpCur}"/>
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="/ Max" Style="{StaticResource FieldLabel}"/>
                                        <TextBox   Grid.Row="0" Grid.Column="3" Text="{Binding HpMax}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="SP" Style="{StaticResource FieldLabel}"/>
                                        <TextBox   Grid.Row="1" Grid.Column="1" Text="{Binding SpCur}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="/ Max" Style="{StaticResource FieldLabel}"/>
                                        <TextBox   Grid.Row="1" Grid.Column="3" Text="{Binding SpMax}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="SLP" Style="{StaticResource FieldLabel}"/>
                                        <TextBox   Grid.Row="2" Grid.Column="1" Text="{Binding Slp}"/>
                                        <CheckBox  Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Content="Freeze HP" IsChecked="{Binding FreezeHp}" VerticalAlignment="Center"/>
                                        <CheckBox  Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Content="Freeze SP" IsChecked="{Binding FreezeSp}" VerticalAlignment="Center"/>
                                        <CheckBox  Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2" Content="Freeze Status" IsChecked="{Binding FreezeStatus}" VerticalAlignment="Center"
                                                  ToolTip="Keeps this character free of physical and mental ailments."/>
                                    </Grid>
                                </GroupBox>

                                <!-- Attributes -->
                                <GroupBox Header="Attributes" Margin="0,8,0,0">
                                    <ItemsControl ItemsSource="{Binding Attributes}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="2">
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource FieldLabel}" MinWidth="40"/>
                                                    <TextBox Width="70" Text="{Binding Value}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </GroupBox>

                                <!-- Skills -->
                                <GroupBox Header="Skills" Margin="0,8,0,0">
                                    <ItemsControl ItemsSource="{Binding Skills}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="2">
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource FieldLabel}" MinWidth="100"/>
                                                    <TextBox Width="50" Text="{Binding Value}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </GroupBox>

                                <!-- Combat & Ailments -->
                                <GroupBox Header="Combat &amp; Ailments" Margin="0,8,0,0">
                                    <Grid Margin="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Base DEF" Style="{StaticResource FieldLabel}"/>
                                        <TextBox   Grid.Row="0" Grid.Column="1" Text="{Binding BaseDef}"/>
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Base DAM" Style="{StaticResource FieldLabel}"/>
                                        <TextBox   Grid.Row="0" Grid.Column="3" Text="{Binding BaseDam}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Phys." Style="{StaticResource FieldLabel}"/>
                                        <TextBox   Grid.Row="1" Grid.Column="1" Text="{Binding PhysicalAilments}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding PhysicalAilmentsName}" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Mental" Style="{StaticResource FieldLabel}"/>
                                        <TextBox   Grid.Row="2" Grid.Column="1" Text="{Binding MentalAilments}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding MentalAilmentsName}" TextWrapping="Wrap"/>
                                    </Grid>
                                </GroupBox>

                                <!-- Spells -->
                                <GroupBox Header="Spells (bitfields)" Margin="0,8,0,0">
                                    <Grid Margin="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="160"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="White" Style="{StaticResource FieldLabel}"/>
                                        <TextBox   Grid.Row="0" Grid.Column="1" Text="{Binding SpellsWhite}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Grey" Style="{StaticResource FieldLabel}"/>
                                        <TextBox   Grid.Row="1" Grid.Column="1" Text="{Binding SpellsGrey}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Black" Style="{StaticResource FieldLabel}"/>
                                        <TextBox   Grid.Row="2" Grid.Column="1" Text="{Binding SpellsBlack}"/>
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Special" Style="{StaticResource FieldLabel}"/>
                                        <TextBox   Grid.Row="3" Grid.Column="1" Text="{Binding SpellsSpecial}"/>
                                    </Grid>
                                </GroupBox>

                                <!-- Per-character actions -->
                                <GroupBox Header="Quick Actions" Margin="0,8,0,0">
                                    <WrapPanel>
                                        <Button Content="Full Heal" Click="FullHeal_Click"/>
                                        <Button Content="Max Attributes" Click="MaxAttributes_Click"/>
                                        <Button Content="Max Skills" Click="MaxSkills_Click"/>
                                        <Button Content="Learn All Spells" Click="LearnSpells_Click"/>
                                        <Button Content="Max Money" Click="MaxMoney_Click"/>
                                        <Button Content="Max Everything" Click="MaxEverything_Click"/>
                                    </WrapPanel>
                                </GroupBox>
                            </StackPanel>
                        </ScrollViewer>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- ======================= REFERENCE ======================= -->
            <TabItem Header="References">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="6">
                    <StackPanel>
                        <TextBlock Text="Spell Reference" Style="{StaticResource RefHeader}"/>
                        <DataGrid ItemsSource="{Binding Reference.AllSpells}" AutoGenerateColumns="False"
                                  IsReadOnly="True" HeadersVisibility="Column" Height="400">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="School" Binding="{Binding School}" Width="80"/>
                                <DataGridTextColumn Header="Bit" Binding="{Binding Bit}" Width="40"/>
                                <DataGridTextColumn Header="Spell Name" Binding="{Binding Name}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="Races" Style="{StaticResource RefHeader}"/>
                        <TextBlock Text="Human, Elf, Dwarf, Gnome, Halfling, Half-Elf, Half-Orc" TextWrapping="Wrap" Margin="4"/>

                        <TextBlock Text="Classes" Style="{StaticResource RefHeader}"/>
                        <TextBlock Text="Warrior, Paladin, Ranger, Thief, Monk, White Mage, Grey Mage, Black Mage" TextWrapping="Wrap" Margin="4"/>

                        <TextBlock Text="Physical Ailments" Style="{StaticResource RefHeader}"/>
                        <TextBlock Text="0x01 Stunned, 0x02 Poisoned, 0x04 Petrified, 0x08 Diseased, 0x10 Aging, 0x20 Dead, 0x40 Ash, 0x80 Dust" TextWrapping="Wrap" Margin="4"/>

                        <TextBlock Text="Mental Ailments" Style="{StaticResource RefHeader}"/>
                        <TextBlock Text="0x01 Irritated, 0x02 Mad, 0x04 Sleeping, 0x08 Afraid, 0x10 Blind, 0x20 Overloaded" TextWrapping="Wrap" Margin="4"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Maps" DataContext="{Binding Maps}">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="280"/>
                    </Grid.ColumnDefinitions>
                    <GroupBox Grid.Column="0" Header="Areas">
                        <ListBox ItemsSource="{Binding Areas}" SelectedItem="{Binding Selected}" DisplayMemberPath="Name"/>
                    </GroupBox>
                    <Grid Grid.Column="1" Margin="6,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding SelectedDescription}" TextWrapping="Wrap" Margin="4"/>
                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <Image Source="{Binding SelectedImage}" Stretch="None"/>
                        </ScrollViewer>
                    </Grid>
                    <GroupBox Grid.Column="2" Header="Points of interest">
                        <ListBox ItemsSource="{Binding Pois}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Position}" Foreground="#555"/>
                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="Cluebook" DataContext="{Binding Cluebook}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="6">
                    <StackPanel Margin="6" MaxWidth="700">
                        <TextBlock Text="Amberstar Cluebook" FontWeight="Bold" FontSize="18"/>
                        <TextBlock Text="Create a self-contained HTML reference with the selected sections." TextWrapping="Wrap" Margin="0,4,0,10"/>
                        <CheckBox Content="Include area maps" IsChecked="{Binding IncludeMaps}" Margin="2"/>
                        <CheckBox Content="Include spell tables" IsChecked="{Binding IncludeSpells}" Margin="2"/>
                        <CheckBox Content="Include race and class reference" IsChecked="{Binding IncludeClasses}" Margin="2"/>
                        <CheckBox Content="Include walkthrough" IsChecked="{Binding IncludeWalkthrough}" Margin="2"/>
                        <CheckBox Content="Include strategy notes" IsChecked="{Binding IncludeStrategy}" Margin="2"/>
                        <WrapPanel Margin="0,10,0,4">
                            <Button Content="Save Cluebook" Command="{Binding SaveCommand}"/>
                            <Button Content="Open Cluebook" Command="{Binding OpenCommand}"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="2"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
