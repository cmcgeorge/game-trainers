<Window x:Class="KnightsOfLegendTrainer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Knights of Legend — Trainer" Height="740" Width="980"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="2,1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="8,3"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#EEE" Padding="6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Process:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox Width="300" ItemsSource="{Binding Processes}" DisplayMemberPath="Display"
                          SelectedItem="{Binding SelectedProcess}"/>
                <Button Content="Refresh" Command="{Binding RefreshProcessesCommand}"/>
                <Button Content="Attach" Command="{Binding AttachCommand}"/>
                <Button Content="Detach" Command="{Binding DetachCommand}"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#EEE" Padding="6">
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
        </Border>

        <TabControl Margin="6">

            <TabItem Header="Value Scanner">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#F6F6F6" Padding="6">
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap" Foreground="#555" FontSize="11" Margin="0,0,0,6"
                                       Text="No game binary was available for static analysis, so the trainer has no automatic locator. Use the guided scans below to find Gold Crowns, Adventure Points, Body Points, the seven primary statistics, Level, Fatigue, and Rations in live memory. The game is turn-based, so it pauses between action rounds — read values when it is your turn."/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Type:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <ComboBox Width="80" ItemsSource="{Binding Widths}"
                                          SelectedItem="{Binding SelectedWidth}"
                                          IsEnabled="{Binding NotScanning}"
                                          ToolTip="Byte, Int16 or Int32. Changing the type starts a new scan."/>
                                <TextBlock Text="Value:" VerticalAlignment="Center" Margin="10,0,4,0"/>
                                <TextBox Width="120" Text="{Binding ScanText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Decimal (13) or hex (0x0D). Leave blank for an unknown-value first scan."/>
                                <Button Content="First Scan" Command="{Binding FirstScanCommand}"/>
                                <Button Content="New Scan" Command="{Binding NewScanCommand}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="Guided:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <ComboBox Width="180" ItemsSource="{Binding Recipes}"
                                          DisplayMemberPath="Label"
                                          SelectedItem="{Binding SelectedRecipe}"
                                          IsEnabled="{Binding NotScanning}"
                                          ToolTip="Pick a stat to scan for — sets the width, default value, and instructions."/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="Narrow:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <Button Content="Exact"     Command="{Binding NextScanCommand}" CommandParameter="Exact"/>
                                <Button Content="Increased" Command="{Binding NextScanCommand}" CommandParameter="Increased"/>
                                <Button Content="Decreased" Command="{Binding NextScanCommand}" CommandParameter="Decreased"/>
                                <Button Content="Changed"   Command="{Binding NextScanCommand}" CommandParameter="Changed"/>
                                <Button Content="Unchanged" Command="{Binding NextScanCommand}" CommandParameter="Unchanged"/>
                                <TextBlock Text="{Binding MatchCount}" VerticalAlignment="Center" Margin="12,0,0,0"
                                           FontWeight="Bold"/>
                            </StackPanel>
                            <TextBlock Text="{Binding GuideText}" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#555"
                                       FontSize="11"/>
                        </StackPanel>
                    </Border>
                    <Border DockPanel.Dock="Bottom" Background="#F6F6F6" Padding="6">
                        <Button Content="Pin selected →" Command="{Binding PinCommand}"
                                ToolTip="Add to the Freezes tab for editing or freezing."/>
                    </Border>
                    <DataGrid ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              IsReadOnly="True" HeadersVisibility="Column" Margin="0,6,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Address" Binding="{Binding AddressHex}" Width="220"/>
                            <DataGridTextColumn Header="Value"   Binding="{Binding Value}"      Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Freezes">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#F6F6F6" Padding="6">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Freeze all"      Command="{Binding FreezeAllCommand}"/>
                            <Button Content="Unfreeze all"    Command="{Binding UnfreezeAllCommand}"/>
                            <Button Content="Remove selected" Command="{Binding RemoveFrozenCommand}"/>
                            <TextBlock VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#555"
                                       Text="Pin any value here via the Value Scanner tab. Edit Target to poke a value; tick Freeze to re-write it every ~200 ms."/>
                        </StackPanel>
                    </Border>
                    <DataGrid ItemsSource="{Binding Frozen}" SelectedItem="{Binding SelectedFrozen}"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column" Margin="0,6,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Label"   Binding="{Binding Label}"      IsReadOnly="True" Width="120"/>
                            <DataGridTextColumn Header="Address" Binding="{Binding AddressHex}" IsReadOnly="True" Width="180"/>
                            <DataGridTextColumn Header="Type"    Binding="{Binding WidthLabel}" IsReadOnly="True" Width="60"/>
                            <DataGridTextColumn Header="Live"    Binding="{Binding Live}"       IsReadOnly="True" Width="80"/>
                            <DataGridTextColumn Header="Target"
                                                Binding="{Binding Target, UpdateSourceTrigger=LostFocus}" Width="*"/>
                            <DataGridCheckBoxColumn Header="Freeze" Binding="{Binding Frozen}" Width="60"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Save Editor">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#F6F6F6" Padding="6">
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap" Foreground="#555" FontSize="11" Margin="0,0,0,6"
                                       Text="Edit quest status in a chardata save file. The chardata format stores 24 quests at file offsets 482-487, each quest using a 2-bit code: 00 = not given, 01 = given, 10 = complete, 11 = medal given. A .bak backup is taken before the first save. Only the quest status region is edited — all other bytes are preserved verbatim."/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Load chardata…" Command="{Binding LoadSaveCommand}"/>
                                <Button Content="Save"           Command="{Binding SaveSaveCommand}"/>
                                <Button Content="Set All Given"    Command="{Binding SetAllQuestsGivenCommand}"
                                        ToolTip="Set all 24 quests to 'Given' (status 1)."/>
                                <Button Content="Set All Complete" Command="{Binding SetAllQuestsCompleteCommand}"
                                        ToolTip="Set all 24 quests to 'Complete' (status 2)."/>
                                <Button Content="Set All Medal"    Command="{Binding SetAllQuestsMedalCommand}"
                                        ToolTip="Set all 24 quests to 'Medal Given' (status 3)."/>
                            </StackPanel>
                            <TextBlock Text="{Binding SaveEditor.StatusText}" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Foreground="#555" FontSize="11"/>
                        </StackPanel>
                    </Border>
                    <DataGrid ItemsSource="{Binding SaveEditor.Quests}"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column" Margin="0,6,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#"      Binding="{Binding Index}"     IsReadOnly="True" Width="30"/>
                            <DataGridTextColumn Header="Quest"   Binding="{Binding QuestName}" IsReadOnly="True" Width="*"/>
                            <DataGridTextColumn Header="Status"  Binding="{Binding StatusLabel}" IsReadOnly="True" Width="120"/>
                            <DataGridTemplateColumn Header="Set" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding StatusOptions}"
                                                  SelectedIndex="{Binding Status, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  BorderThickness="0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Races">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#F6F6F6" Padding="6">
                        <TextBlock TextWrapping="Wrap" Foreground="#555"
                                   Text="The four playable races of Ashtalarea. Kelden can fly in combat; Dwarves can ride horses despite the Brettle stable's claim. Each race has a different set of available classes and magic orders."/>
                    </Border>
                    <DataGrid ItemsSource="{Binding Races}" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                              HeadersVisibility="Column" Margin="0,6,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Race"        Binding="{Binding Name}"        Width="80"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                            <DataGridTextColumn Header="Notes"       Binding="{Binding Notes}"       Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Classes">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#F6F6F6" Padding="6">
                        <TextBlock TextWrapping="Wrap" Foreground="#555"
                                   Text="All 33 character classes, grouped by race and gender. Level is the starting class level (Peasant = 1, Knight = 25). Create dummy Brettle Regular characters (start with 3000 GC), buy plate armor, trade to main party, and sell for a profit."/>
                    </Border>
                    <DataGrid ItemsSource="{Binding Classes}" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                              HeadersVisibility="Column" Margin="0,6,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#"       Binding="{Binding Id}"     Width="30"/>
                            <DataGridTextColumn Header="Class"    Binding="{Binding Name}"   Width="140"/>
                            <DataGridTextColumn Header="Race"     Binding="{Binding Race}"   Width="80"/>
                            <DataGridTextColumn Header="Gender"   Binding="{Binding Gender}" Width="70"/>
                            <DataGridTextColumn Header="Level"    Binding="{Binding Level}"  Width="50"/>
                            <DataGridTextColumn Header="Notes"    Binding="{Binding Notes}"  Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Weapons">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#F6F6F6" Padding="6">
                        <TextBlock TextWrapping="Wrap" Foreground="#555"
                                   Text="All weapon types and their training masters. Each master trains four weapons up to a maximum proficiency. Training costs 200 GC and 100 adventure points per skill level. Weapons break randomly in combat, so train in several types. Proficiency levels: None, Beginner, Neophyte, Novice, Average, Skilled, Stalwart, Adept, Savant, Expert."/>
                    </Border>
                    <DataGrid ItemsSource="{Binding Weapons}" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                              HeadersVisibility="Column" Margin="0,6,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#"            Binding="{Binding Id}"             Width="30"/>
                            <DataGridTextColumn Header="Weapon"       Binding="{Binding Name}"           Width="120"/>
                            <DataGridTextColumn Header="Master"       Binding="{Binding Master}"         Width="140"/>
                            <DataGridTextColumn Header="Location"     Binding="{Binding Location}"       Width="160"/>
                            <DataGridTextColumn Header="Max Prof."    Binding="{Binding MaxProficiency}" Width="60"/>
                            <DataGridTextColumn Header="Notes"        Binding="{Binding Notes}"          Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Armor">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#F6F6F6" Padding="6">
                        <TextBlock TextWrapping="Wrap" Foreground="#555"
                                   Text="Armor types covering head, torso, and legs. Weight and encumbrance reduce Quickness and movement. The Great Shield from quests is the best shield: excellent protection and lightweight."/>
                    </Border>
                    <DataGrid ItemsSource="{Binding Armor}" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                              HeadersVisibility="Column" Margin="0,6,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#"        Binding="{Binding Id}"       Width="30"/>
                            <DataGridTextColumn Header="Armor"     Binding="{Binding Name}"     Width="120"/>
                            <DataGridTextColumn Header="Category"  Binding="{Binding Category}" Width="80"/>
                            <DataGridTextColumn Header="Notes"     Binding="{Binding Notes}"    Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Magic">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#F6F6F6" Padding="6">
                        <TextBlock TextWrapping="Wrap" Foreground="#555"
                                   Text="The six magic orders and their spells. A character can only join one order, but can learn basic spells from all orders before joining. After joining, the spell's race component is fixed. Learn from all orders first, then join the one whose spells best fit your character."/>
                    </Border>
                    <DataGrid ItemsSource="{Binding MagicOrders}" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                              HeadersVisibility="Column" Margin="0,6,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Order"     Binding="{Binding Name}"           Width="100"/>
                            <DataGridTextColumn Header="Location"  Binding="{Binding Location}"       Width="120"/>
                            <DataGridTextColumn Header="Component" Binding="{Binding ComponentRace}"  Width="100"/>
                            <DataGridTextColumn Header="Notes"     Binding="{Binding Notes}"          Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Separator Margin="0,6"/>
                    <DataGrid ItemsSource="{Binding Spells}" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                              HeadersVisibility="Column" Margin="0,6,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Spell"     Binding="{Binding Name}"        Width="120"/>
                            <DataGridTextColumn Header="Order"     Binding="{Binding Order}"       Width="100"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Monsters">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#F6F6F6" Padding="6">
                        <TextBlock TextWrapping="Wrap" Foreground="#555"
                                   Text="Monsters encountered during the 24 quests, organized by category. Trolls and cliff trolls regenerate each round — concentrate fire. Wear the Courage Coat before facing trolls, giants, or cyclops. Sledge creatures require splitting the party."/>
                    </Border>
                    <DataGrid ItemsSource="{Binding Monsters}" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                              HeadersVisibility="Column" Margin="0,6,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#"        Binding="{Binding Id}"        Width="30"/>
                            <DataGridTextColumn Header="Monster"   Binding="{Binding Name}"      Width="120"/>
                            <DataGridTextColumn Header="Category"  Binding="{Binding Category}"  Width="80"/>
                            <DataGridTextColumn Header="Location"  Binding="{Binding Location}"  Width="140"/>
                            <DataGridTextColumn Header="Notes"     Binding="{Binding Notes}"     Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Maps">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="260"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="6">
                        <TextBlock Text="Areas" FontWeight="Bold" Margin="0,0,0,6"/>
                        <ListBox ItemsSource="{Binding Maps.Levels}" SelectedItem="{Binding Maps.Selected}"
                                 DisplayMemberPath="Name"/>
                    </StackPanel>
                    <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Margin="6">
                        <StackPanel>
                            <TextBlock Text="{Binding Maps.SelectedDescription}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <Image Source="{Binding Maps.SelectedImage}" Stretch="None" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </ScrollViewer>
                    <DockPanel Grid.Column="2" Margin="6">
                        <TextBlock DockPanel.Dock="Top" Text="Landmarks" FontWeight="Bold" Margin="0,0,0,6"/>
                        <DataGrid ItemsSource="{Binding Maps.Pois}" AutoGenerateColumns="False" CanUserAddRows="False"
                                  CanUserDeleteRows="False" IsReadOnly="True" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Position" Binding="{Binding Position}" Width="65"/>
                                <DataGridTextColumn Header="Landmark" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Notes" Binding="{Binding Description}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Cluebook">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <TextBlock TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,8"
                                   Text="Generate a self-contained HTML cluebook with schematic area maps, reference tables, the complete quest list, walkthrough, and strategy notes. No game installation or attached process is required."/>
                        <WrapPanel Margin="0,0,0,8">
                            <CheckBox Content="Area maps" IsChecked="{Binding Cluebook.IncludeMaps}" Margin="0,0,14,0"/>
                            <CheckBox Content="References" IsChecked="{Binding Cluebook.IncludeReferences}" Margin="0,0,14,0"/>
                            <CheckBox Content="Quests" IsChecked="{Binding Cluebook.IncludeQuests}" Margin="0,0,14,0"/>
                            <CheckBox Content="Walkthrough" IsChecked="{Binding Cluebook.IncludeWalkthrough}" Margin="0,0,14,0"/>
                            <CheckBox Content="Strategy" IsChecked="{Binding Cluebook.IncludeStrategy}"/>
                        </WrapPanel>
                        <WrapPanel>
                            <Button Content="Save cluebook" Command="{Binding Cluebook.SaveCommand}"/>
                            <Button Content="Open cluebook" Command="{Binding Cluebook.OpenCommand}"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding Cluebook.Status}" TextWrapping="Wrap" Foreground="#555" Margin="0,8,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Quests">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#F6F6F6" Padding="6">
                        <TextBlock TextWrapping="Wrap" Foreground="#555"
                                   Text="The 24 quests of Knights of Legend, in the order they must be attempted. All 24 must be completed before the final rescue of Seggallion. Talk to the quest giver, say the keyword, travel to the target location, and defeat the monster. Key items: Truth Sword (4-32 dmg), Flying Cloak, Courage Coat, Speed Boots, Great Shield, Deathblade (5-27 dmg)."/>
                    </Border>
                    <DataGrid ItemsSource="{Binding Quests}" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                              HeadersVisibility="Column" Margin="0,6,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#"           Binding="{Binding Id}"             Width="30"/>
                            <DataGridTextColumn Header="Quest"        Binding="{Binding Name}"           Width="140"/>
                            <DataGridTextColumn Header="Giver"        Binding="{Binding QuestGiver}"     Width="100"/>
                            <DataGridTextColumn Header="Location"     Binding="{Binding Location}"       Width="100"/>
                            <DataGridTextColumn Header="Keyword"      Binding="{Binding Keyword}"        Width="80"/>
                            <DataGridTextColumn Header="Target"       Binding="{Binding TargetLocation}" Width="120"/>
                            <DataGridTextColumn Header="Monster"      Binding="{Binding Monster}"        Width="100"/>
                            <DataGridTextColumn Header="Reward"       Binding="{Binding Reward}"         Width="*"/>
                            <DataGridTextColumn Header="Notes"        Binding="{Binding Notes}"          Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
