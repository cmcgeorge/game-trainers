<Window x:Class="HillsfarTrainer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:HillsfarTrainer.ViewModels"
        Title="Hillsfar Trainer" Height="760" Width="1060"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,2,8,2"/>
            <Setter Property="MinWidth" Value="70"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,2,8,2"/>
            <Setter Property="MinWidth" Value="120"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,2,6,2"/>
        </Style>
        <Style x:Key="Head" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>
        <Style x:Key="Mono" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- attach bar -->
        <Border DockPanel.Dock="Top" Padding="10,8" Background="#F3F3F3"
                BorderBrush="#DDD" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Process:"/>
                <ComboBox ItemsSource="{Binding Processes}" SelectedItem="{Binding SelectedProcess}"
                          DisplayMemberPath="Display" MinWidth="260"/>
                <Button Content="Refresh" Command="{Binding RefreshProcessesCommand}"/>
                <Button Content="Attach" Command="{Binding AttachCommand}"/>
                <Button Content="Detach" Command="{Binding DetachCommand}"/>
                <Button Content="Locate game" Command="{Binding LocateCommand}"/>
                <TextBlock Text="scanning…" Foreground="#B36B00" Margin="8,0,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- status bar -->
        <Border DockPanel.Dock="Bottom" Padding="10,6" Background="#F3F3F3"
                BorderBrush="#DDD" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
        </Border>

        <TabControl Margin="8">

            <!-- ================= live character ================= -->
            <TabItem Header="Character (live)">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" TextWrapping="Wrap" Foreground="#555"
                                   Text="Attach to DOSBox and the trainer finds the game by itself — there is no value searching. Edits are written straight into the running game; they reach disk when you use the camp menu's 'Save your current Hillsfar character'."/>

                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="IsEnabled" Value="False"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasCharacter}" Value="True">
                                            <Setter Property="IsEnabled" Value="True"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- left column -->
                            <StackPanel Grid.Column="0" Margin="0,0,16,0"
                                        DataContext="{Binding Character}">
                                <TextBlock Style="{StaticResource Head}" Text="In the game right now"/>
                                <TextBlock Style="{StaticResource Mono}" TextWrapping="Wrap"
                                           Text="{Binding LiveSummary}"/>
                                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap">
                                    <Run Text="Open at"/>
                                    <Run Text="{Binding LiveHour, Mode=OneWay}" FontWeight="Bold"/>
                                    <Run Text=":"/>
                                    <Run Text="{Binding OpenNow, Mode=OneWay}"/>
                                </TextBlock>

                                <TextBlock Style="{StaticResource Head}" Text="Identity"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/><RowDefinition/><RowDefinition/>
                                        <RowDefinition/><RowDefinition/><RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Name"/>
                                    <TextBox   Grid.Row="0" Grid.Column="1" MaxLength="15"
                                               Text="{Binding Name, UpdateSourceTrigger=LostFocus}"/>
                                    <TextBlock Grid.Row="1" Text="Race"/>
                                    <ComboBox  Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left"
                                               ItemsSource="{Binding DataContext.Races, RelativeSource={RelativeSource AncestorType=Window}}"
                                               SelectedIndex="{Binding RaceIndex}"/>
                                    <TextBlock Grid.Row="2" Text="Gender"/>
                                    <ComboBox  Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left"
                                               ItemsSource="{Binding DataContext.Genders, RelativeSource={RelativeSource AncestorType=Window}}"
                                               SelectedIndex="{Binding GenderIndex}"/>
                                    <TextBlock Grid.Row="3" Text="Class"/>
                                    <ComboBox  Grid.Row="3" Grid.Column="1" HorizontalAlignment="Left"
                                               DisplayMemberPath="Name"
                                               ItemsSource="{Binding DataContext.Classes, RelativeSource={RelativeSource AncestorType=Window}}"
                                               SelectedIndex="{Binding ClassChoiceIndex}"/>
                                    <TextBlock Grid.Row="4" Text="Alignment"/>
                                    <ComboBox  Grid.Row="4" Grid.Column="1" HorizontalAlignment="Left"
                                               ItemsSource="{Binding DataContext.Alignments, RelativeSource={RelativeSource AncestorType=Window}}"
                                               SelectedIndex="{Binding AlignmentIndex}"/>
                                    <TextBlock Grid.Row="5" Text="Age"/>
                                    <TextBox   Grid.Row="5" Grid.Column="1" HorizontalAlignment="Left"
                                               Text="{Binding Age, UpdateSourceTrigger=LostFocus}"/>
                                </Grid>

                                <TextBlock Style="{StaticResource Head}" Text="Abilities (3–19)"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/><RowDefinition/><RowDefinition/>
                                        <RowDefinition/><RowDefinition/><RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Strength"/>
                                    <TextBox   Grid.Row="0" Grid.Column="1"
                                               Text="{Binding Strength, UpdateSourceTrigger=LostFocus}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Foreground="#777"
                                               Text="exceptional % (fighters only) →"/>
                                    <TextBlock Grid.Row="1" Text="  percentile"/>
                                    <TextBox   Grid.Row="1" Grid.Column="1"
                                               Text="{Binding StrengthPercentile, UpdateSourceTrigger=LostFocus}"/>
                                    <TextBlock Grid.Row="2" Text="Intelligence"/>
                                    <TextBox   Grid.Row="2" Grid.Column="1"
                                               Text="{Binding Intelligence, UpdateSourceTrigger=LostFocus}"/>
                                    <TextBlock Grid.Row="3" Text="Wisdom"/>
                                    <TextBox   Grid.Row="3" Grid.Column="1"
                                               Text="{Binding Wisdom, UpdateSourceTrigger=LostFocus}"/>
                                    <TextBlock Grid.Row="4" Text="Dexterity"/>
                                    <TextBox   Grid.Row="4" Grid.Column="1"
                                               Text="{Binding Dexterity, UpdateSourceTrigger=LostFocus}"/>
                                    <TextBlock Grid.Row="4" Grid.Column="2" Foreground="#777"
                                               Text="less aim drift at the range"/>
                                    <TextBlock Grid.Row="5" Text="Constitution"/>
                                    <TextBox   Grid.Row="5" Grid.Column="1"
                                               Text="{Binding Constitution, UpdateSourceTrigger=LostFocus}"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Charisma"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding Charisma, UpdateSourceTrigger=LostFocus}"/>
                                </Grid>
                                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#777"
                                           Text="{Binding HealingNote}"/>
                            </StackPanel>

                            <!-- right column -->
                            <StackPanel Grid.Column="1" DataContext="{Binding Character}">
                                <TextBlock Style="{StaticResource Head}" Text="Vitals and wealth"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Hit points"/>
                                    <TextBox   Grid.Row="0" Grid.Column="1"
                                               Text="{Binding HitPoints, UpdateSourceTrigger=LostFocus}"/>
                                    <TextBlock Grid.Row="1" Text="Hit points max"/>
                                    <TextBox   Grid.Row="1" Grid.Column="1"
                                               Text="{Binding HitPointsMax, UpdateSourceTrigger=LostFocus}"/>
                                    <TextBlock Grid.Row="2" Text="Gold"/>
                                    <TextBox   Grid.Row="2" Grid.Column="1" MinWidth="120"
                                               Text="{Binding Gold, UpdateSourceTrigger=LostFocus}"/>
                                    <TextBlock Grid.Row="3" Text="Experience"/>
                                    <TextBox   Grid.Row="3" Grid.Column="1" MinWidth="120"
                                               Text="{Binding Experience, UpdateSourceTrigger=LostFocus}"/>
                                </Grid>

                                <TextBlock Style="{StaticResource Head}"
                                           Text="Levels (one per class; the mask decides which count)"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Cleric"/>
                                    <TextBox   Grid.Row="0" Grid.Column="1"
                                               Text="{Binding ClericLevel, UpdateSourceTrigger=LostFocus}"/>
                                    <TextBlock Grid.Row="1" Text="Magic-User"/>
                                    <TextBox   Grid.Row="1" Grid.Column="1"
                                               Text="{Binding MagicUserLevel, UpdateSourceTrigger=LostFocus}"/>
                                    <TextBlock Grid.Row="2" Text="Fighter"/>
                                    <TextBox   Grid.Row="2" Grid.Column="1"
                                               Text="{Binding FighterLevel, UpdateSourceTrigger=LostFocus}"/>
                                    <TextBlock Grid.Row="3" Text="Thief"/>
                                    <TextBox   Grid.Row="3" Grid.Column="1"
                                               Text="{Binding ThiefLevel, UpdateSourceTrigger=LostFocus}"/>
                                </Grid>

                                <TextBlock Style="{StaticResource Head}" Text="Carried and progress"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/><RowDefinition/><RowDefinition/>
                                        <RowDefinition/><RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Knock rings"/>
                                    <TextBox   Grid.Row="0" Grid.Column="1"
                                               Text="{Binding KnockRings, UpdateSourceTrigger=LostFocus}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Foreground="#777" Text="max 99"/>
                                    <TextBlock Grid.Row="1" Text="Healing potions"/>
                                    <TextBox   Grid.Row="1" Grid.Column="1"
                                               Text="{Binding HealingPotions, UpdateSourceTrigger=LostFocus}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Foreground="#777" Text="max 99"/>
                                    <TextBlock Grid.Row="2" Text="Archery level"/>
                                    <TextBox   Grid.Row="2" Grid.Column="1"
                                               Text="{Binding ArcheryLevel, UpdateSourceTrigger=LostFocus}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Foreground="#777"
                                               Text="max 15; gates five mission steps"/>
                                    <TextBlock Grid.Row="3" Text="Hour of day"/>
                                    <TextBox   Grid.Row="3" Grid.Column="1"
                                               Text="{Binding Hour, UpdateSourceTrigger=LostFocus}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="2" Foreground="#777"
                                               Text="{Binding HourText}"/>
                                    <TextBlock Grid.Row="4" Text="Day"/>
                                    <TextBox   Grid.Row="4" Grid.Column="1"
                                               Text="{Binding Day, UpdateSourceTrigger=LostFocus}"/>
                                </Grid>
                                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#777">
                                    <Run Text="At the edited hour, open:"/>
                                    <Run Text="{Binding EditOpenNow, Mode=OneWay}"/>
                                </TextBlock>

                                <TextBlock Style="{StaticResource Head}" Text="One-click"/>
                                <WrapPanel>
                                    <Button Content="Heal to full" Command="{Binding HealCommand}"/>
                                    <Button Content="Max abilities" Command="{Binding MaxAbilitiesCommand}"/>
                                    <Button Content="Max rings + potions" Command="{Binding MaxConsumablesCommand}"/>
                                    <Button Content="Max archery" Command="{Binding MaxArcheryCommand}"/>
                                    <Button Content="Level up" Command="{Binding LevelUpCommand}"/>
                                    <Button Content="Repair picks" Command="{Binding RepairPicksCommand}"/>
                                    <Button Content="Reload from game" Command="{Binding ReloadCommand}"/>
                                    <Button Content="Export to .HIL"
                                            Command="{Binding DataContext.ExportCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                </WrapPanel>

                                <TextBlock Style="{StaticResource Head}"
                                           Text="Freeze (re-checked every 400 ms; values clamp to each field's range)"/>
                                <ItemsControl ItemsSource="{Binding Freezes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                                <CheckBox IsChecked="{Binding IsFrozen}" Width="210"
                                                          VerticalContentAlignment="Center"
                                                          Content="{Binding Label}"/>
                                                <TextBox Width="110" Text="{Binding Value, UpdateSourceTrigger=LostFocus}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ================= lock picks ================= -->
            <TabItem Header="Lock picks">
                <StackPanel Margin="14" DataContext="{Binding Character}"
                            IsEnabled="{Binding DataContext.HasCharacter,
                                        RelativeSource={RelativeSource AncestorType=Window}}">
                    <TextBlock TextWrapping="Wrap" Foreground="#555"
                               Text="Twelve slots of five bytes. The four shape bytes decide which tumblers a pick fits, and across every shipped record they come in exact +20 pairs. The trainer will set a slot's condition byte but never invents shapes — a made-up set could open nothing. Buy a set at your guild for properly generated picks, then use Repair picks."/>
                    <TextBlock Margin="0,10,0,6">
                        <Run Text="Usable picks:"/>
                        <Run Text="{Binding PicksPresent, Mode=OneWay}" FontWeight="Bold"/>
                        <Run Text="of 12"/>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding LockPicks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource Mono}" Text="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Repair picks" HorizontalAlignment="Left" Margin="0,10,0,0"
                            Command="{Binding RepairPicksCommand}"/>
                </StackPanel>
            </TabItem>

            <!-- ================= file editor ================= -->
            <TabItem Header="Character files">
                <Grid Margin="14" DataContext="{Binding Files}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" TextWrapping="Wrap" Foreground="#555"
                               Text="A .HIL or .PRE file is a raw dump of the same 188-byte record — no header, no checksum — so it can be edited with the game closed. A one-shot .bak is kept beside the file before the first write. Note that DOSBox caches its directory listing: a file created here may not appear in the game's load menu until Hillsfar restarts."/>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10">
                        <TextBlock Text="Game folder:"/>
                        <TextBox Width="420" Text="{Binding FolderPath}"/>
                        <Button Content="Load folder" Command="{Binding LoadFolderCommand}"/>
                        <Button Content="Save" Command="{Binding SaveCommand}"/>
                        <Button Content="Revert" Command="{Binding RevertCommand}"/>
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <ListBox Grid.Column="0" ItemsSource="{Binding Files}"
                                 SelectedItem="{Binding Selected}" DisplayMemberPath="DisplayName"/>

                        <ScrollViewer Grid.Column="1" Margin="12,0,0,0" VerticalScrollBarVisibility="Auto">
                            <StackPanel IsEnabled="{Binding HasSelection}">
                                <TextBlock Style="{StaticResource Mono}" TextWrapping="Wrap"
                                           Text="{Binding Summary}"/>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                        <RowDefinition/><RowDefinition/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Name"/>
                                    <TextBox   Grid.Row="0" Grid.Column="1" MaxLength="15" MinWidth="150"
                                               Text="{Binding Name, UpdateSourceTrigger=LostFocus}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Age"/>
                                    <TextBox   Grid.Row="0" Grid.Column="3"
                                               Text="{Binding Age, UpdateSourceTrigger=LostFocus}"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Race"/>
                                    <ComboBox  Grid.Row="1" Grid.Column="1"
                                               ItemsSource="{Binding DataContext.Races, RelativeSource={RelativeSource AncestorType=Window}}"
                                               SelectedIndex="{Binding RaceIndex}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Gender"/>
                                    <ComboBox  Grid.Row="1" Grid.Column="3"
                                               ItemsSource="{Binding DataContext.Genders, RelativeSource={RelativeSource AncestorType=Window}}"
                                               SelectedIndex="{Binding GenderIndex}"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Class"/>
                                    <ComboBox  Grid.Row="2" Grid.Column="1" DisplayMemberPath="Name"
                                               ItemsSource="{Binding DataContext.Classes, RelativeSource={RelativeSource AncestorType=Window}}"
                                               SelectedIndex="{Binding ClassChoiceIndex}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Alignment"/>
                                    <ComboBox  Grid.Row="2" Grid.Column="3"
                                               ItemsSource="{Binding DataContext.Alignments, RelativeSource={RelativeSource AncestorType=Window}}"
                                               SelectedIndex="{Binding AlignmentIndex}"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Strength"/>
                                    <TextBox   Grid.Row="3" Grid.Column="1"
                                               Text="{Binding Strength, UpdateSourceTrigger=LostFocus}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="2" Text="Exceptional %"/>
                                    <TextBox   Grid.Row="3" Grid.Column="3"
                                               Text="{Binding StrengthPercentile, UpdateSourceTrigger=LostFocus}"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Intelligence"/>
                                    <TextBox   Grid.Row="4" Grid.Column="1"
                                               Text="{Binding Intelligence, UpdateSourceTrigger=LostFocus}"/>
                                    <TextBlock Grid.Row="4" Grid.Column="2" Text="Wisdom"/>
                                    <TextBox   Grid.Row="4" Grid.Column="3"
                                               Text="{Binding Wisdom, UpdateSourceTrigger=LostFocus}"/>

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Dexterity"/>
                                    <TextBox   Grid.Row="5" Grid.Column="1"
                                               Text="{Binding Dexterity, UpdateSourceTrigger=LostFocus}"/>
                                    <TextBlock Grid.Row="5" Grid.Column="2" Text="Constitution"/>
                                    <TextBox   Grid.Row="5" Grid.Column="3"
                                               Text="{Binding Constitution, UpdateSourceTrigger=LostFocus}"/>

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Charisma"/>
                                    <TextBox   Grid.Row="6" Grid.Column="1"
                                               Text="{Binding Charisma, UpdateSourceTrigger=LostFocus}"/>
                                    <TextBlock Grid.Row="6" Grid.Column="2" Text="Hour of day"/>
                                    <TextBox   Grid.Row="6" Grid.Column="3"
                                               Text="{Binding Hour, UpdateSourceTrigger=LostFocus}"/>

                                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Hit points"/>
                                    <TextBox   Grid.Row="7" Grid.Column="1"
                                               Text="{Binding HitPoints, UpdateSourceTrigger=LostFocus}"/>
                                    <TextBlock Grid.Row="7" Grid.Column="2" Text="Hit points max"/>
                                    <TextBox   Grid.Row="7" Grid.Column="3"
                                               Text="{Binding HitPointsMax, UpdateSourceTrigger=LostFocus}"/>

                                    <TextBlock Grid.Row="8" Grid.Column="0" Text="Gold"/>
                                    <TextBox   Grid.Row="8" Grid.Column="1"
                                               Text="{Binding Gold, UpdateSourceTrigger=LostFocus}"/>
                                    <TextBlock Grid.Row="8" Grid.Column="2" Text="Experience"/>
                                    <TextBox   Grid.Row="8" Grid.Column="3"
                                               Text="{Binding Experience, UpdateSourceTrigger=LostFocus}"/>

                                    <TextBlock Grid.Row="9" Grid.Column="0" Text="Knock rings"/>
                                    <TextBox   Grid.Row="9" Grid.Column="1"
                                               Text="{Binding KnockRings, UpdateSourceTrigger=LostFocus}"/>
                                    <TextBlock Grid.Row="9" Grid.Column="2" Text="Healing potions"/>
                                    <TextBox   Grid.Row="9" Grid.Column="3"
                                               Text="{Binding HealingPotions, UpdateSourceTrigger=LostFocus}"/>
                                </Grid>

                                <TextBlock Style="{StaticResource Head}" Text="Levels"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/><RowDefinition/><RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Cleric"/>
                                    <TextBox   Grid.Row="0" Grid.Column="1"
                                               Text="{Binding ClericLevel, UpdateSourceTrigger=LostFocus}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Magic-User"/>
                                    <TextBox   Grid.Row="0" Grid.Column="3"
                                               Text="{Binding MagicUserLevel, UpdateSourceTrigger=LostFocus}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Fighter"/>
                                    <TextBox   Grid.Row="1" Grid.Column="1"
                                               Text="{Binding FighterLevel, UpdateSourceTrigger=LostFocus}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Thief"/>
                                    <TextBox   Grid.Row="1" Grid.Column="3"
                                               Text="{Binding ThiefLevel, UpdateSourceTrigger=LostFocus}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Archery level"/>
                                    <TextBox   Grid.Row="2" Grid.Column="1"
                                               Text="{Binding ArcheryLevel, UpdateSourceTrigger=LostFocus}"/>
                                </Grid>

                                <WrapPanel Margin="0,12,0,0">
                                    <Button Content="Heal to full" Command="{Binding HealCommand}"/>
                                    <Button Content="Max abilities" Command="{Binding MaxAbilitiesCommand}"/>
                                    <Button Content="Max rings + potions" Command="{Binding MaxConsumablesCommand}"/>
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ================= reference ================= -->
            <TabItem Header="Opening hours">
                <StackPanel Margin="14" DataContext="{Binding Reference}">
                    <TextBlock TextWrapping="Wrap" Foreground="#555"
                               Text="The most important table in the game. Shops, the bank, the bookstore, the archery range and the Mages' Tower run 8 am–3 pm; pubs run 5 pm–7 am; the Cemetery is open only in the small hours; and the Castle, Haunted Mansion and Jail never open at all — those are break-ins."/>
                    <StackPanel Orientation="Horizontal" Margin="0,10">
                        <TextBlock Text="Hour of day (1–24):"/>
                        <TextBox Width="60" Text="{Binding Hour, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="{Binding HourText}" FontWeight="Bold"/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Locations}" AutoGenerateColumns="False"
                              IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              MaxHeight="420">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Location" Binding="{Binding Name}" Width="150"/>
                            <DataGridCheckBoxColumn Header="Open now" Binding="{Binding IsOpen}" Width="80"/>
                            <DataGridTextColumn Header="Hours" Binding="{Binding Hours}" Width="150"/>
                            <DataGridTextColumn Header="Why you go" Binding="{Binding Note}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#777"
                               Text="{Binding ClockNote}"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Arena">
                <StackPanel Margin="14" DataContext="{Binding Reference}">
                    <TextBlock TextWrapping="Wrap" Foreground="#555"
                               Text="Every opponent telegraphs its next blow, and reading the tell is the whole fight. Block and watch for several exchanges before attacking. The four tells the game itself teaches through pub gossip are marked as shipped."/>
                    <DataGrid ItemsSource="{Binding Opponents}" AutoGenerateColumns="False"
                              IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              Margin="0,10,0,0" MaxHeight="380">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Opponent" Binding="{Binding Name}" Width="230"/>
                            <DataGridCheckBoxColumn Header="Hint shipped" Binding="{Binding TellShipped}" Width="90"/>
                            <DataGridTextColumn Header="Tell" Binding="{Binding Tell}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </TabItem>

            <TabItem Header="Overland">
                <StackPanel Margin="14" DataContext="{Binding Reference}">
                    <TextBlock TextWrapping="Wrap" Foreground="#555"
                               Text="Three locations are reachable only by unmarked trail: ride the parent location until a '?' appears over your horse and press Space. Each is required by at least one mission."/>
                    <DataGrid ItemsSource="{Binding Overland}" AutoGenerateColumns="False"
                              IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              Margin="0,10,0,0" MaxHeight="360">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Location" Binding="{Binding Name}" Width="150"/>
                            <DataGridCheckBoxColumn Header="Hidden" Binding="{Binding IsHidden}" Width="60"/>
                            <DataGridTextColumn Header="Reached from" Binding="{Binding ReachedFrom}" Width="260"/>
                            <DataGridTextColumn Header="Why you go" Binding="{Binding Why}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Style="{StaticResource Head}" Text="The four named pubs"/>
                    <ItemsControl ItemsSource="{Binding Pubs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding}"/></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </TabItem>

            <TabItem Header="Controls &amp; tips">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14" DataContext="{Binding Reference}">
                        <TextBlock Style="{StaticResource Head}" Text="Controls"/>
                        <DataGrid ItemsSource="{Binding Controls}" AutoGenerateColumns="False"
                                  IsReadOnly="True" HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal" MaxHeight="330">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Where" Binding="{Binding Context}" Width="90"/>
                                <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="150"/>
                                <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Style="{StaticResource Head}" Text="Notes"/>
                        <ItemsControl ItemsSource="{Binding Tips}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Maps">
                <Grid Margin="14" DataContext="{Binding Maps}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="Major areas" FontWeight="Bold"/>
                        <ListBox ItemsSource="{Binding Areas}" SelectedItem="{Binding Selected}"
                                 DisplayMemberPath="Name" Margin="0,6,0,0"/>
                    </StackPanel>
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding SelectedDescription}" TextWrapping="Wrap" Foreground="#555"/>
                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                      Margin="0,10,0,10">
                            <Image Source="{Binding SelectedImage}" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        </ScrollViewer>
                        <DataGrid Grid.Row="2" ItemsSource="{Binding Pois}" AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" MaxHeight="150">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Position" Binding="{Binding Position}" Width="80"/>
                                <DataGridTextColumn Header="Landmark" Binding="{Binding Name}" Width="120"/>
                                <DataGridTextColumn Header="Notes" Binding="{Binding Description}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Cluebook">
                <StackPanel Margin="14" DataContext="{Binding Cluebook}">
                    <TextBlock TextWrapping="Wrap" Foreground="#555"
                               Text="Generate a self-contained HTML guide with the selected maps and reference sections. It does not require the game to be running."/>
                    <TextBlock Style="{StaticResource Head}" Text="Include"/>
                    <WrapPanel>
                        <CheckBox Content="Area maps" IsChecked="{Binding IncludeMaps}" Margin="0,2,16,2"/>
                        <CheckBox Content="Class reference" IsChecked="{Binding IncludeClasses}" Margin="0,2,16,2"/>
                        <CheckBox Content="Quest guide" IsChecked="{Binding IncludeQuestGuide}" Margin="0,2,16,2"/>
                        <CheckBox Content="Walkthrough" IsChecked="{Binding IncludeWalkthrough}" Margin="0,2,16,2"/>
                        <CheckBox Content="Strategy" IsChecked="{Binding IncludeStrategy}" Margin="0,2,16,2"/>
                    </WrapPanel>
                    <WrapPanel Margin="0,12,0,0">
                        <Button Content="Save cluebook" Command="{Binding SaveCommand}"/>
                        <Button Content="Open cluebook" Command="{Binding OpenCommand}"/>
                    </WrapPanel>
                    <TextBlock Margin="0,10,0,0" Text="{Binding Status}" TextWrapping="Wrap"/>
                </StackPanel>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
