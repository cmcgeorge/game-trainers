<Window x:Class="Space1889Trainer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Space1889Trainer.ViewModels"
        Title="Space 1889 Trainer" Height="900" Width="1280"
        Background="{StaticResource Bg}" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>

        <!-- ==== one character, shared by the Party and Save Editor tabs ================= -->
        <DataTemplate x:Key="CharacterEditor" DataType="{x:Type vm:CharacterViewModel}">
            <Grid Margin="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- left: identity, money, condition, actions -->
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Section}" FontSize="15" Margin="0,0,0,4"/>
                    <TextBlock Text="This slot is empty (never filled, or the character died)." Style="{StaticResource Hint}"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>
                    <StackPanel IsEnabled="{Binding CanEdit}" Visibility="{Binding HasCharacter, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Name (11)"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,4" MaxLength="11"
                                     Text="{Binding Name, UpdateSourceTrigger=LostFocus}" CharacterCasing="Upper"/>
                            <TextBlock Grid.Row="1" Text="Female"/>
                            <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding IsFemale}" Margin="0,0,0,4"/>
                            <TextBlock Grid.Row="2" Text="Careers"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Careers}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <TextBlock Grid.Row="3" Text="Class"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SocialClass}" Margin="0,0,0,4"/>
                            <TextBlock Grid.Row="4" Text="Horse"/>
                            <CheckBox Grid.Row="4" Grid.Column="1" IsChecked="{Binding HasHorse}" Margin="0,0,0,4"/>
                            <TextBlock Grid.Row="5" Text="Body weight (lb)"/>
                            <TextBox Grid.Row="5" Grid.Column="1" Margin="0,0,0,4" Text="{Binding BodyWeight, UpdateSourceTrigger=LostFocus}"/>
                        </Grid>

                        <TextBlock Text="Money (pennies; 240d = £1)" Style="{StaticResource Section}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Wealth"/>
                            <TextBox Grid.Column="1" Text="{Binding Wealth, UpdateSourceTrigger=LostFocus}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding WealthText}" Style="{StaticResource Hint}" Margin="0,0,0,4"/>
                            <TextBlock Grid.Row="2" Text="Monthly income"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding MonthlyIncome, UpdateSourceTrigger=LostFocus}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding IncomeText}" Style="{StaticResource Hint}"/>
                        </Grid>

                        <TextBlock Text="Condition" Style="{StaticResource Section}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Health / max"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBox Width="60" Text="{Binding Health, UpdateSourceTrigger=LostFocus}"/>
                                <TextBlock Text=" / " Margin="4,0"/>
                                <TextBox Width="60" Text="{Binding MaxHealth, UpdateSourceTrigger=LostFocus}"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Hint}" Margin="0,0,0,4">
                                <Run Text="{Binding HealthText, Mode=OneWay}" Foreground="{StaticResource Accent}"/>
                                <Run Text=" — "/>
                                <Run Text="{Binding ConditionText, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock Grid.Row="2" Text="Fatigue"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,4" Text="{Binding Fatigue, UpdateSourceTrigger=LostFocus}"/>
                            <TextBlock Grid.Row="3" Text="Mental"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,4" Text="{Binding Mental, UpdateSourceTrigger=LostFocus}"/>
                            <TextBlock Grid.Row="4" Text="Carrying"/>
                            <TextBlock Grid.Row="4" Grid.Column="1">
                                <Run Text="{Binding CarriedWeight, Mode=OneWay}"/><Run Text=" lb in "/><Run Text="{Binding ItemCount, Mode=OneWay}"/><Run Text=" / 21 slots"/>
                            </TextBlock>
                        </Grid>

                        <TextBlock Text="Quick actions" Style="{StaticResource Section}"/>
                        <WrapPanel>
                            <Button Content="Full heal" Command="{Binding FullHealCommand}" ToolTip="Health to maximum, fatigue and insanity to zero"/>
                            <Button Content="Attributes 6" Command="{Binding MaxAttributesCommand}"/>
                            <Button Content="Skills 6" Command="{Binding MaxSkillsCommand}"/>
                            <Button Content="Reload guns" Command="{Binding RefillAmmoCommand}" ToolTip="IN GUN to a full load, ROUNDS to at least 999"/>
                            <Button Content="+ £1,000" Command="{Binding AddMoneyCommand}"/>
                            <Button Content="Max everything" Command="{Binding MaxEverythingCommand}"/>
                        </WrapPanel>
                    </StackPanel>
                </StackPanel>

                <!-- right: attributes, skills, inventory -->
                <Grid Grid.Column="1" IsEnabled="{Binding CanEdit}" Visibility="{Binding HasCharacter, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Attributes" Style="{StaticResource Section}" Margin="0,0,0,4"/>
                        <ItemsControl ItemsSource="{Binding Attributes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="6"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Hint}"/>
                                        <TextBox Text="{Binding Value, UpdateSourceTrigger=LostFocus}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Grid.Row="1">
                        <TextBlock Text="Skills (grouped by attribute; the game stores them in this order)" Style="{StaticResource Section}"/>
                        <ItemsControl ItemsSource="{Binding Skills}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="6" Rows="4"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,8,3" ToolTip="{Binding Hint}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="42"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                        <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=LostFocus}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource Hint}" Text="Columns are Strength, Agility, Endurance, Intellect, Charisma and Social Level; hover a skill for what it does."/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,4">
                        <TextBlock Text="Inventory" Style="{StaticResource Section}" Margin="0,0,14,0"/>
                        <ComboBox Width="260" ItemsSource="{x:Static vm:CharacterViewModel.ItemChoices}"
                                  SelectedValuePath="Id" SelectedValue="{Binding NewItemId}" DisplayMemberPath="Name"/>
                        <TextBlock Text="rounds" Margin="8,0,4,0"/>
                        <TextBox Width="60" Text="{Binding NewItemRounds, UpdateSourceTrigger=LostFocus}"/>
                        <Button Content="Add item" Command="{Binding AddItemCommand}" Margin="8,0,0,0"/>
                    </StackPanel>

                    <DataGrid Grid.Row="3" ItemsSource="{Binding Inventory}" AutoGenerateColumns="False" CanUserAddRows="False"
                              CanUserDeleteRows="False" CanUserSortColumns="False" HeadersVisibility="Column" MinHeight="200">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding SlotNumber}" IsReadOnly="True" Width="32"/>
                            <DataGridTemplateColumn Header="Item" Width="230">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{x:Static vm:CharacterViewModel.ItemChoices}" DisplayMemberPath="Name"
                                                  SelectedValuePath="Id" SelectedValue="{Binding ItemId, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding IsOccupied}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Type" Binding="{Binding TypeName, Mode=OneWay}" IsReadOnly="True" Width="130"/>
                            <DataGridTemplateColumn Header="Ammo" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{x:Static vm:CharacterViewModel.AmmoChoices}" DisplayMemberPath="Name"
                                                  SelectedValuePath="Index" SelectedValue="{Binding AmmoIndex, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding UsesAmmunition}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Rounds" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Rounds, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding UsesAmmunition}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="In gun" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding InGun, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding UsesAmmunition}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="In use" Width="55">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding InUse, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsOccupied}"
                                                  HorizontalAlignment="Center" Margin="0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status, Mode=OneWay}" IsReadOnly="True" Width="70"/>
                            <DataGridTemplateColumn Header="" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Equip" Command="{Binding UseCommand}" Padding="6,1" Margin="0,0,4,0"/>
                                            <Button Content="Remove" Command="{Binding RemoveCommand}" Padding="6,1" Margin="0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>
        </DataTemplate>

        <!-- ==== the world block, shared by the World and Save Editor tabs ============== -->
        <DataTemplate x:Key="WorldEditor" DataType="{x:Type vm:WorldViewModel}">
            <Grid Margin="4" IsEnabled="{Binding CanEdit}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="Party" Style="{StaticResource Section}" Margin="0,0,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Party account (d)"/>
                        <TextBox Grid.Column="1" Text="{Binding PartyAccount, UpdateSourceTrigger=LostFocus}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PartyAccountText}" Style="{StaticResource Hint}" Margin="0,0,0,4"/>
                        <TextBlock Grid.Row="2" Text="Food"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,4" Text="{Binding Food, UpdateSourceTrigger=LostFocus}"/>
                        <TextBlock Grid.Row="3" Text="Day"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,4" Text="{Binding Day, UpdateSourceTrigger=LostFocus}"/>
                        <TextBlock Grid.Row="4" Text="Leader"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Leader}"/>
                    </Grid>
                    <WrapPanel Margin="0,8,0,0">
                        <Button Content="Food 30,000" Command="{Binding MaxFoodCommand}"/>
                        <Button Content="+ £10,000 to account" Command="{Binding AddAccountCommand}"/>
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Hint}" Text="Monthly income lands in the party account every 30 days; draw it out at a bank. Each able character eats 2 food a day."/>

                    <TextBlock Text="Location" Style="{StaticResource Section}"/>
                    <TextBlock Text="{Binding Location}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding MapKey}" Style="{StaticResource Hint}"/>
                    <TextBlock Text="{Binding LightText}" Style="{StaticResource Hint}"/>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0">
                        <Run Text="Party square: row "/><Run Text="{Binding CurrentRow, Mode=OneWay}"/><Run Text=", column "/><Run Text="{Binding CurrentColumn, Mode=OneWay}"/>
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="Row" Margin="0,0,4,0"/>
                        <TextBox Width="60" Text="{Binding Row, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Column" Margin="10,0,4,0"/>
                        <TextBox Width="60" Text="{Binding Column, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Content="Teleport" Command="{Binding TeleportCommand}" Margin="10,0,0,0"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Hint}" Text="Moves the party within its current map only (the engine loads a map when you walk into it). The Maps tab lets you click a square and checks it is walkable."/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                    <TextBlock Text="Ether flyer" Style="{StaticResource Section}" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding FlyerSummary}" TextWrapping="Wrap"/>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Hull size"/>
                        <TextBox Grid.Column="1" Margin="0,0,0,4" Text="{Binding Hull, UpdateSourceTrigger=LostFocus}"/>
                        <TextBlock Grid.Row="1" Text="Lift"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,4" ItemsSource="{x:Static vm:WorldViewModel.LiftChoices}" SelectedIndex="{Binding Lift}"/>
                        <TextBlock Grid.Row="2" Text="Propeller"/>
                        <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,4" ItemsSource="{x:Static vm:WorldViewModel.PropellerChoices}" SelectedIndex="{Binding Propeller}"/>
                        <TextBlock Grid.Row="3" Text="Power level"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,4" Text="{Binding Power, UpdateSourceTrigger=LostFocus}"/>
                        <TextBlock Grid.Row="4" Text="Engine size"/>
                        <TextBox Grid.Row="4" Grid.Column="1" Margin="0,0,0,4" Text="{Binding Engine, UpdateSourceTrigger=LostFocus}"/>
                        <TextBlock Grid.Row="5" Text="Armor value"/>
                        <TextBox Grid.Row="5" Grid.Column="1" Margin="0,0,0,4" Text="{Binding Armor, UpdateSourceTrigger=LostFocus}"/>
                        <TextBlock Grid.Row="6" Text="Top gun"/>
                        <ComboBox Grid.Row="6" Grid.Column="1" Margin="0,0,0,4" ItemsSource="{x:Static vm:WorldViewModel.GunChoices}"
                                  SelectedValuePath="Index" SelectedValue="{Binding TopGun}"/>
                        <TextBlock Grid.Row="7" Text="Bottom gun"/>
                        <ComboBox Grid.Row="7" Grid.Column="1" Margin="0,0,0,4" ItemsSource="{x:Static vm:WorldViewModel.GunChoices}"
                                  SelectedValuePath="Index" SelectedValue="{Binding LowGun}"/>
                    </Grid>
                    <CheckBox Content="Ammonia loaded (fuel)" IsChecked="{Binding AmmoniaLoaded}"/>
                    <CheckBox Content="Glow crystals loaded (fuel)" IsChecked="{Binding GlowCrystalsLoaded}"/>
                    <TextBlock Text="{Binding DamageText}" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
                    <Button Content="Repair flyer" Command="{Binding RepairFlyerCommand}" HorizontalAlignment="Left" Margin="0,6,0,6"/>
                    <TextBlock Text="{Binding BridgeCrew}" Style="{StaticResource Hint}"/>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                               Text="These fields were read out of the ship builder and S.EXE's combat code but not exercised in a live flight: change them while landed, and keep a save."/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Story flags" Style="{StaticResource Section}" Margin="0,0,0,4"/>
                    <ItemsControl ItemsSource="{Binding StoryFlags}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSet}" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Flag.Effect}" Style="{StaticResource Hint}" Width="330" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Hint}" Text="Setting a flag reveals its map change the next time that map loads, but does not hand over the items its event gives."/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ==== attach bar ====================================================== -->
        <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Emulator" Style="{StaticResource Section}" Margin="0,0,10,0"/>
                    <ComboBox Width="360" ItemsSource="{Binding Emulators}" SelectedItem="{Binding SelectedEmulator}"/>
                    <Button Content="Refresh list" Command="{Binding RefreshEmulatorsCommand}" Margin="8,0,6,0"/>
                    <Button Content="Attach" Command="{Binding AttachCommand}"/>
                    <Button Content="Detach" Command="{Binding DetachCommand}"/>
                    <Button Content="Re-read now" Command="{Binding RefreshNowCommand}"/>
                </StackPanel>
                <TextBlock Text="{Binding Status}" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
                <TextBlock Text="{Binding LocateDetail}" Style="{StaticResource Hint}"/>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1" Background="Transparent" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="10">

            <!-- Party -->
            <TabItem Header="Party">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <ListBox ItemsSource="{Binding Characters}" SelectedItem="{Binding SelectedCharacter}" DisplayMemberPath="Title"
                                     BorderThickness="0" Background="Transparent">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                            </ListBox>
                        </StackPanel>
                        <WrapPanel Margin="0,6,0,0">
                            <TextBlock Text="Whole party:" Margin="0,0,8,6"/>
                            <Button Content="Heal all" Command="{Binding HealPartyCommand}"/>
                            <Button Content="Reload all guns" Command="{Binding ReloadPartyCommand}"/>
                            <Button Content="Max everyone" Command="{Binding MaxPartyCommand}"/>
                            <TextBlock Text="Freeze:" Margin="16,0,8,6"/>
                            <CheckBox Content="Health" IsChecked="{Binding FreezeHealth}"/>
                            <CheckBox Content="Fatigue &amp; mental" IsChecked="{Binding FreezeFatigue}"/>
                            <CheckBox Content="Wealth" IsChecked="{Binding FreezeWealth}"/>
                            <CheckBox Content="Party account" IsChecked="{Binding FreezeAccount}"/>
                            <CheckBox Content="Food" IsChecked="{Binding FreezeFood}"/>
                            <CheckBox Content="Guns loaded" IsChecked="{Binding FreezeAmmo}"/>
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="The game redraws its status panel only now and then: open the PARTY screen (P) or change leader (L) to see an edit on screen."/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ContentControl Content="{Binding SelectedCharacter}" ContentTemplate="{StaticResource CharacterEditor}"/>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- World -->
            <TabItem Header="World &amp; flyer">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ContentControl Content="{Binding World}" ContentTemplate="{StaticResource WorldEditor}"/>
                </ScrollViewer>
            </TabItem>

            <!-- Maps -->
            <TabItem Header="Maps">
                <Grid DataContext="{Binding Maps}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <DockPanel Grid.Column="0" Margin="0,0,10,0">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="Game folder" Style="{StaticResource Section}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding GameFolder, UpdateSourceTrigger=LostFocus}"/>
                            <Button Content="Browse…" Command="{Binding BrowseCommand}" HorizontalAlignment="Left" Margin="0,6,0,6"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <ComboBox Width="110" ItemsSource="{x:Static vm:MapsViewModel.RenderModes}" SelectedItem="{Binding Mode}"/>
                                <TextBlock Text="px per square" Margin="10,0,4,0"/>
                                <ComboBox Width="60" ItemsSource="{x:Static vm:MapsViewModel.Zooms}" SelectedItem="{Binding Zoom}"/>
                            </StackPanel>
                            <CheckBox Content="Follow the party" IsChecked="{Binding FollowParty}"/>
                            <CheckBox Content="Show NPCs" IsChecked="{Binding ShowNpcs}"/>
                            <CheckBox Content="Allow teleporting onto any square" IsChecked="{Binding AllowUnsafeTeleport}"/>
                            <Button Content="Go to party's map" Command="{Binding GoToPartyCommand}" HorizontalAlignment="Left" Margin="0,4,0,6"/>
                        </StackPanel>
                        <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding Details}" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Hint}"/></DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ListBox ItemsSource="{Binding Maps}" SelectedItem="{Binding SelectedMap}" FontFamily="Consolas" FontSize="12"/>
                    </DockPanel>
                    <DockPanel Grid.Column="1">
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <TextBlock Text="{Binding Info}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Hover}" Style="{StaticResource Mono}" Foreground="{StaticResource Accent}" TextWrapping="Wrap"/>
                            <TextBlock Style="{StaticResource Hint}" Text="Click a walkable square on the party's current map to teleport there. Gold labels are exits, teal shops, orange entrances, purple scripted dig/drop spots, pink entrances a story event reveals; red dots are NPCs. Hover over a square for its tile and the names and notes on it."/>
                        </StackPanel>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="{StaticResource Panel}">
                            <Grid HorizontalAlignment="Left" VerticalAlignment="Top">
                                <Image x:Name="MapImage" Source="{Binding Image}" Stretch="None" RenderOptions.BitmapScalingMode="NearestNeighbor"
                                       MouseLeftButtonDown="MapImage_MouseLeftButtonDown" MouseMove="MapImage_MouseMove" Cursor="Cross"/>
                                <ItemsControl ItemsSource="{Binding Markers}" IsHitTestVisible="True">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><Canvas IsHitTestVisible="False"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                            <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="tag" Background="#CC101216" CornerRadius="2" Padding="2,0" IsHitTestVisible="False">
                                                <TextBlock x:Name="label" Text="{Binding Text}" FontSize="10" Foreground="#E8C33A"/>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Kind}" Value="Service">
                                                    <Setter TargetName="label" Property="Foreground" Value="#2FD7CF"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="Entrance">
                                                    <Setter TargetName="label" Property="Foreground" Value="#FF9A4C"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="DigSite">
                                                    <Setter TargetName="label" Property="Foreground" Value="#D59CFF"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="Hidden">
                                                    <Setter TargetName="label" Property="Foreground" Value="#FF6FB5"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="Npc">
                                                    <Setter TargetName="label" Property="Foreground" Value="#FF5A4F"/>
                                                    <Setter TargetName="tag" Property="Background" Value="Transparent"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Canvas IsHitTestVisible="False">
                                    <Border Canvas.Left="{Binding PartyX}" Canvas.Top="{Binding PartyY}" Width="{Binding CellSize}" Height="{Binding CellSize}"
                                            BorderBrush="#FFFFFF" BorderThickness="2" Background="#80FF3030"
                                            Visibility="{Binding PartyVisible, Converter={StaticResource BoolToVis}}"/>
                                </Canvas>
                            </Grid>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- Save editor -->
            <TabItem Header="Save editor">
                <Grid DataContext="{Binding SaveEditor}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <ComboBox Width="420" ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}"/>
                            <Button Content="Open" Command="{Binding OpenCommand}" Margin="8,0,6,0"/>
                            <Button Content="Browse…" Command="{Binding BrowseCommand}"/>
                            <Button Content="Rescan" Command="{Binding ScanCommand}"/>
                            <Button Content="Save" Command="{Binding SaveCommand}" Margin="16,0,6,0"/>
                            <Button Content="Revert" Command="{Binding RevertCommand}"/>
                            <Button Content="Heal all" Command="{Binding HealAllCommand}" Margin="16,0,6,0"/>
                            <Button Content="Max everyone" Command="{Binding MaxAllCommand}"/>
                            <Button Content="Compare with running game" Command="{Binding CompareCommand}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding LoadedName}" FontWeight="SemiBold" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding Status}" Style="{StaticResource Hint}"/>
                    </StackPanel>
                    <TabControl Grid.Row="1" Background="Transparent" BorderBrush="{StaticResource Line}" Padding="8">
                        <TabItem Header="Characters">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <ListBox ItemsSource="{Binding Characters}" SelectedItem="{Binding SelectedCharacter}" DisplayMemberPath="Title"
                                         BorderThickness="0" Background="Transparent">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                </ListBox>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ContentControl Content="{Binding SelectedCharacter}" ContentTemplate="{StaticResource CharacterEditor}"/>
                                </ScrollViewer>
                            </Grid>
                        </TabItem>
                        <TabItem Header="World &amp; flyer">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ContentControl Content="{Binding World}" ContentTemplate="{StaticResource WorldEditor}"/>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Grid>
            </TabItem>

            <!-- Reference -->
            <TabItem Header="Reference">
                <TabControl DataContext="{Binding Reference}" Background="Transparent" BorderBrush="{StaticResource Line}" Padding="8">
                    <TabItem Header="Items">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="Filter" Margin="0,0,8,0"/>
                                <TextBox Width="260" Text="{Binding ItemFilter, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="45"/>
                                    <DataGridTextColumn Header="Item" Binding="{Binding Name}" Width="240"/>
                                    <DataGridTextColumn Header="Type" Binding="{Binding TypeName}" Width="170"/>
                                    <DataGridTextColumn Header="Price" Binding="{Binding PriceText}" Width="120"/>
                                    <DataGridTextColumn Header="Weight (lb)" Binding="{Binding WeightPounds}" Width="85"/>
                                    <DataGridTextColumn Header="Shops" Binding="{Binding Shops}" Width="160"/>
                                    <DataGridTextColumn Header="Shots" Binding="{Binding Shots}" Width="55"/>
                                    <DataGridTextColumn Header="Damage" Binding="{Binding Damage}" Width="65"/>
                                    <DataGridTextColumn Header="Range" Binding="{Binding Range}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="Skills">
                        <DataGrid ItemsSource="{Binding Skills}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Attribute" Binding="{Binding Attribute}" Width="120"/>
                                <DataGridTextColumn Header="Skill" Binding="{Binding Skill}" Width="160"/>
                                <DataGridTextColumn Header="What it does" Binding="{Binding Use}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="Careers &amp; classes">
                        <StackPanel Orientation="Horizontal">
                            <DataGrid ItemsSource="{Binding Careers}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Width="360">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="45"/>
                                    <DataGridTextColumn Header="Career" Binding="{Binding Name}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <ItemsControl ItemsSource="{Binding SocialClasses}" Margin="20,0,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding}" Margin="0,0,0,4"/></DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="Story flags">
                        <DataGrid ItemsSource="{Binding StoryFlags}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Bit" Binding="{Binding Bit}" Width="45"/>
                                <DataGridTextColumn Header="Flag" Binding="{Binding Name}" Width="220"/>
                                <DataGridTextColumn Header="Effect" Binding="{Binding Effect}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                </TabControl>
            </TabItem>

            <!-- Cluebook -->
            <TabItem Header="Cluebook">
                <StackPanel DataContext="{Binding Cluebook}" Margin="4" MaxWidth="720" HorizontalAlignment="Left">
                    <TextBlock Text="Strategy guide" Style="{StaticResource Section}" Margin="0,0,0,4"/>
                    <TextBlock Style="{StaticResource Hint}" Text="Writes a self-contained HTML cluebook to your Documents folder: the rules as the code implements them, controls, a full walkthrough with coordinates, side quests, the item catalogue and schematic maps drawn from your game folder."/>
                    <CheckBox Content="Controls" IsChecked="{Binding IncludeControls}" Margin="0,10,0,4"/>
                    <CheckBox Content="Walkthrough" IsChecked="{Binding IncludeWalkthrough}"/>
                    <CheckBox Content="Side quests, digs and locked doors" IsChecked="{Binding IncludeSideQuests}"/>
                    <CheckBox Content="Item catalogue" IsChecked="{Binding IncludeItems}"/>
                    <CheckBox Content="Maps (needs the game folder)" IsChecked="{Binding IncludeMaps}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Save" Command="{Binding SaveCommand}"/>
                        <Button Content="Open in browser" Command="{Binding OpenCommand}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Status}" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
