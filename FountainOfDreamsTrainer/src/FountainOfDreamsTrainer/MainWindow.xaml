<Window x:Class="FountainOfDreamsTrainer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fountain of Dreams Trainer" Height="720" Width="980"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="2,1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="8,3"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Padding" Value="2,1"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4,0,4,0"/>
            <Setter Property="MinWidth" Value="60"/>
        </Style>
        <Style x:Key="RefHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="2,6,2,2"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Background="#EEE" Padding="6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Process:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox Width="280" ItemsSource="{Binding Processes}" DisplayMemberPath="Display"
                          SelectedItem="{Binding SelectedProcess}"/>
                <Button Content="Refresh" Command="{Binding RefreshProcessesCommand}"/>
                <Button Content="Attach" Command="{Binding AttachCommand}"/>
                <Button Content="Detach" Command="{Binding DetachCommand}"/>
                <Button Content="Re-scan" Command="{Binding ScanCommand}"/>
            </StackPanel>
        </Border>

        <!-- Party-wide actions -->
        <Border DockPanel.Dock="Top" Background="#F6F6F6" Padding="6">
            <StackPanel Orientation="Horizontal">
                <CheckBox Content="Freeze Health (CON)" IsChecked="{Binding FreezeHealth}" VerticalAlignment="Center" Margin="4,0"
                          ToolTip="Keeps the whole party pinned to full constitution (CON = hit points)."/>
                <Separator Style="{x:Null}" Width="12"/>
                <Button Content="Heal Party" Command="{Binding HealPartyCommand}"/>
                <Button Content="Max Attributes" Command="{Binding MaxAttributesPartyCommand}"/>
                <Button Content="Max Money" Command="{Binding MaxMoneyPartyCommand}"/>
                <Button Content="Max Everything" Command="{Binding MaxEverythingPartyCommand}"/>
            </StackPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="#EEE" Padding="6">
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
        </Border>

        <!-- Tabs -->
        <TabControl Margin="6">
            <!-- ======================= PARTY ======================= -->
            <TabItem Header="Party">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <GroupBox Grid.Column="0" Header="Characters">
                        <ListBox ItemsSource="{Binding Party}" SelectedItem="{Binding SelectedCharacter}"
                                 DisplayMemberPath="ListLabel"/>
                    </GroupBox>

                    <GroupBox Grid.Column="1" Header="Character" Margin="6,0,0,0"
                              DataContext="{Binding SelectedCharacter}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="6">
                                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14" Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding Summary}" Foreground="#555" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="130"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" Style="{StaticResource FieldLabel}"/>
                                    <TextBox   Grid.Row="0" Grid.Column="1" Text="{Binding Name}" MaxLength="18"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Level" Style="{StaticResource FieldLabel}"/>
                                    <TextBox   Grid.Row="0" Grid.Column="3" Text="{Binding Level}"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Experience" Style="{StaticResource FieldLabel}"/>
                                    <TextBox   Grid.Row="1" Grid.Column="1" Text="{Binding Experience}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Cash ($)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox   Grid.Row="1" Grid.Column="3" Text="{Binding Cash}"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Rank" Style="{StaticResource FieldLabel}"/>
                                    <TextBox   Grid.Row="2" Grid.Column="1" Text="{Binding Rank}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Next Lvl XP" Style="{StaticResource FieldLabel}"/>
                                    <TextBox   Grid.Row="2" Grid.Column="3" Text="{Binding NextLevelXp}"/>
                                </Grid>

                                <GroupBox Header="Constitution &amp; Armor" Margin="0,8,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="90"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="CON" Style="{StaticResource FieldLabel}"/>
                                        <TextBox   Grid.Row="0" Grid.Column="1" Text="{Binding Con}"/>
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="/ Max" Style="{StaticResource FieldLabel}"/>
                                        <TextBox   Grid.Row="0" Grid.Column="3" Text="{Binding MaxCon}"/>
                                    </Grid>
                                </GroupBox>

                                <GroupBox Header="Attributes" Margin="0,8,0,0">
                                    <ItemsControl ItemsSource="{Binding Attributes}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="4">
                                                    <TextBlock Text="{Binding Name}" Width="40" VerticalAlignment="Center"
                                                               ToolTip="{Binding Description}"/>
                                                    <TextBox Width="60" Text="{Binding Value}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </GroupBox>

                                <WrapPanel Margin="0,8,0,0">
                                    <Button Content="Full Heal" Click="FullHeal_Click"/>
                                    <Button Content="Max Attributes" Click="MaxAttributes_Click"/>
                                    <Button Content="Max Money" Click="MaxMoney_Click"/>
                                    <Button Content="Max Everything" Click="MaxEverything_Click"/>
                                    <CheckBox Content="Freeze Health" IsChecked="{Binding FreezeHealth}" VerticalAlignment="Center" Margin="8,0"/>
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- ======================= INVENTORY ======================= -->
            <TabItem Header="Inventory">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <GroupBox Grid.Column="0" Header="Characters">
                        <ListBox ItemsSource="{Binding Party}" SelectedItem="{Binding SelectedCharacter}"
                                 DisplayMemberPath="ListLabel"/>
                    </GroupBox>

                    <GroupBox Grid.Column="1" Header="Carried Items" Margin="6,0,0,0"
                              DataContext="{Binding SelectedCharacter}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Margin="2,0,2,6" FontWeight="Bold"
                                       Text="{Binding Title}"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="2,3">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding SlotLabel}" Width="28" VerticalAlignment="Center" Foreground="#888"/>
                                                    <TextBlock Text="{Binding Name}" Width="200" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Data0, StringFormat='Data: {0}'}" VerticalAlignment="Center" Foreground="#555"/>
                                                    <Button Content="Clear" Click="ItemClear_Click" Margin="8,0,0,0" Padding="6,2"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- ======================= REFERENCES ======================= -->
            <TabItem Header="References">
                <TabControl Margin="6">
                    <!-- Attributes -->
                    <TabItem Header="Attributes">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="6">
                                <TextBlock Style="{StaticResource RefHeader}" Text="Attributes"/>
                                <ItemsControl ItemsSource="{Binding Reference.Attributes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="4,3">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Abbr}" Width="40" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding Name}" Width="120"/>
                                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" MaxWidth="500"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Skills -->
                    <TabItem Header="Skills">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="6">
                                <TextBlock Style="{StaticResource RefHeader}" Text="Skills"/>
                                <ItemsControl ItemsSource="{Binding Reference.Skills}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="4,3">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" Width="150" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" MaxWidth="500"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Professions -->
                    <TabItem Header="Professions">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="6">
                                <TextBlock Style="{StaticResource RefHeader}" Text="Professions"/>
                                <ItemsControl ItemsSource="{Binding Reference.Professions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="4,3">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" Width="120" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" MaxWidth="500"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Items -->
                    <TabItem Header="Items">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="6">
                                <TextBlock Style="{StaticResource RefHeader}" Text="Items"/>
                                <ItemsControl ItemsSource="{Binding Reference.Items}">
                                    <ItemsControl.GroupStyle>
                                        <GroupStyle>
                                            <GroupStyle.HeaderTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" Margin="2,4,2,2"/>
                                                </DataTemplate>
                                            </GroupStyle.HeaderTemplate>
                                        </GroupStyle>
                                    </ItemsControl.GroupStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="4,2">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Label}" Width="200"/>
                                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" MaxWidth="400" Foreground="#555"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </TabItem>

            <TabItem Header="Maps" DataContext="{Binding Maps}">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <GroupBox Grid.Column="0" Header="Areas">
                        <ListBox ItemsSource="{Binding Areas}" SelectedItem="{Binding Selected}"
                                 DisplayMemberPath="Name"/>
                    </GroupBox>
                    <ScrollViewer Grid.Column="1" Margin="6,0,0,0" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedDescription}" Style="{StaticResource RefHeader}"
                                       TextWrapping="Wrap"/>
                            <Image Source="{Binding SelectedImage}" Stretch="None" Margin="0,4,0,12"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            <TextBlock Text="Points of Interest" Style="{StaticResource RefHeader}"/>
                            <ListView ItemsSource="{Binding Pois}" Margin="0,0,0,8">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Pos" Width="60" DisplayMemberBinding="{Binding Position}"/>
                                        <GridViewColumn Header="Name" Width="140" DisplayMemberBinding="{Binding Name}"/>
                                        <GridViewColumn Header="Description" Width="400" DisplayMemberBinding="{Binding Description}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="Cluebook" DataContext="{Binding Cluebook}">
                <StackPanel Margin="12">
                    <TextBlock Text="Fountain of Dreams Cluebook" Style="{StaticResource RefHeader}" FontSize="16"/>
                    <TextBlock Text="Generate a self-contained HTML strategy guide with area maps, attribute and profession references, a walkthrough, and strategy notes."
                               TextWrapping="Wrap" Margin="0,0,0,12" MaxWidth="600" Foreground="#555"/>
                    <TextBlock Text="Include" Style="{StaticResource RefHeader}"/>
                    <WrapPanel Margin="8,0,0,8">
                        <CheckBox Content="Area maps" IsChecked="{Binding IncludeMaps}" Margin="8,4"/>
                        <CheckBox Content="Professions" IsChecked="{Binding IncludeProfessions}" Margin="8,4"/>
                        <CheckBox Content="Walkthrough" IsChecked="{Binding IncludeWalkthrough}" Margin="8,4"/>
                        <CheckBox Content="Strategy notes" IsChecked="{Binding IncludeStrategy}" Margin="8,4"/>
                    </WrapPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,8">
                        <Button Content="Save cluebook" Command="{Binding SaveCommand}"/>
                        <Button Content="Open in browser" Command="{Binding OpenCommand}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Status}" Foreground="#555" TextWrapping="Wrap"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
